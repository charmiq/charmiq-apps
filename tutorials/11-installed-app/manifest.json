{
  "id": "ai.charmiq.tutorials.installed-app",
  "name": "Punch List",
  "description": "The Punch List as a Home Screen app: its top color, the new count on its icon, and a shortcut that opens the done jobs",
  "requestedScopes": ["user.read", "mcp.platform.vfs"],
  "bundle": {
    "entry": {
      "html": "/index.html",
      "script": "/main.tsx",
      "style": "/styles.scss"
    },
    "format": "esm",
    "mounts": { "/shared": "../../shared" },
    "dependencies": {
      "importMap": {
        "react": "https://esm.sh/react@19.3.0",
        "react-dom": "https://esm.sh/react-dom@19.3.0?deps=react@19.3.0",
        "react-dom/client": "https://esm.sh/react-dom@19.3.0/client?deps=react@19.3.0"
      }
    }
  }
}
