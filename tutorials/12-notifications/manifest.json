{
  "id": "ai.charmiq.tutorials.notifications",
  "name": "Punch List",
  "description": "The Punch List as a Home Screen app that tells the others about each new job, even while their app is closed",
  "requestedScopes": ["user.read", "mcp.platform.vfs", "command.notification.material.push.send"],
  "bundle": {
    "entry": {
      "html": "/index.html",
      "script": "/main.tsx",
      "style": "/styles.scss"
    },
    "format": "esm",
    "mounts": { "/shared": "../../shared" },
    "dependencies": {
      "importMap": {
        "react": "https://esm.sh/react@19.3.0",
        "react-dom": "https://esm.sh/react-dom@19.3.0?deps=react@19.3.0",
        "react-dom/client": "https://esm.sh/react-dom@19.3.0/client?deps=react@19.3.0"
      }
    }
  }
}
