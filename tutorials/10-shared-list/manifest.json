{
  "id": "ai.charmiq.tutorials.shared-list",
  "name": "Punch List",
  "description": "A job list two people share through one document: a record per line, who is on the list with you, each person's own place under their User id, and what is new since they last looked",
  "requestedScopes": ["user.read", "mcp.platform.vfs"],
  "bundle": {
    "entry": {
      "html": "/index.html",
      "script": "/main.tsx",
      "style": "/styles.scss"
    },
    "format": "esm",
    "mounts": { "/shared": "../../shared" },
    "dependencies": {
      "importMap": {
        "react": "https://esm.sh/react@19.3.0",
        "react-dom": "https://esm.sh/react-dom@19.3.0?deps=react@19.3.0",
        "react-dom/client": "https://esm.sh/react-dom@19.3.0/client?deps=react@19.3.0"
      }
    }
  }
}
