{
  "id": "ai.charmiq.demos.brick-studio",
  "name": "Brick Studio",
  "description": "A 3D toy-brick build a Charm makes from chat: place parts on a stud grid, check what holds, and look at the result. The build is LDraw text in the document",
  "requestedScopes": [
    "appContent.read",
    "appContent.write",
    "appState.read",
    "appState.write",
    "application.advertise",
    "command.editor.redo",
    "command.editor.undo",
    "mcp.platform.vfs"
  ],
  "bundle": {
    "entry": {
      "html": "/src/index.html",
      "script": "/src/main.ts",
      "style": "/src/styles.scss"
    },
    "format": "esm",
    "resources": {
      "parts-creature-bunny": "/src/parts/creature-bunny.ldr",
      "parts-creature-cat": "/src/parts/creature-cat.ldr",
      "parts-creature-cat-crouching": "/src/parts/creature-cat-crouching.ldr",
      "parts-creature-chick": "/src/parts/creature-chick.ldr",
      "parts-creature-cow": "/src/parts/creature-cow.ldr",
      "parts-creature-crab": "/src/parts/creature-crab.ldr",
      "parts-creature-dinosaur": "/src/parts/creature-dinosaur.ldr",
      "parts-creature-dog-bulldog": "/src/parts/creature-dog-bulldog.ldr",
      "parts-creature-dog-dachshund": "/src/parts/creature-dog-dachshund.ldr",
      "parts-creature-dog-terrier": "/src/parts/creature-dog-terrier.ldr",
      "parts-creature-duckling": "/src/parts/creature-duckling.ldr",
      "parts-creature-flamingo": "/src/parts/creature-flamingo.ldr",
      "parts-creature-frog": "/src/parts/creature-frog.ldr",
      "parts-creature-lamb": "/src/parts/creature-lamb.ldr",
      "parts-creature-mouse": "/src/parts/creature-mouse.ldr",
      "parts-creature-octopus": "/src/parts/creature-octopus.ldr",
      "parts-creature-owl": "/src/parts/creature-owl.ldr",
      "parts-creature-parrot": "/src/parts/creature-parrot.ldr",
      "parts-creature-penguin": "/src/parts/creature-penguin.ldr",
      "parts-creature-piglet": "/src/parts/creature-piglet.ldr",
      "parts-creature-puppy": "/src/parts/creature-puppy.ldr",
      "parts-creature-rabbit": "/src/parts/creature-rabbit.ldr",
      "parts-creature-rat": "/src/parts/creature-rat.ldr",
      "parts-creature-seagull": "/src/parts/creature-seagull.ldr",
      "parts-creature-snake": "/src/parts/creature-snake.ldr",
      "parts-creature-snake-large": "/src/parts/creature-snake-large.ldr",
      "parts-creature-spider": "/src/parts/creature-spider.ldr",
      "parts-creature-squirrel": "/src/parts/creature-squirrel.ldr",
      "parts-creature-starfish": "/src/parts/creature-starfish.ldr",
      "parts-creature-turtle": "/src/parts/creature-turtle.ldr",
      "parts-creature-wolf": "/src/parts/creature-wolf.ldr",
      "parts-details": "/src/parts/details.ldr",
      "parts-figures": "/src/parts/figures.ldr",
      "parts-nature": "/src/parts/nature.ldr",
      "parts-vehicles": "/src/parts/vehicles.ldr"
    },
    "dependencies": {
      "importMap": {
        "rxjs": "https://esm.sh/rxjs@7.8.1",
        "rxjs/operators": "https://esm.sh/rxjs@7.8.1/operators",
        "three": "https://esm.sh/three@0.186.1",
        "three/addons/controls/OrbitControls.js": "https://esm.sh/three@0.186.1/examples/jsm/controls/OrbitControls.js",
        "three/addons/environments/RoomEnvironment.js": "https://esm.sh/three@0.186.1/examples/jsm/environments/RoomEnvironment.js",
        "three/addons/loaders/LDrawLoader.js": "https://esm.sh/three@0.186.1/examples/jsm/loaders/LDrawLoader.js",
        "three/addons/materials/LDrawConditionalLineMaterial.js": "https://esm.sh/three@0.186.1/examples/jsm/materials/LDrawConditionalLineMaterial.js",
        "three/addons/utils/BufferGeometryUtils.js": "https://esm.sh/three@0.186.1/examples/jsm/utils/BufferGeometryUtils.js",
        "three/addons/postprocessing/BokehPass.js": "https://esm.sh/three@0.186.1/examples/jsm/postprocessing/BokehPass.js",
        "three/addons/postprocessing/EffectComposer.js": "https://esm.sh/three@0.186.1/examples/jsm/postprocessing/EffectComposer.js",
        "three/addons/postprocessing/GTAOPass.js": "https://esm.sh/three@0.186.1/examples/jsm/postprocessing/GTAOPass.js",
        "three/addons/postprocessing/OutputPass.js": "https://esm.sh/three@0.186.1/examples/jsm/postprocessing/OutputPass.js",
        "three/addons/postprocessing/RenderPass.js": "https://esm.sh/three@0.186.1/examples/jsm/postprocessing/RenderPass.js",
        "three/addons/postprocessing/ShaderPass.js": "https://esm.sh/three@0.186.1/examples/jsm/postprocessing/ShaderPass.js",
        "three-gpu-pathtracer": "https://esm.sh/three-gpu-pathtracer@0.0.27?deps=three@0.186.1,three-mesh-bvh@0.9.16"
      }
    }
  },
  "runtime": {
    "appContent": true
  },
  "advertise": {
    "charmiq.command": [
      {
        "name": "listParts",
        "description": "The grid conventions, the catalog parts (one row each: name, width x depth x height) and the colors. Call first",
        "inputSchema": { "type": "object", "properties": {} },
        "outputSchema": {
          "type": "object",
          "properties": {
            "grid":   { "type": "string" },
            "parts":  { "type": "array", "items": { "type": "string" } },
            "colors": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["grid", "parts", "colors"]
        }
      },
      {
        "name": "listPlacedParts",
        "description": "Every part in the build with its position",
        "inputSchema": { "type": "object", "properties": {} },
        "outputSchema": {
          "type": "object",
          "properties": {
            "parts":     { "type": "array", "items": { "type": "object" }, "description": "Each with its step when the build has more than one" },
            "unchecked": { "type": "integer", "description": "Parts off the grid or outside the catalog" },
            "truncated": { "type": "string", "description": "Set when the build expands past what Brick Studio reads: only part of it was read" },
            "conflict":  { "type": "string", "description": "Set when the document holds more than one build: why, and how to recover. Edits are refused until one remains" }
          },
          "required": ["parts"]
        }
      },
      {
        "name": "addParts",
        "description": "Place parts. A batch that would collide is refused whole. Returns the check of the build it made: no check call is needed after",
        "inputSchema": {
          "type": "object",
          "properties": {
            "parts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 400,
              "items": {
                "type": "object",
                "properties": {
                  "part":     { "type": "string", "description": "Catalog part, e.g. brick-2x4" },
                  "color":    { "type": "string", "description": "Catalog color, e.g. red" },
                  "x":        { "type": "integer", "description": "West edge, studs" },
                  "z":        { "type": "integer", "description": "South edge, studs" },
                  "level":    { "type": "integer", "minimum": 0, "description": "Bottom, plates" },
                  "rotation": { "type": "integer", "enum": [0, 90, 180, 270] }
                },
                "required": ["part", "color", "x", "z", "level"]
              }
            },
            "newStep": { "type": "boolean", "description": "Put these parts in a new building step after the last" }
          },
          "required": ["parts"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "added":         { "type": "integer" },
            "ok":            { "type": "boolean" },
            "parts":         { "type": "integer" },
            "collisions":    { "type": "integer" },
            "collidingPairs":{ "type": "array", "items": { "type": "object" } },
            "floating":      { "type": "integer" },
            "floatingParts": { "type": "array", "items": { "type": "string" } },
            "unchecked":     { "type": "integer" },
            "truncated": { "type": "string", "description": "Set when the build expands past what Brick Studio reads: only part of it was read" },
            "conflict":  { "type": "string", "description": "Set when the document holds more than one build: why, and how to recover. Edits are refused until one remains" }
          },
          "required": ["added", "ok", "parts", "collisions", "floating"]
        }
      },
      {
        "name": "removeParts",
        "description": "Remove the part that fills each given cell. Returns the check of the build it made (no check call is needed after) and the parts the removal left unsupported",
        "inputSchema": {
          "type": "object",
          "properties": {
            "at": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "x":     { "type": "integer" },
                  "z":     { "type": "integer" },
                  "level": { "type": "integer" }
                },
                "required": ["x", "z", "level"]
              }
            }
          },
          "required": ["at"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "removed":          { "type": "array", "items": { "type": "string" } },
            "empty":            { "type": "array", "items": { "type": "string" } },
            "unsupported":      { "type": "integer", "description": "Parts the removal left floating" },
            "unsupportedParts": { "type": "array", "items": { "type": "string" } },
            "ok":            { "type": "boolean" },
            "parts":         { "type": "integer" },
            "collisions":    { "type": "integer" },
            "collidingPairs":{ "type": "array", "items": { "type": "object" } },
            "floating":      { "type": "integer" },
            "floatingParts": { "type": "array", "items": { "type": "string" } },
            "unchecked":     { "type": "integer" },
            "truncated": { "type": "string", "description": "Set when the build expands past what Brick Studio reads: only part of it was read" },
            "conflict":  { "type": "string", "description": "Set when the document holds more than one build: why, and how to recover. Edits are refused until one remains" }
          },
          "required": ["removed", "ok", "parts", "collisions", "floating"]
        }
      },
      {
        "name": "setGround",
        "description": "Color the baseplate (grass, a road, sand) instead of covering it with plates. Any catalog color that is not see-through; omit the color for the theme's",
        "inputSchema": {
          "type": "object",
          "properties": {
            "color": { "type": "string", "description": "Catalog color, e.g. green" }
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": { "ground": { "type": "string", "description": "The color, or theme" } },
          "required": ["ground"]
        }
      },
      {
        "name": "clear",
        "description": "Remove every part",
        "inputSchema": { "type": "object", "properties": {} },
        "outputSchema": {
          "type": "object",
          "properties": { "removed": { "type": "integer" } },
          "required": ["removed"]
        }
      },
      {
        "name": "check",
        "description": "Find collisions and parts not held up from the baseplate, for a build that changed other than by addParts or removeParts (whose results carry it). Never ok while the build was read only in part or the document holds more than one build",
        "inputSchema": { "type": "object", "properties": {} },
        "outputSchema": {
          "type": "object",
          "properties": {
            "ok":            { "type": "boolean" },
            "parts":         { "type": "integer" },
            "collisions":    { "type": "integer" },
            "collidingPairs":{ "type": "array", "items": { "type": "object" } },
            "floating":      { "type": "integer" },
            "floatingParts": { "type": "array", "items": { "type": "string" } },
            "unchecked":     { "type": "integer" },
            "truncated": { "type": "string", "description": "Set when the build expands past what Brick Studio reads: only part of it was read" },
            "conflict":  { "type": "string", "description": "Set when the document holds more than one build: why, and how to recover. Edits are refused until one remains" }
          },
          "required": ["ok", "parts", "collisions", "floating"]
        }
      },
      {
        "name": "setView",
        "description": "Turn the camera, framing the build unless fit is false. Use before a screenshot",
        "inputSchema": {
          "type": "object",
          "properties": {
            "azimuth":   { "type": "number", "description": "Degrees: 0 looks north from the south, 90 west from the east" },
            "elevation": { "type": "number", "minimum": 0, "maximum": 90, "description": "Degrees above level" },
            "fit":       { "type": "boolean" }
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "azimuth":   { "type": "number" },
            "elevation": { "type": "number" }
          },
          "required": ["azimuth", "elevation"]
        }
      },
      {
        "name": "setFidelity",
        "description": "Set how real the bricks look: 0 Draft, 1 Plastic, 2 Shaded, 3 Photo, 4 Path traced (slow; falls back to 3 where unavailable). Resolves once settled, so a screenshot next shows it",
        "inputSchema": {
          "type": "object",
          "properties": {
            "fidelity": { "type": "integer", "minimum": 0, "maximum": 4 }
          },
          "required": ["fidelity"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "fidelity": { "type": "integer" },
            "look":     { "type": "string" }
          },
          "required": ["fidelity", "look"]
        }
      },
      {
        "name": "getModel",
        "description": "The build as LDraw text. While the document holds more than one build: the conflict and each build's LDraw text, to recover from",
        "inputSchema": { "type": "object", "properties": {} },
        "outputSchema": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "properties": {
                "conflict":  { "type": "string", "description": "Set when the document holds more than one build: why, and how to recover. Edits are refused until one remains" },
                "builds":   { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "ldraw": { "type": "string" } }, "required": ["id", "ldraw"] } }
              },
              "required": ["conflict", "builds"]
            }
          ]
        }
      },
      {
        "name": "setModel",
        "description": "Replace the build with LDraw text (LDR or MPD). Returns its check",
        "inputSchema": {
          "type": "object",
          "properties": {
            "ldraw": { "type": "string" }
          },
          "required": ["ldraw"]
        },
        "outputSchema": { "type": "object" }
      },
      {
        "name": "listDesigns",
        "description": "The designs saved in the User's designs folder, by name",
        "inputSchema": { "type": "object", "properties": {} },
        "outputSchema": {
          "type": "object",
          "properties": {
            "folder": { "type": "string" },
            "designs": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["folder", "designs"]
        }
      },
      {
        "name": "loadDesign",
        "description": "Replace the build with a saved design, by name. Returns its check",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": { "type": "string" }
          },
          "required": ["name"]
        },
        "outputSchema": { "type": "object" }
      },
      {
        "name": "saveDesign",
        "description": "Save the build as a design in the User's designs folder (My Drive until they choose another). A name already there is refused unless replace is true",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "replace": { "type": "boolean", "description": "Write over the design of that name" }
          },
          "required": ["name"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "saved": { "type": "string" },
            "folder": { "type": "string" },
            "replaced": { "type": "boolean" }
          },
          "required": ["saved", "folder"]
        }
      }
    ]
  }
}
