groups = {d:[] for d in range(R+1)}\ntotal = sum(occ_refl.values())\nfor c, v in occ_refl.items():\n    edge_groups[edge_dist(c, R)].append(v / total * len(occ_refl))  # normalized\n# mean visit-rate by edge-distance ring\nprint(\"\\nReflect policy edge-bias  (visit-rate, normalized so uniform=1):\")\nprint(f\"{'edge_dist':&gt;10} {'cells':&gt;6} {'mean rate':&gt;10}\")\nfor d in range(R+1):\n    if edge_groups[d]:\n        print(f\"{d:&gt;10} {len(edge_groups[d]):&gt;6} {np.mean(edge_groups[d]):&gt;10.3f}\")\n\n# ----- Probe-economy estimate -----\nprint(\"\\n--- Probe economy estimate ---\")\nprint(\"Classic random search expected shots to first hit = N/F where F = ship-cells\")\nF = 5+4+3+3+2  # 17\nfor R in [6,7,8,9,10,12]:\n    N = n_cells(R)\n    d = F/N\n    print(f\"  R={R:&gt;2}  N={N:&gt;4}  density={d:.3f}  E[shots to first hit if static]≈{1/d:.1f}  \"\n          f\"E[shots to clear (~classic)]≈{2.4*F/d/F:.0f}\")\n"}
