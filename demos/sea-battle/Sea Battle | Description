aths += 1; break\n    return occ, deaths\n\ndef run_patrol(R, ring_radius=3, n_turns=300, n_trials=3000, seed=0):\n    rng = np.random.default_rng(seed)\n    cells_list = all_cells(R)\n    interior = [c for c in cells_list if edge_dist(c, R) &gt;= ring_radius]\n    occ = Counter()\n    for _ in range(n_trials):\n        center = interior[rng.integers(len(interior))]\n        ring = hex_ring(center, ring_radius)\n        # filter to valid cells (should already be valid if center is interior enough)\n        ring = [c for c in ring if in_board(c, R)]\n        if not ring: continue\n        start_idx = rng.integers(len(ring))\n        for t in range(n_turns):\n            occ[ring[(start_idx + t) % len(ring)]] += 1\n    return occ\n\n# --- Run all and tabulate edge-bias ---\nR = 8\npolicies = ['despawn', 'reflect-naive', 'reverse', 'wrap']\nall_occ = {}\nfor p in policies:\n    occ, deaths = run_policy(R, p, seed=hash(p) &amp; 0xffff)\n    all_occ[p] = occ\nall_occ['patrol-r3'] = run_patrol(R, ring_radius=3, seed=11)\nall_occ['patrol-r4'] = run_patrol(R, ring_radius=4, seed=13)\n\n# Tabulate: visit rate by edge-distance ring (normalized so uniform = 1)\nprint(f\"\\nEdge-distance visit rate (uniform = 1.00)   R={R}\")\nheader = f\"{'edge_d':&gt;7} {'cells':&gt;5}  \" + \" \".join(f\"{p:&gt;14}\" for p in all_occ)\nprint(header)\ntotal_by_p = {p: sum(o.values()) for p,o in all_occ.items()}\nN = n_cells(R)\nfor d in range(R+1):\n    ring_cells = [c for c in all_cells(R) if edge_dist(c,R) == d]\n    row = f\"{d:&gt;7} {len(ring_cells):&gt;5}  \"\n    for p in all_occ:\n        if total_by_p[p] == 0:\n            row += f\"{'--':&gt;14} \"; continue\n        rate = sum(all_occ[p][c] for c in ring_cells) / len(ring_cells)\n        rate_norm = rate / (total_by_p[p] / N)\n        row += f\"{rate_norm:&gt;14.3f}\"\n    print(row)\n\n# --- Plot heatmaps for all 6 ---\nfig, axes = plt.subplots(2, 3, figsize=(16, 11))\nall_plots = ['despawn','reflect-naive','reverse','wrap','patro