o \"near\" headings and pick whichever stays in\n                for delta in [+1, -1, +2, -2, +3]:\n                    h2 = (h + delta) % 6\n                    nxt2 = step(pos, h2, speed)\n                    if in_board(nxt2, R):\n                        h = h2\n                        nxt = nxt2\n                        break\n                else:\n                    return traj, t+1, 'trapped'\n        pos = nxt\n        traj.append(pos)\n    return traj, n_turns, 'active'\n\n# ---------- Fleet placement (classic 5/4/3/3/2 — single-row hex ships) ----------\n\nFLEET = [5,4,3,3,2]\n\ndef ship_cells(head, heading, length):\n    \"\"\"Cells occupied by a length-L ship with bow at `head` extending opposite to heading.\"\"\"\n    # ship occupies head, head - dir, head - 2*dir, ...\n    dq, dr = DIRS[heading]\n    return [(head[0] - i*dq, head[1] - i*dr) for i in range(length)]\n\ndef try_place_fleet(R, rng, max_tries=2000):\n    occupied = set()\n    ships = []\n    for L in FLEET:\n        for _ in range(max_tries):\n            # random head cell + heading\n            cells_list = all_cells(R)\n            head = cells_list[rng.integers(len(cells_list))]\n            heading = rng.integers(6)\n            cells = ship_cells(head, heading, L)\n            if all(in_board(c, R) for c in cells) and not any(c in occupied for c in cells):\n                ships.append({'head': head, 'heading': heading, 'len': L, 'cells': cells})\n                occupied.update(cells)\n                break\n        else:\n            return None\n    return ships\n\n# ============================================================\n# EXPERIMENT 1: How long do ships live before hitting boundary?\n# ============================================================\n\nrng = np.random.default_rng(42)\n\nradii = [5, 6, 7, 8, 9, 10, 12, 15]\nspeeds = [1, 2]\nN_TRIALS = 2000\nMAX_TURNS = 200\n\nresults = {}  # (R, speed) -&gt; array of exit times\nfor R in radii:\n    for sp in speeds:\n        