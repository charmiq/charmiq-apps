dq, c[1]+sp*dr) for c in ship['alive_cells']]\n    if all(in_board(c, R) for c in new_cells):\n        ship['heading'] = h2\n        ship['alive_cells'] = new_cells\n    # else sit still this turn\n    return ship\n\ndef place_fleet(R, rng, fleet=(5,4,3,3,2)):\n    occupied = set()\n    ships = []\n    cells_list = all_cells(R)\n    for L in fleet:\n        for tries in range(3000):\n            head = cells_list[rng.integers(len(cells_list))]\n            h = rng.integers(6)\n            dq, dr = DIRS[h]\n            body = [(head[0]-i*dq, head[1]-i*dr) for i in range(L)]\n            if all(in_board(c,R) for c in body) and not any(c in occupied for c in body):\n                ships.append({'heading': h, 'speed': 1, 'len': L,\n                              'alive_cells': body, 'orig_len': L})\n                occupied.update(body)\n                break\n        else:\n            return None\n    return ships\n\n# ----- Attacker -----\n\nclass Attacker:\n    \"\"\"Heuristic attacker. Tracks recent hits per ship-cluster, projects forward.\"\"\"\n    def __init__(self, R, rng):\n        self.R = R\n        self.rng = rng\n        self.cells = all_cells(R)\n        self.shot_history = []  # list of (turn, cell, result)\n        self.untargeted = set(self.cells)\n        # cluster of recent hits we're chasing (turn, cell)\n        self.recent_hits = []  # list of (turn, cell)\n        self.last_turn = 0\n\n    def update(self, turn, cell, hit, sunk):\n        self.shot_history.append((turn, cell, hit))\n        self.untargeted.discard(cell)\n        if hit:\n            # if it sinks, clear chase (move to next target)\n            if sunk:\n                self.recent_hits = []\n            else:\n                self.recent_hits.append((turn, cell))\n                # only keep last 4\n                self.recent_hits = self.recent_hits[-4:]\n        # If a chase is going cold (too many misses), drop it\n        # (handled implicitly by shooting strategy)\n\n    def