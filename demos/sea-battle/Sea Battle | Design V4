  .run-controls button { background: rgba(0,0,0,0.5); color: #c9b88a; border: 1px solid rgba(138,122,74,0.5); padding: 5px 10px; font-size: 14px; cursor: pointer; font-family: "Bebas Neue", sans-serif; letter-spacing: 1px; transition: all 0.15s; line-height: 1; }
  .run-controls button:hover { background: rgba(196,168,74,0.25); color: #f0e8d0; border-color: #c4a84a; }
