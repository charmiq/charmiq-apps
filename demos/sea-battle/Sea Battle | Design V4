  #tickDisplay { color: #c9b88a; font-family: "DM Mono", monospace; font-size: 12px; background: rgba(0,0,0,0.5); padding: 5px 10px; border: 1px solid rgba(138,122,74,0.3); min-width: 70px; text-align: center; }
