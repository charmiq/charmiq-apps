  #sidebar > * { position: relative; z-index: 2; }
  #sidebar h2 { font-family: "Bebas Neue", "Arial Narrow", sans-serif; font-size: 16px; letter-spacing: 4px; color: #3a3020; text-transform: uppercase; margin: 0; padding: 12px 16px 8px; font-weight: 400; border-top: 2px solid #8a7a4a; position: relative; cursor: pointer; user-select: none; display: flex; align-items: center; justify-content: space-between; }
  #sidebar h2::after { content: ""; position: absolute; bottom: 0; left: 16px; right: 16px; height: 1px; background: linear-gradient(90deg, #c4a84a, transparent); }
  #sidebar h2:first-of-type { border-top: none; margin-top: 8px; }
  #sidebar h2 .chev { font-size: 10px; color: #8a7a5a; transition: transform 0.2s ease; line-height: 1; }
  #sidebar h2.collapsed .chev { transform: rotate(-90deg); }
  .sidebar-section { padding: 8px 16px 14px; }
  .sidebar-section.collapsed { display: none; }
  .row { display: flex; align-items: center; justify-content: space-between; margin: 5px 0; gap: 8px; }
  .row label { color: #5a4e38; font-size: 11px; font-weight: 500; letter-spacing: 0.5px; }
  .row select, .row input[type="range"] { background: #faf4e6; color: #3a3020; border: 1px solid #c4b088; border-radius: 0; padding: 4px 8px; font-size: 11px; font-family: "DM Mono", "Courier New", monospace; }
  .row select { min-width: 120px; }
  .row select:focus { border-color: #8a7a4a; outline: none; box-shadow: 0 0 0 2px rgba(196,168,74,0.25); }
  .row input[type="range"] { flex: 1; min-width: 0; accent-color: #8a6a2a; }
  .row .val { color: #6a4a1a; font-family: "DM Mono", monospace; font-size: 12px; min-width: 24px; text-align: right; font-weight: 500; }
  .toggle { display: flex; align-items: center; gap: 6px; cursor: pointer; }
  .toggle input { margin: 0; accent-color: #8a6a2a; }
  .seg { display: flex; gap: 0; background: #e4d8be; border-radius: 0; padding: 0; border: 2px solid #8a7a4a; }
  .seg button { flex: 1; background: transparent; color: #6a5e44; border: 0; border-right: 1px solid #c4b088; padding: 8px 4px; font-size: 10px; font-family: "Bebas Neue", sans-serif; cursor: pointer; border-radius: 0; letter-spacing: 2px; text-transform: uppercase; transition: all 0.15s; }
  .seg button:last-child { border-right: 0; }
  .seg button.active { background: #3a3020; color: #e8dcc0; }
  .seg button:hover:not(.active) { background: #d8c8a4; color: #3a3020; }
  .ship-card { background: #faf4e6; border: 1px solid #c4b088; border-left: 4px solid #c4b088; border-radius: 0; padding: 8px 10px; margin: 5px 0; cursor: pointer; transition: all 0.12s; position: relative; }
  .ship-card::before { content: ""; position: absolute; top: 0; right: 0; width: 0; height: 0; border-top: 12px solid #c4b088; border-left: 12px solid transparent; opacity: 0; transition: opacity 0.12s; }
  .ship-card:hover { background: #fff8ea; border-color: #a09060; border-left-color: #a09060; }
  .ship-card.active { border-left-color: #8a6a2a; border-color: #8a6a2a; background: #fff8ea; box-shadow: 2px 2px 0 #c4b088; }
  .ship-card.active::before { opacity: 1; border-top-color: #8a6a2a; }
  .ship-card .ship-head { display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: #4a3e28; }
  .ship-card .ship-head b { font-family: "Bebas Neue", sans-serif; font-weight: 400; font-size: 15px; letter-spacing: 2px; }
  .ship-card .ship-head .badge { font-family: "DM Mono", monospace; font-size: 10px; color: #8a7a5a; }
  .ship-card.active .ship-head { color: #2a2010; }
  .ship-card.active .ship-head .badge { color: #6a4a1a; }
  .ship-controls { margin-top: 8px; display: none; border-top: 1px solid #ddd0b0; padding-top: 8px; }
  .ship-card.active .ship-controls { display: block; }
  .heading-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 2px; }
  .heading-grid button { background: #faf4e6; color: #6a5e44; border: 1px solid #c4b088; border-radius: 0; padding: 5px 0; font-size: 10px; cursor: pointer; font-family: "DM Mono", monospace; letter-spacing: 0.5px; transition: all 0.1s; }
  .heading-grid button:hover { background: #e8dcc0; color: #3a3020; border-color: #a09060; }
  .heading-grid button.active { background: #3a3020; color: #e8dcc0; border-color: #3a3020; }
  .meta { color: #8a7a5a; font-size: 10px; margin-top: 6px; font-family: "DM Mono", monospace; letter-spacing: 0.3px; }
  /* --- board --- */
  #board-wrap { position: relative; overflow: hidden; background: #2a2620; }
  #board { width: 100%; height: 100%; background: linear-gradient(135deg, #e8dcc0 0%, #d9c89f 100%); }
  #hud { position: absolute; top: 12px; right: 12px; background: rgba(0,0,0,0.55); color: #c9b88a; padding: 8px 12px; font-family: "SF Mono", monospace; font-size: 11px; border-radius: 3px; line-height: 1.5; pointer-events: none; }
  /* --- mode controls overlay --- */
  #mode-controls { position: absolute; top: 12px; left: 12px; z-index: 10; display: flex; flex-direction: column; gap: 8px; }
  .mode-toggle { display: flex; gap: 0; border: 2px solid rgba(138,122,74,0.7); background: rgba(0,0,0,0.45); backdrop-filter: blur(6px); }
  .mode-toggle button { background: transparent; color: #c9b88a; border: none; border-right: 1px solid rgba(138,122,74,0.4); padding: 7px 14px; font-family: "Bebas Neue", sans-serif; font-size: 13px; letter-spacing: 2px; cursor: pointer; text-transform: uppercase; transition: all 0.15s; white-space: nowrap; }
  .mode-toggle button:last-child { border-right: none; }
  .mode-toggle button.active { background: rgba(196,168,74,0.25); color: #f0e8d0; }
