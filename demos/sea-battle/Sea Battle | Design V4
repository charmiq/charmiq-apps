  /* --- hit log --- */
  #hitLog { max-height: 180px; overflow-y: auto; font-family: "DM Mono", monospace; font-size: 10px; color: #5a4e38; line-height: 1.7; }
  #hitLog:empty::after { content: "No incoming fire yet."; color: #a09878; font-style: italic; }
  #hitLog .log-entry { padding: 2px 0; border-bottom: 1px solid #e4d8be; }
  #hitLog .log-hit { color: #a03020; font-weight: 600; }
  #hitLog .log-miss { color: #708060; }
  #hitLog .log-sunk { color: #6a1a10; font-weight: 700; background: rgba(160,48,32,0.08); padding: 2px 4px; }
  /* --- hp pips --- */
  .hp-pips { display: flex; gap: 3px; margin-top: 4px; }
  .hp-pip { width: 10px; height: 10px; border-radius: 50%; border: 1px solid #8a7a5a; }
  .hp-pip.full { background: #4a8a3a; border-color: #3a6a2a; }
  .hp-pip.lost { background: #a03020; border-color: #802818; }
  .ship-card.sunk { opacity: 0.5; border-left-color: #a03020 !important; }
  .ship-card.sunk .ship-head b { text-decoration: line-through; }
  .ship-status { font-family: "DM Mono", monospace; font-size: 10px; color: #6a5a3a; margin-top: 4px; }
  .ship-status .cd-change { color: #a06020; font-weight: 600; }
  .ship-status .sunk-label { color: #a03020; font-weight: 700; font-size: 12px; }
  /* --- hit markers on board --- */
  .hit-marker-glow { animation: hitPulse 1.5s ease-out; }
  @keyframes hitPulse { 0% { opacity: 1; } 100% { opacity: 0; } }
  /* --- smoke particles --- */
  @keyframes smokeDrift {
    0%   { transform: translate(0, 0) scale(1); opacity: var(--smoke-o); }
    25%  { transform: translate(calc(var(--sx) * 0.3), calc(var(--sy) * 0.5 - 4px)) scale(1.15); opacity: calc(var(--smoke-o) * 0.9); }
    50%  { transform: translate(calc(var(--sx) * 0.7), calc(var(--sy) * 1.0 - 8px)) scale(1.35); opacity: calc(var(--smoke-o) * 0.65); }
    75%  { transform: translate(calc(var(--sx) * 0.5), calc(var(--sy) * 1.3 - 12px)) scale(1.5); opacity: calc(var(--smoke-o) * 0.35); }
    100% { transform: translate(0, 0) scale(1); opacity: var(--smoke-o); }
  }
  @keyframes smokeWander {
    0%   { transform: translate(0, 0); }
    33%  { transform: translate(calc(var(--wx) * 1px), calc(var(--wy) * 1px)); }
    66%  { transform: translate(calc(var(--wx) * -0.7px), calc(var(--wy) * 0.5px)); }
    100% { transform: translate(0, 0); }
  }
  @keyframes hitFlashBurst {
    0%   { r: 2; opacity: 1; fill: #fff8e0; }
    15%  { r: var(--burst-r); opacity: 0.95; fill: #ffaa30; }
    40%  { r: calc(var(--burst-r) * 1.6); opacity: 0.6; fill: #e04010; }
    70%  { r: calc(var(--burst-r) * 2.0); opacity: 0.25; fill: #801808; }
    100% { r: calc(var(--burst-r) * 2.2); opacity: 0; fill: #400800; }
  }
  @keyframes hitRingExpand {
    0%   { r: 2; stroke-width: 3; opacity: 1; }
    50%  { opacity: 0.7; }
    100% { r: var(--ring-r); stroke-width: 0.5; opacity: 0; }
  }
  @keyframes emberFloat {
    0%   { opacity: 1; transform: translate(0, 0); }
    100% { opacity: 0; transform: translate(calc(var(--ex) * 1px), calc(var(--ey) * 1px)); }
  }
  /* --- MISS SPLASH ANIMATIONS --- */
  @keyframes splashFlash {
    0%   { r: 2; opacity: 0.9; }
    25%  { r: var(--flash-r); opacity: 0.65; }
    100% { r: calc(var(--flash-r) * 0.3); opacity: 0; }
  }
  @keyframes splashRipple {
    0%   { r: 3; stroke-width: 2.2; opacity: 0; }
    8%   { opacity: 0.5; }
    50%  { opacity: 0.25; }
    100% { r: var(--ripple-r); stroke-width: 0.2; opacity: 0; }
  }
  @keyframes splashPlume {
    0%   { opacity: 0; transform: translateY(0) scale(1); }
    12%  { opacity: 0.6; }
    35%  { opacity: 0.4; transform: translateY(var(--py)) scale(0.8); }
    100% { opacity: 0; transform: translateY(calc(var(--py) * 1.4)) scale(0.3); }
  }
  @keyframes splashDrop {
    0%   { opacity: 0; transform: translate(0, 0); }
    10%  { opacity: 0.7; }
    45%  { opacity: 0.4; transform: translate(calc(var(--dx) * 0.5), var(--peak)); }
    100% { opacity: 0; transform: translate(var(--dx), var(--fall)); }
  }
  @keyframes rippleDistortFade {
    0%   { opacity: 0.75; }
    50%  { opacity: 0.4; }
    100% { opacity: 0; }
  }
  /* --- probe button --- */
  #probeToggle { background: rgba(160,48,32,0.6); color: #f0d8c0; border: 1px solid rgba(160,48,32,0.8); padding: 5px 10px; font-size: 12px; cursor: pointer; font-family: "Bebas Neue", sans-serif; letter-spacing: 2px; transition: all 0.15s; }
  #probeToggle:hover { background: rgba(160,48,32,0.8); }
  #probeToggle.active { background: rgba(160,48,32,0.9); box-shadow: 0 0 8px rgba(160,48,32,0.5); }
  /* --- inline icons --- */
  .ico { display: inline-block; vertical-align: middle; width: 14px; height: 14px; fill: currentColor; flex-shrink: 0; }
  .ico-sm { width: 11px; height: 13px; }
  .mode-toggle button .ico, .run-controls button .ico, #defenderLabel .ico { margin-right: 4px; }
</style>
