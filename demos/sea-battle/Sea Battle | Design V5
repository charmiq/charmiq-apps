<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>Sea Battle · Board</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Raleway:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap');
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; height: 100%; font-family: -apple-system, "Segoe UI", Roboto, sans-serif; background: #1a1612; color: #ddd; overflow: hidden; }
  #app { display: grid; grid-template-columns: 300px 1fr; height: 100vh; }
  /* --- sidebar --- */
  #sidebar { background: #f0e8d4; border-right: 3px solid #8a7a4a; overflow-y: auto; padding: 0; font-size: 13px; font-family: "Raleway", "Segoe UI", sans-serif; position: relative; }
  #sidebar::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, #8a7a4a 0%, #c4a84a 30%, #e8cc6a 50%, #c4a84a 70%, #8a7a4a 100%); z-index: 10; }
  #sidebar::after { content: ""; position: absolute; inset: 0; background: url("data:image/svg+xml,%3Csvg width='20' height='20' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 10h20M10 0v20' stroke='%23c4b088' stroke-width='0.2' opacity='0.3'/%3E%3C/svg%3E"); pointer-events: none; z-index: 0; opacity: 0.5; }
  #sidebar > * { position: relative; z-index: 2; }
  #sidebar h2 { font-family: "Bebas Neue", "Arial Narrow", sans-serif; font-size: 16px; letter-spacing: 4px; color: #3a3020; text-transform: uppercase; margin: 0; padding: 12px 16px 8px; font-weight: 400; border-top: 2px solid #8a7a4a; position: relative; cursor: pointer; user-select: none; display: flex; align-items: center; justify-content: space-between; }
  #sidebar h2::after { content: ""; position: absolute; bottom: 0; left: 16px; right: 16px; height: 1px; background: linear-gradient(90deg, #c4a84a, transparent); }
  #sidebar h2:first-of-type { border-top: none; margin-top: 8px; }
  #sidebar h2 .chev { font-size: 10px; color: #8a7a5a; transition: transform 0.2s ease; line-height: 1; }
  #sidebar h2.collapsed .chev { transform: rotate(-90deg); }
  .sidebar-section { padding: 8px 16px 14px; }
  .sidebar-section.collapsed { display: none; }
  .row { display: flex; align-items: center; justify-content: space-between; margin: 5px 0; gap: 8px; }
  .row label { color: #5a4e38; font-size: 11px; font-weight: 500; letter-spacing: 0.5px; }
  .row select, .row input[type="range"] { background: #faf4e6; color: #3a3020; border: 1px solid #c4b088; border-radius: 0; padding: 4px 8px; font-size: 11px; font-family: "DM Mono", "Courier New", monospace; }
  .row select { min-width: 120px; }
  .row select:focus { border-color: #8a7a4a; outline: none; box-shadow: 0 0 0 2px rgba(196,168,74,0.25); }
  .row input[type="range"] { flex: 1; min-width: 0; accent-color: #8a6a2a; }
  .row .val { color: #6a4a1a; font-family: "DM Mono", monospace; font-size: 12px; min-width: 24px; text-align: right; font-weight: 500; }
  .toggle { display: flex; align-items: center; gap: 6px; cursor: pointer; }
  .toggle input { margin: 0; accent-color: #8a6a2a; }
  .seg { display: flex; gap: 0; background: #e4d8be; border-radius: 0; padding: 0; border: 2px solid #8a7a4a; }
  .seg button { flex: 1; background: transparent; color: #6a5e44; border: 0; border-right: 1px solid #c4b088; padding: 8px 4px; font-size: 10px; font-family: "Bebas Neue", sans-serif; cursor: pointer; border-radius: 0; letter-spacing: 2px; text-transform: uppercase; transition: all 0.15s; }
  .seg button:last-child { border-right: 0; }
  .seg button.active { background: #3a3020; color: #e8dcc0; }
  .seg button:hover:not(.active) { background: #d8c8a4; color: #3a3020; }
  .ship-card { background: #faf4e6; border: 1px solid #c4b088; border-left: 4px solid #c4b088; border-radius: 0; padding: 8px 10px; margin: 5px 0; cursor: pointer; transition: all 0.12s; position: relative; }
  .ship-card::before { content: ""; position: absolute; top: 0; right: 0; width: 0; height: 0; border-top: 12px solid #c4b088; border-left: 12px solid transparent; opacity: 0; transition: opacity 0.12s; }
  .ship-card:hover { background: #fff8ea; border-color: #a09060; border-left-color: #a09060; }
  .ship-card.active { border-left-color: #8a6a2a; border-color: #8a6a2a; background: #fff8ea; box-shadow: 2px 2px 0 #c4b088; }
  .ship-card.active::before { opacity: 1; border-top-color: #8a6a2a; }
  .ship-card .ship-head { display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: #4a3e28; }
  .ship-card .ship-head b { font-family: "Bebas Neue", sans-serif; font-weight: 400; font-size: 15px; letter-spacing: 2px; }
  .ship-card .ship-head .badge { font-family: "DM Mono", monospace; font-size: 10px; color: #8a7a5a; }
  .ship-card.active .ship-head { color: #2a2010; }
  .ship-card.active .ship-head .badge { color: #6a4a1a; }
  .ship-controls { margin-top: 8px; display: none; border-top: 1px solid #ddd0b0; padding-top: 8px; }
  .ship-card.active .ship-controls { display: block; }
  .heading-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 2px; }
  .heading-grid button { background: #faf4e6; color: #6a5e44; border: 1px solid #c4b088; border-radius: 0; padding: 5px 0; font-size: 10px; cursor: pointer; font-family: "DM Mono", monospace; letter-spacing: 0.5px; transition: all 0.1s; }
  .heading-grid button:hover { background: #e8dcc0; color: #3a3020; border-color: #a09060; }
  .heading-grid button.active { background: #3a3020; color: #e8dcc0; border-color: #3a3020; }
  .meta { color: #8a7a5a; font-size: 10px; margin-top: 6px; font-family: "DM Mono", monospace; letter-spacing: 0.3px; }
  /* --- board --- */
  #board-wrap { position: relative; overflow: hidden; background: #2a2620; }
  #board { width: 100%; height: 100%; background: linear-gradient(135deg, #e8dcc0 0%, #d9c89f 100%); }
  #hud { position: absolute; top: 12px; right: 12px; background: rgba(0,0,0,0.55); color: #c9b88a; padding: 8px 12px; font-family: "SF Mono", monospace; font-size: 11px; border-radius: 3px; line-height: 1.5; pointer-events: none; }
  /* --- perspective panes ---
     In EoG everything attacker- AND defender-specific hides, including the
     board overlays (mode-toggle, run-controls, picker, teletype line, etc).
     The endgame-only pane shows in its place. */
  body[data-perspective="attacker"] .defender-only { display: none !important; }
  body[data-perspective="defender"] .attacker-only { display: none !important; }
  body[data-perspective="endgame"] .defender-only,
  body[data-perspective="endgame"] .attacker-only { display: none !important; }
  body:not([data-perspective="endgame"]) .endgame-only { display: none !important; }
  #sidebar h2.first-section { border-top: none; }
  /* hit aura + contact tracks — toggle visibility without re-render */
  body[data-hit-aura="off"] #layer-aura { display: none; }
  body[data-contact-tracks="off"] #layer-contacts { display: none; }
  body[data-contact-tracks="off"] #contactsList { display: none; }
  body[data-contact-tracks="off"] #contactsList + .meta { display: none; }
  /* --- firing UX: teletype line (visible only when aim is locked) --- */
  #teletypeLine { display: none; }
  body[data-perspective="attacker"][data-aim="locked"] #teletypeLine { display: block; }
  #teletypeLine {
    position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%);
    font-family: "DM Mono", monospace; font-size: 12px; color: #e8cc6a;
    background: rgba(0,0,0,0.7); padding: 6px 14px; border: 1px solid rgba(196,168,74,0.45);
    letter-spacing: 1px; z-index: 11; white-space: nowrap;
  }
  #teletypeLine .cur { animation: blink 1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0.3; } }
  /* --- mode controls overlay --- */
  #mode-controls { position: absolute; top: 12px; left: 12px; z-index: 10; display: flex; flex-direction: column; gap: 8px; }
  .mode-toggle { display: flex; gap: 0; border: 2px solid rgba(138,122,74,0.7); background: rgba(0,0,0,0.45); backdrop-filter: blur(6px); }
  .mode-toggle button { background: transparent; color: #c9b88a; border: none; border-right: 1px solid rgba(138,122,74,0.4); padding: 7px 14px; font-family: "Bebas Neue", sans-serif; font-size: 13px; letter-spacing: 2px; cursor: pointer; text-transform: uppercase; transition: all 0.15s; white-space: nowrap; }
  .mode-toggle button:last-child { border-right: none; }
  .mode-toggle button.active { background: rgba(196,168,74,0.25); color: #f0e8d0; }
  .mode-toggle button:hover:not(.active) { background: rgba(196,168,74,0.12); }
  .run-controls { display: flex; align-items: center; gap: 6px; }
  .run-controls.hidden { display: none; }
  .run-controls button { background: rgba(0,0,0,0.5); color: #c9b88a; border: 1px solid rgba(138,122,74,0.5); padding: 5px 10px; font-size: 14px; cursor: pointer; font-family: "Bebas Neue", sans-serif; letter-spacing: 1px; transition: all 0.15s; line-height: 1; }
  .run-controls button:hover { background: rgba(196,168,74,0.25); color: #f0e8d0; border-color: #c4a84a; }
  .run-controls button:active { background: rgba(196,168,74,0.4); }
  .run-controls button:disabled { opacity: 0.35; cursor: default; }
  #tickDisplay { color: #c9b88a; font-family: "DM Mono", monospace; font-size: 12px; background: rgba(0,0,0,0.5); padding: 5px 10px; border: 1px solid rgba(138,122,74,0.3); min-width: 70px; text-align: center; }
  #speedChart { background: rgba(0,0,0,0.5); border: 1px solid rgba(138,122,74,0.3); padding: 6px 10px; font-family: "DM Mono", monospace; font-size: 10px; color: #a09070; line-height: 1.6; }
  #speedChart .moves { color: #e8cc6a; }
  #speedChart b { color: #c9b88a; font-weight: 600; }
  /* --- mini-board (PIP, opposite perspective) ---
     Hidden in EoG (review already shows everything). Click to swap. */
  #miniboard-wrap {
    position: absolute; bottom: 12px; right: 12px; z-index: 9;
    width: 20%; max-width: 205px; min-width: 150px;
    aspect-ratio: 1 / 1;
    background: linear-gradient(135deg, #e8dcc0 0%, #d9c89f 100%);
    border: 2px solid rgba(58,46,28,0.55);
    box-shadow: 0 4px 14px rgba(0,0,0,0.35);
    cursor: pointer;
    transition: border-color 0.15s, box-shadow 0.15s;
    overflow: hidden;
  }
  #miniboard-wrap:hover { border-color: #2a6f9c; box-shadow: 0 4px 18px rgba(42,111,156,0.55); }
  #miniboard-wrap #miniboard { width: 100%; height: 100%; display: block; }
  /* Hide every SVG <text> in the mini — labels (ship ids, tick numbers,
     coords, etc) are unreadable at mini scale and just become visual noise. */
  #miniboard text { display: none; }
  #miniboard-label {
    position: absolute; top: 4px; left: 6px; z-index: 1;
    font-family: "Bebas Neue", sans-serif; font-size: 11px; letter-spacing: 2px;
    color: #3a2e1c; background: rgba(232,220,192,0.85);
    /* Asymmetric padding to balance two typography quirks WITHOUT moving the
       glyphs themselves: letter-spacing adds ~2px of phantom space after the
       last character (right side), and Bebas Neue's line-box has more leading
       below the baseline than above (bottom side). Trim 2px from each. */
    padding: 2px 4px 0 6px;
    border: 1px solid rgba(58,46,28,0.35); pointer-events: none;
    text-transform: uppercase;
  }
  body[data-perspective="endgame"] #miniboard-wrap { display: none; }
  /* --- perspective label (top-right corner) --- */
  #perspectiveLabel { position: absolute; top: 12px; right: 12px; font-family: "Bebas Neue", sans-serif; font-size: 18px; letter-spacing: 6px; color: #c9b88a; background: rgba(0,0,0,0.55); padding: 7px 16px; pointer-events: none; text-transform: uppercase; border: 1px solid rgba(138,122,74,0.4); }
  body[data-perspective="attacker"] #perspectiveLabel { color: #f0c8b0; border-color: rgba(160,80,48,0.6); }
  /* --- hit / probe log --- */
  #hitLog, #probeLog { max-height: 180px; overflow-y: auto; font-family: "DM Mono", monospace; font-size: 10px; color: #5a4e38; line-height: 1.7; }
  #hitLog:empty::after { content: "No incoming fire yet."; color: #a09878; font-style: italic; }
  #probeLog:empty::after { content: "Awaiting fire orders."; color: #a09878; font-style: italic; }
  .log-entry { padding: 2px 0; border-bottom: 1px solid #e4d8be; }
  .log-hit { color: #a03020; font-weight: 600; }
  .log-miss { color: #708060; }
  .log-sunk { color: #6a1a10; font-weight: 700; background: rgba(160,48,32,0.08); padding: 2px 4px; }
  /* teletype salvo grouping */
  .teletype-salvo { padding: 4px 0; transition: background 0.12s; cursor: default; }
  .teletype-salvo:hover { background: rgba(64,180,220,0.12); }
  .teletype-salvo .teletype-header { color: #4a3e20; font-weight: 700; letter-spacing: 0.5px; }
  .log-revisit { color: #b07020; font-weight: 700; }
  .log-revisit-tag { color: #b07020; font-size: 9px; }
  .log-sunk-inline { color: #6a1a10; font-weight: 700; }
  /* enemy fleet silhouette panel (§7.5) */
  .enemy-tally { font-family: "DM Mono", monospace; font-size: 11px; color: #5a4e38; padding: 4px 0 8px; letter-spacing: 0.5px; }
  .enemy-tally .tally-confirmed { color: #6a1a10; font-weight: 700; }
  .enemy-tally .tally-declared { color: #a06020; font-weight: 600; }
  .enemy-silhouette { display: grid; grid-template-columns: auto auto 1fr; grid-template-rows: auto auto; column-gap: 8px; row-gap: 2px; align-items: center; padding: 6px 10px; margin: 4px 0; background: #faf4e6; border: 1px solid #c4b088; border-left: 4px solid #c4b088; cursor: pointer; transition: all 0.12s; }
  .enemy-silhouette:hover { background: #fff8ea; border-color: #8a6a2a; border-left-color: #8a6a2a; }
  .enemy-silhouette.declared-sunk { opacity: 0.55; background: #e4d8be; border-left-color: #a03020; }
  .enemy-silhouette.declared-sunk:hover { opacity: 0.85; }
  .silhouette-size { grid-column: 1; grid-row: 1; font-family: "Bebas Neue", sans-serif; font-size: 16px; letter-spacing: 1px; color: #4a3e28; min-width: 14px; text-align: center; }
  .silhouette-cells { grid-column: 2; grid-row: 1; display: block; }
  .silhouette-ship { grid-column: 3; grid-row: 1; justify-self: end; display: block; }
  .silhouette-meta { grid-column: 1 / -1; grid-row: 2; font-family: "DM Mono", monospace; font-size: 9.5px; color: #6a5e44; letter-spacing: 0.5px; }
  .silhouette-assigning { color: var(--silhouette-color); font-weight: 700; letter-spacing: 1px; }
  .silhouette-status-sunk { color: #a03020; font-weight: 700; letter-spacing: 1px; }
  /* hit-assignment mode (§6c) — highlight the active card */
  .enemy-silhouette.assigning { background: #fff8ea; border-color: var(--silhouette-color); border-left-color: var(--silhouette-color); box-shadow: 0 0 0 2px var(--silhouette-color); }
  /* assignment instruction banner — always rendered; greyed when idle so the
     panel layout is stable when toggling assignment mode. */
  .enemy-assignment-banner { padding: 8px 10px; margin: 6px 0 8px; font-family: "DM Mono", monospace; font-size: 10.5px; line-height: 1.4; letter-spacing: 0.3px; border-radius: 2px; background: #ede0c4; color: #8a7a5a; border: 1px dashed #c4b088; }
  .enemy-assignment-banner.active { background: var(--silhouette-color); color: #ffffff; border: 1px solid var(--silhouette-color); }
  .enemy-assignment-banner b { font-family: "Bebas Neue", sans-serif; font-size: 13px; letter-spacing: 2px; display: block; margin-bottom: 3px; color: #4a3e28; }
  .enemy-assignment-banner.active b { color: #ffffff; }
  /* deprecated — older code path */
  .silhouette-status { display: none; }
  /* contacts panel (§7.4) */
  #contactsList:empty::after { content: "No contacts (toggle on to auto-correlate)."; color: #a09878; font-style: italic; font-family: "DM Mono", monospace; font-size: 10px; }
  .contact-card { background: #faf4e6; border: 1px solid #c4b088; border-left: 4px solid var(--track-color, #c4b088); padding: 6px 10px; margin: 5px 0; font-family: "DM Mono", monospace; font-size: 10px; color: #4a3e28; }
  .contact-card.confidence-inconsistent { border-left-color: #a03020; background: rgba(160,48,32,0.06); }
  .contact-card.confidence-consistent { border-left-color: #4a8a3a; }
  .contact-card .contact-head { display: flex; align-items: center; justify-content: space-between; font-family: "Bebas Neue", sans-serif; font-size: 14px; letter-spacing: 2px; color: var(--track-color, #3a3020); }
  .contact-card .contact-confidence { font-family: "DM Mono", monospace; font-size: 9px; letter-spacing: 1px; padding: 2px 5px; border: 1px solid currentColor; }
  .contact-card .contact-meta { margin-top: 4px; color: #6a5e44; font-size: 10px; }
  .contact-card .contact-meta b { color: #3a3020; }
  .contact-card .contact-meta .ambiguous { color: #a06020; }
  /* end-of-game panels (Stage 7) */
  .endgame-score { background: #3a3020; color: #e8dcc0; font-family: "Bebas Neue", sans-serif; font-size: 14px; letter-spacing: 2px; padding: 8px 12px; margin: 4px 0 8px; }
  .endgame-score b { color: #ffd060; font-size: 18px; }
  .endgame-validation-card, .endgame-outcome-card { background: #faf4e6; border: 1px solid #c4b088; border-left: 4px solid var(--silhouette-color, #c4b088); padding: 6px 10px; margin: 4px 0; font-family: "DM Mono", monospace; font-size: 10px; color: #4a3e28; }
  .endgame-validation-card.verdict-correct { border-left-color: #3a8030; background: rgba(58,128,48,0.08); }
  .endgame-validation-card.verdict-false { border-left-color: #a03020; background: rgba(160,48,32,0.08); }
  .endgame-validation-card.verdict-missed { border-left-color: #b87014; background: rgba(184,112,20,0.08); }
  .endgame-validation-card.verdict-neutral { opacity: 0.7; }
  .endgame-outcome-card.outcome-sunk { opacity: 0.6; border-left-color: #6a1a10; background: #e4d8be; }
  .endgame-outcome-card.outcome-alive { border-left-color: #3a8030; }
  .endgame-card-head { display: flex; justify-content: space-between; align-items: center; font-family: "Bebas Neue", sans-serif; font-size: 13px; letter-spacing: 2px; color: #3a3020; }
  .endgame-card-id { color: #3a3020; }
  .endgame-card-verdict { font-family: "DM Mono", monospace; font-size: 10px; letter-spacing: 1px; }
  .verdict-correct .endgame-card-verdict { color: #2a6020; }
  .verdict-false .endgame-card-verdict { color: #6a1a10; }
  .verdict-missed .endgame-card-verdict { color: #8a5014; }
  .outcome-sunk .endgame-card-verdict { color: #6a1a10; }
  .outcome-alive .endgame-card-verdict { color: #2a6020; }
  .endgame-card-body { margin-top: 3px; color: #5a4e38; }
  .endgame-card-body b { color: #3a3020; }
  /* End-of-game sub-view emphasizes either probe history or ship truth */
  body[data-endgame-view="attacker"] #endgameFleetOutcome { opacity: 0.5; }
  body[data-endgame-view="defender"] #endgameValidation { opacity: 0.5; }
  /* EoG board emphasis: dim ships when FROM ATTACKER, dim probe markers and
     attacker-side aids (aura, contact lines) when FROM DEFENDER. */
  body[data-perspective="endgame"][data-endgame-view="attacker"] #layer-ships { opacity: 0.5; }
  body[data-perspective="endgame"][data-endgame-view="defender"] #layer-markers { opacity: 0.45; }
  body[data-perspective="endgame"][data-endgame-view="defender"] #layer-aura { opacity: 0.3; }
  body[data-perspective="endgame"][data-endgame-view="defender"] #layer-contacts { opacity: 0.4; }
  /* --- hp pips --- */
  .hp-pips { display: flex; gap: 3px; margin-top: 4px; }
  .hp-pip { width: 10px; height: 10px; border-radius: 50%; border: 1px solid #8a7a5a; }
  .hp-pip.full { background: #4a8a3a; border-color: #3a6a2a; }
  .hp-pip.lost { background: #a03020; border-color: #802818; }
  .ship-card.sunk { opacity: 0.5; border-left-color: #a03020 !important; }
  .ship-card.sunk .ship-head b { text-decoration: line-through; }
  .ship-status { font-family: "DM Mono", monospace; font-size: 10px; color: #6a5a3a; margin-top: 4px; }
  .ship-status .cd-change { color: #a06020; font-weight: 600; }
  .ship-status .sunk-label { color: #a03020; font-weight: 700; font-size: 12px; }
  /* --- hit markers on board --- */
  .hit-marker-glow { animation: hitPulse 1.5s ease-out; }
  @keyframes hitPulse { 0% { opacity: 1; } 100% { opacity: 0; } }
  /* --- smoke particles --- */
  @keyframes smokeDrift {
    0%   { transform: translate(0, 0) scale(1); opacity: var(--smoke-o); }
    25%  { transform: translate(calc(var(--sx) * 0.3), calc(var(--sy) * 0.5 - 4px)) scale(1.15); opacity: calc(var(--smoke-o) * 0.9); }
    50%  { transform: translate(calc(var(--sx) * 0.7), calc(var(--sy) * 1.0 - 8px)) scale(1.35); opacity: calc(var(--smoke-o) * 0.65); }
    75%  { transform: translate(calc(var(--sx) * 0.5), calc(var(--sy) * 1.3 - 12px)) scale(1.5); opacity: calc(var(--smoke-o) * 0.35); }
    100% { transform: translate(0, 0) scale(1); opacity: var(--smoke-o); }
  }
  @keyframes smokeWander {
    0%   { transform: translate(0, 0); }
    33%  { transform: translate(calc(var(--wx) * 1px), calc(var(--wy) * 1px)); }
    66%  { transform: translate(calc(var(--wx) * -0.7px), calc(var(--wy) * 0.5px)); }
    100% { transform: translate(0, 0); }
  }
  @keyframes hitFlashBurst {
    0%   { r: 2; opacity: 1; fill: #fff8e0; }
    15%  { r: var(--burst-r); opacity: 0.95; fill: #ffaa30; }
    40%  { r: calc(var(--burst-r) * 1.6); opacity: 0.6; fill: #e04010; }
    70%  { r: calc(var(--burst-r) * 2.0); opacity: 0.25; fill: #801808; }
    100% { r: calc(var(--burst-r) * 2.2); opacity: 0; fill: #400800; }
  }
  @keyframes hitRingExpand {
    0%   { r: 2; stroke-width: 3; opacity: 1; }
    50%  { opacity: 0.7; }
    100% { r: var(--ring-r); stroke-width: 0.5; opacity: 0; }
  }
  @keyframes emberFloat {
    0%   { opacity: 1; transform: translate(0, 0); }
    100% { opacity: 0; transform: translate(calc(var(--ex) * 1px), calc(var(--ey) * 1px)); }
  }
  /* --- MISS SPLASH ANIMATIONS --- */
  @keyframes splashFlash {
    0%   { r: 2; opacity: 0.9; }
    25%  { r: var(--flash-r); opacity: 0.65; }
    100% { r: calc(var(--flash-r) * 0.3); opacity: 0; }
  }
  @keyframes splashRipple {
    0%   { r: 3; stroke-width: 2.2; opacity: 0; }
    8%   { opacity: 0.5; }
    50%  { opacity: 0.25; }
    100% { r: var(--ripple-r); stroke-width: 0.2; opacity: 0; }
  }
  @keyframes splashPlume {
    0%   { opacity: 0; transform: translateY(0) scale(1); }
    12%  { opacity: 0.6; }
    35%  { opacity: 0.4; transform: translateY(var(--py)) scale(0.8); }
    100% { opacity: 0; transform: translateY(calc(var(--py) * 1.4)) scale(0.3); }
  }
  @keyframes splashDrop {
    0%   { opacity: 0; transform: translate(0, 0); }
    10%  { opacity: 0.7; }
    45%  { opacity: 0.4; transform: translate(calc(var(--dx) * 0.5), var(--peak)); }
    100% { opacity: 0; transform: translate(var(--dx), var(--fall)); }
  }
  @keyframes rippleDistortFade {
    0%   { opacity: 0.75; }
    50%  { opacity: 0.4; }
    100% { opacity: 0; }
  }
  /* --- probe button --- */
  #probeToggle { background: rgba(160,48,32,0.6); color: #f0d8c0; border: 1px solid rgba(160,48,32,0.8); padding: 5px 10px; font-size: 12px; cursor: pointer; font-family: "Bebas Neue", sans-serif; letter-spacing: 2px; transition: all 0.15s; }
  #probeToggle:hover { background: rgba(160,48,32,0.8); }
  #probeToggle.active { background: rgba(160,48,32,0.9); box-shadow: 0 0 8px rgba(160,48,32,0.5); }
  /* --- inline icons --- */
  .ico { display: inline-block; vertical-align: middle; width: 14px; height: 14px; fill: currentColor; flex-shrink: 0; }
  .ico-sm { width: 11px; height: 13px; }
  .mode-toggle button .ico, .run-controls button .ico, #perspectiveLabel .ico { margin-right: 4px; }
</style>
</head>
<body>
<div id="app">

