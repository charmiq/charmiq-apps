function updateSimUI() {
  document.getElementById("tickDisplay").textContent = `Tick ${sim.tick}`;
  document.getElementById("stepBack").disabled = sim.tick <= 0;
}

function updateSpeedChart() {
  const chart = document.getElementById("speedChart");
  const dirs = hexDirs();
  const lines = fleet.map(s => {
    if (s.sunk) return `<b>${s.id}</b> <span style="color:#a03020">${ICO_SKULL_HTML} SUNK</span>`;
    const willMove = SHIP_SPEED.movesOnTick(s, sim.tick + 1);
    const action = sim.actions && sim.actions[s.id] ? sim.actions[s.id] : "";
    const nextMark = willMove ? ' · <span style="color:#90c060">▸ next</span>' : '';
    const actionMark = action ? ` · <span style="color:#e8cc6a">${action}</span>` : '';
    const cdStr = s.hitsTaken > 0 ? ` cd${s.baseCooldown}→<span style="color:#e8a040">${s.cooldown}</span>` : ` cd${s.cooldown}`;
    return `<b>${s.id}</b> sz${s.size} ${dirs[s.head].name}${cdStr} <span class="moves">${SHIP_SPEED.label(s)}</span>${actionMark}${nextMark}`;
  });
  chart.innerHTML = lines.join('<br>');
}

/* =====================================================================
   2. HEX GEOMETRY  (math only — no DOM)
   ===================================================================== */

function hexDirs() { return state.orient === "pointy" ? HEX_DIRS_POINTY : HEX_DIRS_FLAT; }

function axialToPx(q, r, hexR) {
  if (state.orient === "pointy") {
    const w = Math.sqrt(3) * hexR;
    const h = 1.5 * hexR;
    return { x: w * (q + r/2), y: h * r };
  } else {
    const w = 1.5 * hexR;
    const h = Math.sqrt(3) * hexR;
    return { x: w * q, y: h * (r + q/2) };
  }
}

function hexCorners(cx, cy, hexR) {
  const pts = [];
  const offset = state.orient === "pointy" ? -30 : 0;
  for (let i = 0; i < 6; i++) {
    const a = (Math.PI/180) * (60*i + offset);
    pts.push([cx + hexR*Math.cos(a), cy + hexR*Math.sin(a)]);
  }
  return pts;
}

function inBoard(q, r, R) {
  return Math.abs(q) <= R && Math.abs(r) <= R && Math.abs(q + r) <= R;
}

// Wrap an axial coordinate back onto the board (toroidal hex grid).
// Uses the 6 edge-to-edge translation vectors for a hexagonal region.
function hexWrapOffsets(R) {
  return [
    [-(2*R+1),  R      ],  // edge q=+R  → q=-R
    [  2*R+1,  -R      ],  // edge q=-R  → q=+R
    [-(R+1),   -R      ],  // edge s=-R  → s=+R  (q+r>R, diagonal)
    [  R+1,     R      ],  // edge s=+R  → s=-R  (q+r<-R, diagonal)
    [  R,      -(2*R+1)],  // edge r=+R  → r=-R
    [ -R,       2*R+1  ],  // edge r=-R  → r=+R
  ];
}

function wrapHex(q, r, R) {
  if (inBoard(q, r, R)) return { q, r };
  const offsets = hexWrapOffsets(R);
  for (const [dq, dr] of offsets) {
    if (inBoard(q + dq, r + dr, R)) return { q: q + dq, r: r + dr };
  }
  // Double offset for corner cases
  for (let i = 0; i < offsets.length; i++) {
    for (let j = i + 1; j < offsets.length; j++) {
      const wq = q + offsets[i][0] + offsets[j][0];
      const wr = r + offsets[i][1] + offsets[j][1];
      if (inBoard(wq, wr, R)) return { q: wq, r: wr };
    }
  }
  return { q, r };
}

// Raw (unwrapped) cells — the "true" trajectory
function shipCellsRaw(ship) {
  const dir = hexDirs()[ship.head];
  const cells = [];
  for (let i = 0; i < ship.size; i++) {
    cells.push({ q: ship.q + i * dir.dq, r: ship.r + i * dir.dr });
  }
  return cells;
}

// Wrapped cells — for board display (highlighting, hit detection)
function shipCells(ship) {
  return shipCellsRaw(ship).map(c => wrapHex(c.q, c.r, state.radius));
}

function centroidPx(cells, hexR) {
  let x = 0, y = 0;
  cells.forEach(c => { const p = axialToPx(c.q, c.r, hexR); x += p.x; y += p.y; });
  return { x: x / cells.length, y: y / cells.length };
}

/* =====================================================================
   3. SHIP FEATURE BUILDER  (single source of truth for A / B / E)
   Returns geometric primitives in ship-local coords (bow toward +x).
   ===================================================================== */

function buildShipFeatures(ship, hexR) {
  // Distance between adjacent hex centers is always sqrt(3)*hexR regardless of orientation
  const cellSpan = Math.sqrt(3) * hexR;
  const L = ship.size * cellSpan * 1.02;
  const B = hexR * 0.78;
  const bow = L * 0.42, stern = -L * 0.5;
  const hullPath = `
    M ${bow},0
    C ${bow},${-B*0.4} ${bow*0.35},${-B*0.95} ${0},${-B*0.95}
    L ${stern*0.6},${-B*0.95}
    C ${stern},${-B*0.85} ${stern},${-B*0.4} ${stern},0
    C ${stern},${B*0.4} ${stern},${B*0.85} ${stern*0.6},${B*0.95}
    L ${0},${B*0.95}
    C ${bow*0.35},${B*0.95} ${bow},${B*0.4} ${bow},0 Z
  `;
  const deckPath = `
    M ${bow*0.85},0
    C ${bow*0.85},${-B*0.3} ${bow*0.3},${-B*0.72} ${0},${-B*0.72}
    L ${stern*0.55},${-B*0.72}
    C ${stern*0.85},${-B*0.6} ${stern*0.85},${-B*0.3} ${stern*0.85},0
    C ${stern*0.85},${B*0.3} ${stern*0.85},${B*0.6} ${stern*0.55},${B*0.72}
    L ${0},${B*0.72}
    C ${bow*0.3},${B*0.72} ${bow*0.85},${B*0.3} ${bow*0.85},0 Z
  `;

  // Bridge position: scale with L so features spread properly on longer ships
  // BB (5): push bridge well aft to make room for dual forward turrets
  // PT (2): push bridge aft a bit for compact look
  const bridgeX = ship.size >= 5 ? -L * 0.10
                : ship.size <= 2 ? -L * 0.14
                : -L * 0.06;

  return {
    L, B, bow, stern, hullPath, deckPath,
    fwdTurret:  { x: bow * 0.55, r: B * 0.32 },
    fwdTurret2: ship.size >= 5 ? { x: bow * 0.20, r: B * 0.30 } : null,
    aftTurret:  ship.size >= 3 ? { x: stern * 0.55, r: B * 0.32 } : null,
    bridge:     { x: bridgeX, y: -B*0.4, w: B*1.1, h: B*0.8 },
    stack:      ship.size >= 4 ? { x: bridgeX + B * 0.78, r: B*0.18 } : null,
    barrel:     { x: bow*0.55, y: -B*0.08, w: L*0.06, h: B*0.16 },
    bowWedge:   `M ${bow+2},0 L ${bow-5},-3 L ${bow-5},3 Z`,
  };
}

/* =====================================================================
   4. RENDERERS  (each: (svgGroup, ship, feat) => void)
   A / B / E share buildShipFeatures(). F has its own geometry.
   ===================================================================== */

const SVG_NS = "http://www.w3.org/2000/svg";
const el = (tag, attrs = {}) => {
  const e = document.createElementNS(SVG_NS, tag);
  for (const k in attrs) e.setAttribute(k, attrs[k]);
  return e;
};

const renderers = {

  // ---- A · INK SILHOUETTE ----------------------------------------
  // Same anatomy as B, but everything is the same dark fill.
  A(g, ship, feat) {
    g.appendChild(el("path", { d: feat.hullPath, fill: "#1a1410", stroke: "#000", "stroke-width": 0.6 }));
    g.appendChild(el("path", { d: feat.bowWedge, fill: "#5a4a30" }));   // tiny wedge marks the bow
    // Subtle deck centerline so orientation is unambiguous
    g.appendChild(el("path", {
      d: `M ${feat.stern*0.85},0 L ${feat.bow*0.85},0`,
      stroke: "#c9b58a", "stroke-width": 0.8, opacity: 0.4, fill: "none"
    }));
  },

  // ---- B · DECK DETAIL (default) ---------------------------------
  B(g, ship, feat) {
    g.appendChild(el("path", { d: feat.hullPath, fill: "url(#hullGrad)", stroke: "#1c1f1a", "stroke-width": 0.5 }));
    g.appendChild(el("path", { d: feat.deckPath, fill: "url(#deckGrad)" }));

    const features = el("g", { filter: "url(#hardShadow)" });
    features.appendChild(el("circle", { cx: feat.fwdTurret.x, cy: 0, r: feat.fwdTurret.r, fill: "#3c4438" }));
    if (feat.fwdTurret2) features.appendChild(el("circle", { cx: feat.fwdTurret2.x, cy: 0, r: feat.fwdTurret2.r, fill: "#3c4438" }));
    if (feat.aftTurret) features.appendChild(el("circle", { cx: feat.aftTurret.x, cy: 0, r: feat.aftTurret.r, fill: "#3c4438" }));
    features.appendChild(el("rect", { x: feat.bridge.x, y: feat.bridge.y, width: feat.bridge.w, height: feat.bridge.h, fill: "#5a6450", stroke: "#2c332a", "stroke-width": 0.3 }));
    if (feat.stack)     features.appendChild(el("circle", { cx: feat.stack.x, cy: 0, r: feat.stack.r, fill: "#1a1c18" }));
    features.appendChild(el("rect", { x: feat.barrel.x, y: feat.barrel.y, width: feat.barrel.w, height: feat.barrel.h, fill: "#2a2e26" }));
    g.appendChild(features);
  },

  // ---- E · BLUEPRINT LINE ----------------------------------------
  // Same anatomy, outlines only, light parchment fill.
  E(g, ship, feat) {
    const stroke = { fill: "none", stroke: "#3a2e1c", "stroke-width": 0.9, "stroke-linejoin": "round" };
    g.appendChild(el("path", { d: feat.hullPath, fill: "#c9b48a", "fill-opacity": 0.55, stroke: "none" }));
    g.appendChild(el("path", { d: feat.hullPath, ...stroke }));
    g.appendChild(el("path", { d: feat.deckPath, ...stroke, "stroke-width": 0.55 }));
    // Keel dashed line
    g.appendChild(el("path", { d: `M ${feat.stern*0.92},0 L ${feat.bow*0.92},0`, ...stroke, "stroke-width": 0.4, "stroke-dasharray": "2,2" }));
    // Hex-cell dots
    for (let i = 0; i < ship.size; i++) {
      const dx = feat.stern + (i + 0.5) * (feat.L / ship.size);
      g.appendChild(el("circle", { cx: dx, cy: 0, r: 1.2, fill: "#3a2e1c" }));
    }
    g.appendChild(el("circle", { cx: feat.fwdTurret.x, cy: 0, r: feat.fwdTurret.r, ...stroke }));
    if (feat.fwdTurret2) g.appendChild(el("circle", { cx: feat.fwdTurret2.x, cy: 0, r: feat.fwdTurret2.r, ...stroke }));
    if (feat.aftTurret) g.appendChild(el("circle", { cx: feat.aftTurret.x, cy: 0, r: feat.aftTurret.r, ...stroke }));
    g.appendChild(el("rect", { x: feat.bridge.x, y: feat.bridge.y, width: feat.bridge.w, height: feat.bridge.h, ...stroke }));
  },

  // ---- F · COMMAND COUNTER (own geometry) ------------------------
  F(g, ship, feat) {
    const L = feat.L, B = feat.B * 1.15;
    g.appendChild(el("rect", { x: -L/2, y: -B*0.7, width: L, height: B*1.4, rx: B*0.25, fill: "#1a3050", stroke: "#0a1828", "stroke-width": 0.8 }));
    const arrow = el("path", {
      d: `M ${-L/2 + B*0.3},${-B*0.4} L ${L/2 - B*0.7},${-B*0.4} L ${L/2 - B*0.3},0 L ${L/2 - B*0.7},${B*0.4} L ${-L/2 + B*0.3},${B*0.4} Z`,
      fill: "#3a6090"
    });
    g.appendChild(arrow);
    // Size number (counter-rotated so it's always upright)
    const text = el("text", {
      y: B*0.22, "text-anchor": "middle", "font-family": "Georgia",
      "font-weight": "bold", "font-size": B*0.75, fill: "#f0e8d0",
      transform: `rotate(${-(hexDirs()[ship.head].angle)})`
    });
    text.textContent = ship.size;
    g.appendChild(text);
    // Pips — one per cell, running stern→bow (left→right in local coords)
    for (let i = 0; i < ship.size; i++) {
      const px = -L/2 + (i + 0.5) * (L / ship.size);
      g.appendChild(el("circle", { cx: px, cy: B*0.55, r: 1.6, fill: "#f0e8d0" }));
    }
  },
};

/* =====================================================================
   5. BOARD RENDER  (layered pipeline)
   ===================================================================== */

/* Attacker decay clock (§7.2 / §7.3). Everything that ages on the attacker
 * side — hit color, miss dot opacity, hit aura — decays on the same schedule
 * so the player reads one timeline, not three.
 *   AURA_FADE_TICKS  : aura is gone AT this age (ages 0…AURA_FADE_TICKS-1 render)
 *   HIT_RECENT_THRU  : "Recent" bucket ends here     (= last visible aura age)
 *   HIT_AGING_THRU   : "Aging" bucket ends here      (= 2 × HIT_RECENT_THRU); past this, "Stale"
 */
const AURA_FADE_TICKS = 6;
const HIT_RECENT_THRU = AURA_FADE_TICKS - 1;
const HIT_AGING_THRU  = HIT_RECENT_THRU * 2;

/* Age-based hit/miss treatments for the attacker view (§7.2).
 * The defender's hit markers are NOT aged — for the defender they visualize
 * current damage state, not historical timing. Buckets, not a smooth gradient:
 * Fresh (this turn) · Recent · Aging · Stale.
 * Misses never disappear — they fade to a floor. */
function attackerHitAgeTreatment(age) {
  if (age <= 0)               return { x: "#c03020", xOp: 1.00, xW: 2.4, scorch: 1.00, lblSize: 1.10, lblOp: 1.00, lblW: 700 };
  if (age <= HIT_RECENT_THRU) return { x: "#c03020", xOp: 1.00, xW: 2.2, scorch: 1.00, lblSize: 1.00, lblOp: 1.00, lblW: 600 };
  if (age <= HIT_AGING_THRU)  return { x: "#a04030", xOp: 0.85, xW: 2.0, scorch: 0.65, lblSize: 0.90, lblOp: 0.85, lblW: 500 };
  return                             { x: "#8a5040", xOp: 0.60, xW: 1.6, scorch: 0.35, lblSize: 0.75, lblOp: 0.55, lblW: 400 };
}
function attackerMissAgeTreatment(age) {
  if (age <= 0)               return { fillA: 0.40, strokeA: 0.55, lblSize: 1.00, lblOp: 0.80 };
  if (age <= HIT_RECENT_THRU) return { fillA: 0.35, strokeA: 0.50, lblSize: 1.00, lblOp: 0.65 };
  if (age <= HIT_AGING_THRU)  return { fillA: 0.25, strokeA: 0.35, lblSize: 0.90, lblOp: 0.45 };
  return                             { fillA: 0.18, strokeA: 0.25, lblSize: 0.75, lblOp: 0.30 };
}

/* renderBoard caches its (cellByKey, hexR, svg) here so the surgical aim/preview
 * updaters below can re-use them without a full re-render. Re-populated every
 * renderBoard. Stays valid until the next renderBoard (no entries are removed).
 */
const renderCache = { svg: null, cellByKey: null, hexR: 0 };

function ensureSvgLayer(id) {
  const svg = renderCache.svg;
  if (!svg) return null;
  let layer = svg.querySelector(`#${id}`);
  if (!layer) {
    layer = document.createElementNS("http://www.w3.org/2000/svg", "g");
    layer.setAttribute("id", id);
    layer.setAttribute("pointer-events", "none");
    svg.appendChild(layer);
  }
  return layer;
}

// Surgical updaters — called by both renderBoard (post-render) AND directly by
// setAim / setHoverDestination / clearAim so those handlers don't trigger a full
// SVG wipe (which would destroy any in-flight fresh-hit animation).
function updateAimLayer() {
  const layer = ensureSvgLayer("layer-aim");
  if (!layer) return;
  while (layer.firstChild) layer.removeChild(layer.firstChild);
  if (state.perspective !== "attacker" || !attacker.aim) return;
  const { cellByKey, hexR } = renderCache;
  const slot = cellByKey && cellByKey[`${attacker.aim.q},${attacker.aim.r}`];
  if (!slot) return;
  const SVG_NS = "http://www.w3.org/2000/svg";
  const mk = (tag, attrs) => {
    const e = document.createElementNS(SVG_NS, tag);
    for (const k in attrs) e.setAttribute(k, attrs[k]);
    return e;
  };
  // 1. Cell background — yellow fill so the locked aim cell is obviously
  // marked even before the reticle is read.
  const corners = hexCorners(slot.px, slot.py, hexR).map(p => p.join(",")).join(" ");
  layer.appendChild(mk("polygon", {
    points: corners,
    fill: "rgba(232,204,106,0.55)",
    stroke: "rgba(184,154,60,0.95)",
    "stroke-width": 1.8
  }));
  // 2. Reticle on top in dark slate for strong contrast against the yellow.
  const reticleColor = "#3a2e1c";
  const g = mk("g", { transform: `translate(${slot.px},${slot.py})` });
  g.appendChild(mk("circle", { cx: 0, cy: 0, r: hexR * 0.78, fill: "none", stroke: reticleColor, "stroke-width": 1.6, opacity: 0.85 }));
  g.appendChild(mk("circle", { cx: 0, cy: 0, r: hexR * 0.45, fill: "none", stroke: reticleColor, "stroke-width": 1.0, opacity: 0.65 }));
  const cr = hexR * 0.42, cri = hexR * 0.13;
  [[-cr,0,-cri,0], [cri,0,cr,0], [0,-cr,0,-cri], [0,cri,0,cr]].forEach(([x1,y1,x2,y2]) => {
    g.appendChild(mk("line", { x1, y1, x2, y2, stroke: reticleColor, "stroke-width": 1.5, opacity: 0.9 }));
  });
  layer.appendChild(g);
  // 3. Small "SHOT 1/2" hint right below the cell so the player sees what
  // state they're in without having to scan to the teletype at the bottom.
  // Layer is pointer-events:none, so this never intercepts a click on the
  // south-neighbor cell that this text visually overlaps.
  const fontSize = Math.max(9, hexR * 0.30);
  const labelText = mk("text", {
    x: slot.px,
    y: slot.py + hexR * 1.05 + fontSize,
    "text-anchor": "middle",
    "font-family": "'DM Mono', monospace",
    "font-size": fontSize,
    fill: "#3a2e1c",
    "font-weight": "700",
    "letter-spacing": "1.5px",
    opacity: 0.85
  });
  labelText.textContent = "SHOT 1/2";
  layer.appendChild(labelText);
}

function updatePreviewLayer() {
  const layer = ensureSvgLayer("layer-preview");
  if (!layer) return;
  while (layer.firstChild) layer.removeChild(layer.firstChild);
  if (state.perspective !== "attacker" || !attacker.aim || !attacker.hoverDestination) return;
  const { cellByKey, hexR } = renderCache;
  if (!cellByKey) return;
  // Single ghost-orange poly on the hover-destination cell. The aim reticle
  // is on the aim cell separately (updateAimLayer). Together they show the
  // 2-cell salvo that the next click will fire.
  const ps = cellByKey[`${attacker.hoverDestination.q},${attacker.hoverDestination.r}`];
  if (!ps) return;
  const SVG_NS = "http://www.w3.org/2000/svg";
  const corners = hexCorners(ps.px, ps.py, hexR).map(p => p.join(",")).join(" ");
  const poly = document.createElementNS(SVG_NS, "polygon");
  poly.setAttribute("points", corners);
  poly.setAttribute("fill", "rgba(255,136,48,0.35)");
  poly.setAttribute("stroke", "rgba(255,136,48,0.85)");
  poly.setAttribute("stroke-width", "1.8");
  layer.appendChild(poly);
}

// Cross-panel hover highlight (teletype row → cells on board). Cyan to read
// as "informational lookup" — distinct from the warm-toned aim/preview/aura.
// Surgical layer update, no full renderBoard, so in-flight animations survive.
function highlightCellsOnBoard(cells) {
  const layer = ensureSvgLayer("layer-temp-highlight");
  if (!layer) return;
  while (layer.firstChild) layer.removeChild(layer.firstChild);
  if (!cells || cells.length === 0) return;
  const { cellByKey, hexR } = renderCache;
  if (!cellByKey) return;
  const SVG_NS = "http://www.w3.org/2000/svg";
  cells.forEach(({ q, r }) => {
    const slot = cellByKey[`${q},${r}`];
    if (!slot) return;
    const corners = hexCorners(slot.px, slot.py, hexR).map(p => p.join(",")).join(" ");
    const poly = document.createElementNS(SVG_NS, "polygon");
    poly.setAttribute("points", corners);
    poly.setAttribute("fill", "rgba(64,180,220,0.22)");
    poly.setAttribute("stroke", "#1a78b0");
    poly.setAttribute("stroke-width", "2.5");
    layer.appendChild(poly);
  });
}

function seededRand(seed) {
  let s = seed;
  return () => { s = (s * 16807 + 0) % 2147483647; return (s - 1) / 2147483646; };
}

function computeHexR(boardW, boardH, R, marginOverride) {
  // Fit the board (2R+1 hexes across, ~similar tall) with margin.
  // marginOverride is used by the mini-board so its grid fills the tiny
  // container without the main board's generous chrome margin shrinking it.
  const margin = marginOverride != null ? marginOverride : 40;
  if (state.orient === "pointy") {
    const wCells = 2*R + 1, hCells = (3*R)/2 + 1;
    const wByW = (boardW - 2*margin) / (wCells * Math.sqrt(3));
    const wByH = (boardH - 2*margin) / (hCells * 1.5);
    return Math.min(wByW, wByH);
  } else {
    const wCells = (3*R)/2 + 1, hCells = 2*R + 1;
    const wByW = (boardW - 2*margin) / (wCells * 1.5);
    const wByH = (boardH - 2*margin) / (hCells * Math.sqrt(3));
    return Math.min(wByW, wByH);
  }
}

/* renderBoard(opts):
 *   opts.svg          target SVG element (default: #board, the main board)
 *   opts.perspective  perspective to render ("defender" | "attacker" | "endgame")
 *                     (default: state.perspective)
 *   opts.mini         skip interaction layers + animations + renderCache update
 *                     (default: false)
 * The mini-board (Stage M1) renders into a separate #miniboard SVG with the
 * opposite perspective; see design-mini-views.md. */
function renderBoard(opts) {
  opts = opts || {};
  const svg = opts.svg || document.getElementById("board");
  // Effective perspective: peek (C) wins over the user-selected one for
  // rendering. Mini-board passes its own explicit perspective, so peek doesn't
  // change the mini's perspective directly — but renderMiniBoard reads peek too
  // and picks the opposite, so during peek the mini shows the original side.
  const perspective = opts.perspective || state.peekingPerspective || state.perspective;
  const mini = !!opts.mini;
  // Mini-board sizes from its OWN bounding rect; main board sizes from its
  // wrap parent (board-wrap) so it fills available space.
  let W, H;
  if (mini) {
    const rect = svg.getBoundingClientRect();
    W = rect.width || 200;
    H = rect.height || 200;
  } else {
    const wrap = document.getElementById("board-wrap");
    W = wrap.clientWidth; H = wrap.clientHeight;
  }
  svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
  svg.innerHTML = "";

  // Mini wants a tight margin so the small container's grid stays the same
  // visual size as the main board's hexes (otherwise the fixed 40px main-board
  // margin eats most of the mini's 200px box).
  const hexR = computeHexR(W, H, state.radius, mini ? 4 : undefined);
  const cx = W/2, cy = H/2;

  // ---- DEFS ----------------------------------------------------------
  const defs = el("defs");
  defs.innerHTML = `
    <radialGradient id="paperVignette" cx="50%" cy="50%" r="70%">
      <stop offset="0%" stop-color="#f0e4c8" stop-opacity="0.0"/>
      <stop offset="70%" stop-color="#a08858" stop-opacity="0.10"/>
      <stop offset="100%" stop-color="#5a4628" stop-opacity="0.40"/>
    </radialGradient>
    <linearGradient id="hullGrad" x1="0" y1="-1" x2="0" y2="1">
      <stop offset="0%" stop-color="#6a7560"/>
      <stop offset="50%" stop-color="#4a5444"/>
      <stop offset="100%" stop-color="#2c332a"/>
    </linearGradient>
    <linearGradient id="deckGrad" x1="0" y1="-1" x2="0" y2="1">
      <stop offset="0%" stop-color="#7a6a4a"/>
      <stop offset="100%" stop-color="#5a4e36"/>
    </linearGradient>
    <filter id="shipShadow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="1.8"/>
      <feOffset dx="1.5" dy="2.5"/>
      <feComponentTransfer><feFuncA type="linear" slope="0.55"/></feComponentTransfer>
      <feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <filter id="hardShadow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="0.6"/>
      <feOffset dx="1" dy="1.6"/>
      <feComponentTransfer><feFuncA type="linear" slope="0.7"/></feComponentTransfer>
      <feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  `;
  // Board clip-path: union of all hex cell polygons (exact boundary)
  const boardClip = el("clipPath", { id: "boardClip" });
  defs.appendChild(boardClip);

  // Fade mask: blurred white hex region → fades at board edge
  const fadeMaskFilter = el("filter", { id: "fadeMaskBlur", x: "-20%", y: "-20%", width: "140%", height: "140%" });
  fadeMaskFilter.appendChild(el("feGaussianBlur", { in: "SourceGraphic", stdDeviation: String(hexR * 0.8) }));
  defs.appendChild(fadeMaskFilter);

  const fadeMask = el("mask", { id: "boardFadeMask" });
  fadeMask.appendChild(el("rect", { x: 0, y: 0, width: W, height: H, fill: "black" }));
  const fadeMaskHexes = el("g", { filter: "url(#fadeMaskBlur)" });
  fadeMask.appendChild(fadeMaskHexes);
  defs.appendChild(fadeMask);

  svg.appendChild(defs);

  // ---- LAYER: hex grid (all in-board cells) -------------------------
  const gridLayer = el("g", { id: "layer-grid" });
  svg.appendChild(gridLayer);

  const cellByKey = {};
  for (let q = -state.radius; q <= state.radius; q++) {
    for (let r = -state.radius; r <= state.radius; r++) {
      if (!inBoard(q, r, state.radius)) continue;
      const p = axialToPx(q, r, hexR);
      const px = cx + p.x, py = cy + p.y;
      const corners = hexCorners(px, py, hexR).map(c => c.join(",")).join(" ");
      const cell = el("polygon", { points: corners, fill: "transparent", stroke: "rgba(58,46,28,0.50)", "stroke-width": 0.8 });
      gridLayer.appendChild(cell);
      cellByKey[`${q},${r}`] = { px, py, cell };
      // Also add to clip-path and fade mask
      boardClip.appendChild(el("polygon", { points: corners }));
      fadeMaskHexes.appendChild(el("polygon", { points: corners, fill: "white" }));

      if (state.showCoords) {
        const t = el("text", { x: px, y: py + 3, "text-anchor": "middle", "font-family": "SF Mono, monospace", "font-size": Math.max(6, hexR*0.28), fill: "#8a7350", opacity: 0.55 });
        t.textContent = `${q},${r}`;
        gridLayer.appendChild(t);
      }
    }
  }

  // ---- LAYER: ship-cell highlights (defender · reveals ship truth) ---
  const highlightLayer = el("g", { id: "layer-highlight" });
  svg.appendChild(highlightLayer);

  if (perspective === "defender" && state.showHighlight) {
    fleet.forEach(ship => {
      const isActive = ship.id === activeShipId;
      if (ship.sunk) {
        // Sunk ships: dark red highlight
        shipCells(ship).forEach(c => {
          const key = `${c.q},${c.r}`;
          const slot = cellByKey[key];
          if (!slot) return;
          const corners = hexCorners(slot.px, slot.py, hexR).map(p => p.join(",")).join(" ");
          highlightLayer.appendChild(el("polygon", { points: corners, fill: "#6a2020", "fill-opacity": 0.25, stroke: "#4a1010", "stroke-width": 0.7 }));
        });
        return;
      }
      const damaged = ship.hitsTaken > 0;
      shipCells(ship).forEach(c => {
        const key = `${c.q},${c.r}`;
        const slot = cellByKey[key];
        if (!slot) return;
        const corners = hexCorners(slot.px, slot.py, hexR).map(p => p.join(",")).join(" ");
        let fill, stroke;
        if (damaged && isActive) { fill = "#8a5020"; stroke = "#6a3a10"; }
        else if (damaged) { fill = "#7a6040"; stroke = "#5a4020"; }
        else if (isActive) { fill = "#3a6090"; stroke = "#1f3a5f"; }
        else { fill = "#5a7a9a"; stroke = "#3a5a7a"; }
        highlightLayer.appendChild(el("polygon", {
          points: corners, fill, "fill-opacity": isActive ? 0.55 : 0.35,
          stroke, "stroke-width": isActive ? 1.4 : 0.9,
        }));
      });
    });
  }

  // ---- LAYER: vignette --------------------------------------------
  svg.appendChild(el("rect", { x: 0, y: 0, width: W, height: H, fill: "url(#paperVignette)", "pointer-events": "none" }));

  // ---- LAYER: hit aura (attacker · inference aid §7.3) -------------
  // A faint red ring around each HIT cell. Radius grows with elapsed turns —
  // the ship has had time to wander further, so the player's certainty about
  // where it CURRENTLY is decays in real time. Visibility is CSS-driven
  // by body[data-hit-aura], so toggling the checkbox is free (no re-render).
  // Always drawn; just hidden when off. Misses don't get an aura — a miss is
  // confirmed-empty info, not uncertain ship-position info.
  const auraLayer = el("g", { id: "layer-aura", "pointer-events": "none" });
  svg.appendChild(auraLayer);
  if (perspective === "attacker" || perspective === "endgame") {
    // Aura growth: 1 hex per tick of age, with a "tight" floor at age 0.
    // Units matter — center-to-center distance is √3·hexR (NOT hexR itself,
    // which is the hex's circumradius). Soft cap at state.radius cells so the
    // ring doesn't keep growing off-board indefinitely.
    // Opacity ramps from 0.32 down to 0 over AURA_FADE_TICKS, then we skip
    // the entry entirely (no DOM node).
    const cellDistance = Math.sqrt(3) * hexR;
    sim.hitLog.forEach(entry => {
      if (entry.result !== 'HIT') return;
      const slot = cellByKey[`${entry.q},${entry.r}`];
      if (!slot) return;
      const age = sim.tick - entry.tick;
      if (age >= AURA_FADE_TICKS) return;       // fully faded — skip
      const fadeT = age / AURA_FADE_TICKS;       // 0 at fresh, 1 at gone
      // Fresh-hit floor at 0.5 cells (tight around the X). Age 1+ tracks 1:1.
      const cellsOut = Math.min(state.radius, Math.max(0.5, age));
      const auraR = cellDistance * cellsOut;
      const stroke = Math.max(0.4, 2.0 * (1 - fadeT));
      const opacity = 0.32 * (1 - fadeT);
      auraLayer.appendChild(el("circle", {
        cx: slot.px, cy: slot.py, r: auraR,
        fill: "none",
        stroke: "rgba(160,48,32,1)", "stroke-width": stroke,
        opacity
      }));
    });
  }

  // ---- LAYER: contact tracks (attacker · inference aid §7.4) ------
  // Connects hits in the same auto-correlated track with a thin colored line.
  // Visibility is CSS-driven by body[data-contact-tracks]. We skip drawing
  // segments where the two hits are far apart in hex distance — those almost
  // certainly span the torus wrap, and the resulting line would cross the
  // entire board visually. Wrap-aware rendering is deferred (Stage 7-ish).
  const contactsLayer = el("g", { id: "layer-contacts", "pointer-events": "none" });
  svg.appendChild(contactsLayer);
  if ((perspective === "attacker" || perspective === "endgame") && attacker.contacts.length > 0) {
    const WRAP_SKIP_THRESHOLD = state.radius; // hex distance above which we assume wrap
    attacker.contacts.forEach((track, idx) => {
      if (track.hits.length < 2) return;
      const color = TRACK_COLORS[idx % TRACK_COLORS.length];
      const sorted = track.hits.slice().sort((a, b) => a.tick - b.tick);
      const stroke = track.confidence === "inconsistent" ? "rgba(160,48,32,1)" : color;
      const strokeWidth = track.confidence === "inconsistent" ? 2.0 : 1.5;
      for (let i = 1; i < sorted.length; i++) {
        const a = sorted[i - 1], b = sorted[i];
        if (hexDistance(a.q, a.r, b.q, b.r) > WRAP_SKIP_THRESHOLD) continue;
        const sa = cellByKey[`${a.q},${a.r}`];
        const sb = cellByKey[`${b.q},${b.r}`];
        if (!sa || !sb) continue;
        contactsLayer.appendChild(el("line", {
          x1: sa.px, y1: sa.py, x2: sb.px, y2: sb.py,
          stroke, "stroke-width": strokeWidth,
          opacity: 0.6,
          "stroke-dasharray": track.confidence === "consistent" ? "" : "4,3",
        }));
      }
    });
  }

  // ---- LAYER: ships (defender · reveals ship truth) ---------------
  const shipLayer = el("g", { id: "layer-ships" });
  svg.appendChild(shipLayer);

  const renderer = renderers[state.render];

  // Defender + EoG show ship truth. Attacker hides ships.
  if (perspective !== "attacker") fleet.forEach(ship => {
    if (ship.sunk) return; // sunk ships rendered separately below
    const rawCells = shipCellsRaw(ship);
    const wrappedCells = shipCells(ship);
    if (wrappedCells.length === 0) return;

    // "True" centroid of the unwrapped cells (may be off-board)
    const rawCtr = centroidPx(rawCells, hexR);
    const angle = hexDirs()[ship.head].angle;
    const feat = buildShipFeatures(ship, hexR);

    // Render a clipped copy at each wrap offset that has on-board cells
    const wrapVecs = [[0, 0], ...hexWrapOffsets(state.radius)];

    wrapVecs.forEach(([dq, dr]) => {
      const onBoard = rawCells.some(c => inBoard(c.q + dq, c.r + dr, state.radius));
      if (!onBoard) return;

      const wOff = axialToPx(dq, dr, hexR);
      const px = cx + rawCtr.x + wOff.x;
      const py = cy + rawCtr.y + wOff.y;

      // Ghost layer: faded overhang beyond board edge
      const ghostG = el("g", { mask: "url(#boardFadeMask)", opacity: 0.25 });
      const gGhost = el("g", { transform: `translate(${px},${py}) rotate(${angle})` });
      renderer(gGhost, ship, feat);
      ghostG.appendChild(gGhost);
      shipLayer.appendChild(ghostG);

      // Solid layer: clipped to board
      const clipG = el("g", { "clip-path": "url(#boardClip)" });
      const g = el("g", { transform: `translate(${px},${py}) rotate(${angle})`, filter: "url(#shipShadow)" });
      renderer(g, ship, feat);
      clipG.appendChild(g);
      shipLayer.appendChild(clipG);
    });

    // Label at anchor cell (always on-board)
    if (state.showLabels) {
      const anchorPx = axialToPx(ship.q, ship.r, hexR);
      const labelX = cx + anchorPx.x;
      const labelY = cy + anchorPx.y + hexR * 1.4;
      const label = el("text", {
        x: labelX, y: labelY,
        "text-anchor": "middle", "font-family": "SF Mono, monospace",
        "font-size": Math.max(8, hexR*0.32), fill: "#3a2e1c",
        opacity: ship.id === activeShipId ? 1 : 0.6,
        "font-weight": ship.id === activeShipId ? 700 : 400
      });
      label.textContent = `${ship.id}`;
      svg.appendChild(label);
    }
  });

  // ---- LAYER: sunk ships (defender · ghosted hull + wreck icon) ----
  if (perspective !== "attacker") fleet.filter(s => s.sunk).forEach(ship => {
    const rawCells = shipCellsRaw(ship);
    const rawCtr = centroidPx(rawCells, hexR);
    const angle = hexDirs()[ship.head].angle;
    const feat = buildShipFeatures(ship, hexR);
    const wrapVecs = [[0, 0], ...hexWrapOffsets(state.radius)];
    wrapVecs.forEach(([dq, dr]) => {
      const onBoard = rawCells.some(c => inBoard(c.q + dq, c.r + dr, state.radius));
      if (!onBoard) return;
      const wOff = axialToPx(dq, dr, hexR);
      const px = cx + rawCtr.x + wOff.x;
      const py = cy + rawCtr.y + wOff.y;
      const clipG = el("g", { "clip-path": "url(#boardClip)", opacity: "0.25" });
      const g = el("g", { transform: `translate(${px},${py}) rotate(${angle})` });
      // Render as dark silhouette
      g.appendChild(el("path", { d: feat.hullPath, fill: "#4a2020", stroke: "#2a0a0a", "stroke-width": 0.8 }));
      clipG.appendChild(g);
      shipLayer.appendChild(clipG);
    });
    // Wreck icon at anchor
    const anchorPx = axialToPx(ship.q, ship.r, hexR);
    const wx = cx + anchorPx.x, wy = cy + anchorPx.y;
    const wreckG = el("g", { transform: `translate(${wx},${wy})` });
    const wr = hexR * 0.35;
    wreckG.appendChild(el("line", { x1: -wr, y1: -wr, x2: wr, y2: wr, stroke: "#a03020", "stroke-width": 2.5, "stroke-linecap": "round" }));
    wreckG.appendChild(el("line", { x1: wr, y1: -wr, x2: -wr, y2: wr, stroke: "#a03020", "stroke-width": 2.5, "stroke-linecap": "round" }));
    if (state.showLabels) {
      const skullSize = Math.max(8, hexR * 0.35);
      const skullIcon = el("g", { transform: `translate(${-skullSize * 0.7},${hexR * 1.15})` });
      const skullPath = el("path", { d: ICO_SKULL_SVG_PATH, fill: "#a03020", opacity: "0.8", transform: `scale(${skullSize / 512})` });
      skullIcon.appendChild(skullPath);
      wreckG.appendChild(skullIcon);
      const label = el("text", { x: skullSize * 0.5, y: hexR * 1.4, "text-anchor": "middle", "font-family": "'DM Mono', monospace", "font-size": Math.max(8, hexR * 0.28), fill: "#a03020", opacity: 0.8 });
      label.textContent = ship.id;
      wreckG.appendChild(label);
    }
    shipLayer.appendChild(wreckG);
  });

  // ---- LAYER: hit/miss markers ------------------------------------
  // Defender: per-ship body-cell visualization (X count IS the damage).
  // Attacker: per-cell history (§7.2) — primary marker reflects the latest
  //   event with age-based treatment; older events stack as small badges.
  const markerLayer = el("g", { id: "layer-markers" });
  svg.appendChild(markerLayer);

  // Animate each new probe ONCE. Every entry above sim.lastAnimatedEntryIdx
  // whose tick matches the current tick is "fresh" and gets the burst/splash.
  // (A SET, not a single index, so a batched salvo's two cells both animate.)
  // Bumped to hitLog.length-1 after rendering — incidental re-renders within
  // the same tick (aim/hover/perspective) then see an empty fresh set.
  // Mini-board never animates (it'd compete with the main board's fresh-event
  // animations playing at the exact same instant, and the bump on
  // lastAnimatedEntryIdx would steal the main render's "needs animation" set).
  const freshIndices = new Set();
  if (!mini) {
    for (let i = sim.lastAnimatedEntryIdx + 1; i < sim.hitLog.length; i++) {
      if (sim.hitLog[i].tick === sim.tick) freshIndices.add(i);
    }
  }

  // Shared fresh-event animations — closures over hexR, markerLayer, defs, gridLayer.
  function renderFreshHitBurst(entry) {
    const probeSlot = cellByKey[`${entry.q},${entry.r}`];
    if (!probeSlot) return;
    const boomG = el("g", { transform: `translate(${probeSlot.px},${probeSlot.py})` });
    const burstR = hexR * 0.6;
    boomG.appendChild(el("circle", {
      cx: 0, cy: 0, r: 2, fill: "#ffcc40",
      style: `--burst-r:${burstR}px;animation:hitFlashBurst 0.8s ease-out forwards;`
    }));
    boomG.appendChild(el("circle", {
      cx: 0, cy: 0, r: 2, fill: "#ff6020",
      style: `--burst-r:${burstR*0.7}px;animation:hitFlashBurst 0.6s 0.05s ease-out forwards;`
    }));
    boomG.appendChild(el("circle", {
      cx: 0, cy: 0, r: 2, fill: "none", stroke: "#ff8830", "stroke-width": 3,
      style: `--ring-r:${hexR * 0.9}px;animation:hitRingExpand 0.7s ease-out forwards;`
    }));
    const emberRng = seededRand(entry.tick * 1000 + entry.q * 100 + entry.r);
    for (let e = 0; e < 10; e++) {
      const angle = emberRng() * Math.PI * 2;
      const dist = hexR * (0.3 + emberRng() * 0.7);
      const ex = Math.cos(angle) * dist;
      const ey = Math.sin(angle) * dist - (emberRng() * hexR * 0.3);
      const er = 0.8 + emberRng() * 1.5;
      const dur = 0.4 + emberRng() * 0.5;
      const emberColor = emberRng() > 0.5 ? "#ffaa30" : "#ff6818";
      boomG.appendChild(el("circle", {
        cx: 0, cy: 0, r: er, fill: emberColor,
        style: `--ex:${ex.toFixed(1)};--ey:${ey.toFixed(1)};animation:emberFloat ${dur.toFixed(2)}s ease-out forwards;`
      }));
    }
    markerLayer.appendChild(boomG);
  }

  function renderFreshMissSplash(missG, slot, entry) {
    const splashRng = seededRand(entry.tick * 3001 + entry.q * 197 + entry.r * 53);

    // 1. Central flash
    const flashR = hexR * 0.35;
    missG.appendChild(el("circle", {
      cx: 0, cy: 0, r: 2, fill: "#e8f0f8",
      style: `--flash-r:${flashR}px; animation: splashFlash 0.6s ease-out forwards;`
    }));
    missG.appendChild(el("circle", {
      cx: 0, cy: 0, r: 2, fill: "#c0d4e4", opacity: "0.5",
      style: `--flash-r:${flashR * 1.3}px; animation: splashFlash 0.75s 0.04s ease-out forwards;`
    }));

    // 2. Ripple rings
    for (let i = 0; i < 3; i++) {
      const rr = hexR * (0.4 + i * 0.25);
      const delay = i * 0.12;
      const dur = 1.0 + i * 0.25;
      const colors = ["#b0c8d8", "#90aec4", "#7a9ab4"];
      missG.appendChild(el("circle", {
        cx: 0, cy: 0, r: 3,
        fill: "none", stroke: colors[i], "stroke-width": 1.8 - i * 0.3,
        style: `--ripple-r:${rr}px; animation: splashRipple ${dur}s ${delay}s ease-out forwards;`
      }));
    }

    // 3. Plume particles
    for (let p = 0; p < 5; p++) {
      const py = -(hexR * (0.12 + p * 0.12));
      const pr = hexR * (0.05 + splashRng() * 0.04);
      const delay = p * 0.05;
      const ox = (splashRng() - 0.5) * hexR * 0.15;
      const colors = ["#dce8f0", "#c8d8e4", "#b0c4d4"];
      missG.appendChild(el("circle", {
        cx: ox, cy: 0, r: pr,
        fill: colors[p % 3],
        style: `--py:${py.toFixed(1)}px; animation: splashPlume ${(0.7 + p * 0.1).toFixed(2)}s ${delay.toFixed(3)}s ease-out forwards;`
      }));
    }

    // 4. Droplets
    for (let d = 0; d < 8; d++) {
      const angle = splashRng() * Math.PI * 2;
      const dist = hexR * (0.12 + splashRng() * 0.3);
      const dx = Math.cos(angle) * dist;
      const peakY = -(hexR * (0.1 + splashRng() * 0.35));
      const fallY = hexR * (0.02 + splashRng() * 0.08);
      const dr = 0.5 + splashRng() * 1.0;
      const dur = 0.6 + splashRng() * 0.5;
      const delay = splashRng() * 0.15;
      const dropColors = ["#d0dce8", "#b8ccd8", "#a0b4c4", "#e0eaf2"];
      missG.appendChild(el("circle", {
        cx: 0, cy: 0, r: dr,
        fill: dropColors[d % 4],
        style: `--dx:${dx.toFixed(1)}px; --peak:${peakY.toFixed(1)}px; --fall:${fallY.toFixed(1)}px; animation: splashDrop ${dur.toFixed(2)}s ${delay.toFixed(3)}s ease-out forwards;`
      }));
    }

    // 5. Grid distortion via canvas displacement map.
    // R = -cos(θ)·wave(d), G = -sin(θ)·wave(d). Negated because feDisplacementMap
    // defines sample-from offset, not push-to offset.
    const distortId = `splashDistort-${entry.tick}-${entry.q}-${entry.r}`;
    const rippleSize = 256;
    const rippleCanvas = document.createElement('canvas');
    rippleCanvas.width = rippleSize;
    rippleCanvas.height = rippleSize;
    const rctx = rippleCanvas.getContext('2d');
    const imgData = rctx.createImageData(rippleSize, rippleSize);
    const pxData = imgData.data;
    const rHalf = rippleSize / 2;
    const rippleFreq = 0.35;
    for (let iy = 0; iy < rippleSize; iy++) {
      for (let ix = 0; ix < rippleSize; ix++) {
        const ddx = ix - rHalf;
        const ddy = iy - rHalf;
        const dist = Math.sqrt(ddx * ddx + ddy * ddy);
        const norm = dist / rHalf;
        // Ripple decays at ~40% of map radius — only the center cell + 6 neighbors
        // get displacement; outer cells are padding to avoid sampling tearing.
        const envelope = Math.max(0, 1 - Math.pow(norm / 0.4, 2));
        const wave = Math.sin(dist * rippleFreq) * envelope;
        const angle = Math.atan2(ddy, ddx);
        const rx = dist > 1 ? -Math.cos(angle) * wave : 0;
        const ry = dist > 1 ? -Math.sin(angle) * wave : 0;
        const idx = (iy * rippleSize + ix) * 4;
        pxData[idx]     = 128 + Math.round(127 * rx);
        pxData[idx + 1] = 128 + Math.round(127 * ry);
        pxData[idx + 2] = 128;
        pxData[idx + 3] = 255;
      }
    }
    rctx.putImageData(imgData, 0, 0);
    const filterR = hexR * 5;
    const filterEl = el("filter", {
      id: distortId, filterUnits: "userSpaceOnUse",
      x: String(slot.px - filterR), y: String(slot.py - filterR),
      width: String(filterR * 2), height: String(filterR * 2)
    });
    const feImg = el("feImage", {
      href: rippleCanvas.toDataURL(),
      result: "rippleMap", preserveAspectRatio: "none",
      x: String(slot.px - filterR), y: String(slot.py - filterR),
      width: String(filterR * 2), height: String(filterR * 2)
    });
    filterEl.appendChild(feImg);
    const disp = el("feDisplacementMap", {
      in: "SourceGraphic", in2: "rippleMap",
      scale: "18", xChannelSelector: "R", yChannelSelector: "G"
    });
    filterEl.appendChild(disp);
    defs.appendChild(filterEl);

    const distortG = el("g", { filter: `url(#${distortId})` });
    for (let dq = -3; dq <= 3; dq++) {
      for (let dr = -3; dr <= 3; dr++) {
        const hd = Math.max(Math.abs(dq), Math.abs(dr), Math.abs(dq + dr));
        if (hd > 3) continue;
        const tq = entry.q + dq, tr = entry.r + dr;
        if (!inBoard(tq, tr, state.radius)) continue;
        const cs = cellByKey[`${tq},${tr}`];
        if (!cs || !cs.cell) continue;
        distortG.appendChild(cs.cell);
      }
    }
    gridLayer.appendChild(distortG);

    // Animate displacement scale 18 → 0 (quadratic ease-out).
    const rippleStart = performance.now();
    (function animateRipple() {
      if (!disp.isConnected) return;
      const t = Math.min(1, (performance.now() - rippleStart) / 1400);
      disp.setAttribute("scale", (18 * (1 - t) * (1 - t)).toFixed(1));
      if (t < 1) requestAnimationFrame(animateRipple);
    })();
  }

  if (perspective === "attacker" || perspective === "endgame") {
    // === ATTACKER / EOG ===
    // Group by world-cell — the visual of each cell is a function of its full
    // history (§9.2): primary marker = most recent event with age treatment;
    // older events stack as small badges in the top-right corner. EoG uses
    // the same rendering path so the probe history is identical to what the
    // attacker has been seeing all game.
    const byCell = new Map();
    sim.hitLog.forEach((entry, idx) => {
      const key = `${entry.q},${entry.r}`;
      if (!byCell.has(key)) byCell.set(key, []);
      byCell.get(key).push({ ...entry, _idx: idx });
    });

    byCell.forEach((entries, key) => {
      entries.sort((a, b) => a.tick - b.tick);
      const primary = entries[entries.length - 1];
      const older = entries.slice(0, -1);
      const slot = cellByKey[key];
      if (!slot) return;

      const age = sim.tick - primary.tick;
      const isFreshPrimary = freshIndices.has(primary._idx);
      const mr = hexR * 0.25;
      const cellG = el("g", { transform: `translate(${slot.px},${slot.py})` });

      if (primary.result === 'HIT') {
        const t = attackerHitAgeTreatment(age);
        // §6c: if assigned to a silhouette, tint the X stroke and label with
        // that silhouette's color. Age-treatment opacity/weight still apply.
        const sidx = primary.attackerAssignedSilhouette;
        const xColor = (sidx != null && SILHOUETTE_COLORS[sidx]) || t.x;
        if (t.scorch > 0) {
          cellG.appendChild(el("circle", { cx: 0, cy: 0, r: mr * 2.0, fill: `rgba(80,20,10,${(0.12 * t.scorch).toFixed(3)})`, stroke: "none" }));
          cellG.appendChild(el("circle", { cx: 0, cy: 0, r: mr * 1.2, fill: `rgba(160,48,32,${(0.18 * t.scorch).toFixed(3)})`, stroke: "none" }));
        }
        cellG.appendChild(el("line", { x1: -mr, y1: -mr, x2: mr, y2: mr, stroke: xColor, "stroke-width": t.xW, "stroke-linecap": "round", opacity: t.xOp }));
        cellG.appendChild(el("line", { x1: mr, y1: -mr, x2: -mr, y2: mr, stroke: xColor, "stroke-width": t.xW, "stroke-linecap": "round", opacity: t.xOp }));
        const fontSize = Math.max(7, hexR * 0.22 * t.lblSize);
        const tl = el("text", { x: mr + 3, y: mr + fontSize + 1, "font-family": "'DM Mono', monospace", "font-size": fontSize, fill: xColor, "font-weight": String(t.lblW), opacity: t.lblOp });
        tl.textContent = `T${primary.tick}`;
        cellG.appendChild(tl);
      } else {
        const t = attackerMissAgeTreatment(age);
        cellG.appendChild(el("circle", { cx: 0, cy: 0, r: mr * 0.6, fill: `rgba(80,70,50,${t.fillA})`, stroke: `rgba(80,70,50,${t.strokeA})`, "stroke-width": 0.5 }));
        const fontSize = Math.max(6, hexR * 0.18 * t.lblSize);
        const tl = el("text", { x: mr, y: -mr * 0.5, "font-family": "'DM Mono', monospace", "font-size": fontSize, fill: "#8a7a5a", opacity: t.lblOp });
        tl.textContent = `T${primary.tick}`;
        cellG.appendChild(tl);
      }

      // Stack of older events: top-right corner. Show last 3, "+N" if more.
      // Color codes the result (red = HIT, grey = MISS).
      if (older.length > 0) {
        const stackG = el("g", { transform: `translate(${hexR * 0.6},${-hexR * 0.55})` });
        const stackFont = Math.max(5, hexR * 0.14);
        const maxShow = 3;
        const show = older.slice(-maxShow);
        const more = older.length - show.length;
        show.forEach((e, i) => {
          const sidx = e.attackerAssignedSilhouette;
          const color = e.result === 'HIT'
            ? (sidx != null ? SILHOUETTE_COLORS[sidx] : "#a03020")
            : "#8a7a5a";
          const tl = el("text", { x: 0, y: i * (stackFont + 1), "font-family": "'DM Mono', monospace", "font-size": stackFont, fill: color, opacity: 0.7, "text-anchor": "end" });
          tl.textContent = `T${e.tick}`;
          stackG.appendChild(tl);
        });
        if (more > 0) {
          const tl = el("text", { x: 0, y: show.length * (stackFont + 1), "font-family": "'DM Mono', monospace", "font-size": stackFont, fill: "#6a5a3a", opacity: 0.6, "text-anchor": "end" });
          tl.textContent = `+${more}`;
          stackG.appendChild(tl);
        }
        cellG.appendChild(stackG);
      }

      markerLayer.appendChild(cellG);

      // Fresh animation only for the latest event (only one event can be fresh per tick).
      if (isFreshPrimary) {
        if (primary.result === 'HIT') renderFreshHitBurst(primary);
        else renderFreshMissSplash(cellG, slot, primary);
      }
    });
  } else {
    // === DEFENDER ===
    // HITs grouped by ship → placed on body cells 0..N-1 (stern→bow).
    const hitsByShip = new Map();
    const missEntries = [];
    sim.hitLog.forEach((entry, entryIdx) => {
      if (entry.result === 'MISS') { missEntries.push({ ...entry, _idx: entryIdx }); return; }
      const key = entry.shipId || `unknown`;
      if (!hitsByShip.has(key)) hitsByShip.set(key, []);
      hitsByShip.get(key).push({ ...entry, _idx: entryIdx });
    });

    hitsByShip.forEach((entries, shipId) => {
      const ship = fleet.find(s => s.id === shipId);
      const cells = ship ? shipCells(ship) : null;
      entries.forEach((entry, hitIndex) => {
        let px, py;
        if (cells && hitIndex < cells.length) {
          const cell = cells[hitIndex];
          const slot = cellByKey[`${cell.q},${cell.r}`];
          if (slot) { px = slot.px; py = slot.py; }
        }
        if (px === undefined) {
          const slot = cellByKey[`${entry.q},${entry.r}`];
          if (!slot) return;
          px = slot.px; py = slot.py;
        }
        const mr = hexR * 0.25;
        const isFresh = freshIndices.has(entry._idx);
        const hitG = el("g", { transform: `translate(${px},${py})` });
        hitG.appendChild(el("circle", { cx: 0, cy: 0, r: mr * 2.0, fill: "rgba(80,20,10,0.12)", stroke: "none" }));
        hitG.appendChild(el("circle", { cx: 0, cy: 0, r: mr * 1.2, fill: "rgba(160,48,32,0.18)", stroke: "none" }));
        hitG.appendChild(el("line", { x1: -mr, y1: -mr, x2: mr, y2: mr, stroke: "#c03020", "stroke-width": 2.2, "stroke-linecap": "round" }));
        hitG.appendChild(el("line", { x1: mr, y1: -mr, x2: -mr, y2: mr, stroke: "#c03020", "stroke-width": 2.2, "stroke-linecap": "round" }));
        const fontSize = Math.max(7, hexR * 0.22);
        const tl = el("text", { x: mr + 3, y: mr + fontSize + 1, "font-family": "'DM Mono', monospace", "font-size": fontSize, fill: "#a03020", "font-weight": "600" });
        tl.textContent = `T${entry.tick}`;
        hitG.appendChild(tl);
        markerLayer.appendChild(hitG);
        if (isFresh) renderFreshHitBurst(entry);
      });
    });

    missEntries.forEach(entry => {
      const mr = hexR * 0.25;
      const slot = cellByKey[`${entry.q},${entry.r}`];
      if (!slot) return;
      const isFreshMiss = freshIndices.has(entry._idx);
      const missG = el("g", { transform: `translate(${slot.px},${slot.py})` });
      missG.appendChild(el("circle", { cx: 0, cy: 0, r: mr * 0.6, fill: "rgba(80,70,50,0.35)", stroke: "rgba(80,70,50,0.5)", "stroke-width": 0.5 }));
      const tl = el("text", { x: mr, y: -mr * 0.5, "font-family": "'DM Mono', monospace", "font-size": Math.max(6, hexR * 0.18), fill: "#8a7a5a", opacity: 0.6 });
      tl.textContent = `T${entry.tick}`;
      missG.appendChild(tl);
      if (isFreshMiss) renderFreshMissSplash(missG, slot, entry);
      markerLayer.appendChild(missG);
    });
  }

  // Mark every entry up to and including the latest as animated; subsequent
  // renderBoard calls in the same tick see an empty freshIndices set.
  // Mini never animates, so it never bumps — that's the main board's job.
  if (!mini && sim.hitLog.length - 1 > sim.lastAnimatedEntryIdx) {
    sim.lastAnimatedEntryIdx = sim.hitLog.length - 1;
  }

  // ---- LAYER: aim reticle + spread preview (attacker, when aim locked) ---
  // Stage 3 quirk: setAim / setHoverDestination / clearAim DON'T call renderBoard
  // — they directly manipulate these two layers (see updateAimLayer / updatePreviewLayer
  // below). That preserves in-flight fresh-hit animations across aim/hover changes.
  // The cache (board cellByKey + hexR + svg root) lives at module scope so the
  // surgical updaters can re-use what this render just computed.
  // Mini-board skips: no aim, no preview, no cache mutation (cache belongs to
  // the main board so the surgical updaters keep targeting it).
  if (!mini) {
    renderCache.svg = svg;
    renderCache.cellByKey = cellByKey;
    renderCache.hexR = hexR;
    updateAimLayer();
    updatePreviewLayer();
  }

  // ---- LAYER: click targets (for probing/aiming) ------------------
  // Defender: opt-in via the Probe toggle (test tool) → click probes immediately.
  // Attacker: always on once sim is running → click LOCKS AIM; firing happens
  //   from the spread picker. Click the same aim cell again to unlock.
  // EoG kills probing entirely. Defender Probe-toggle stays opt-in (was a
  // latent bug: probeMode true + switching to EoG would let clicks fire).
  // Mini-board never gets click targets — clicks on the mini swap perspectives
  // via a different handler bound to the SVG element itself.
  const probingEnabled = !mini
    && state.mode === "running"
    && perspective !== "endgame"
    && (perspective === "attacker" || sim.probeMode);
  if (probingEnabled) {
    const clickLayer = el("g", { id: "layer-click", style: "cursor: crosshair;" });
    svg.appendChild(clickLayer);
    for (let q = -state.radius; q <= state.radius; q++) {
      for (let r = -state.radius; r <= state.radius; r++) {
        if (!inBoard(q, r, state.radius)) continue;
        const slot = cellByKey[`${q},${r}`];
        if (!slot) continue;
        const corners = hexCorners(slot.px, slot.py, hexR).map(c => c.join(",")).join(" ");
        const clickHex = el("polygon", { points: corners, fill: "transparent", stroke: "none", "pointer-events": "all" });
        const cq = q, cr = r;
        clickHex.addEventListener("mouseenter", () => {
          clickHex.setAttribute("fill", "rgba(160,48,32,0.12)");
          clickHex.setAttribute("stroke", "rgba(160,48,32,0.4)");
          clickHex.setAttribute("stroke-width", "1.5");
          // While aim is locked (attacker), update the second-cell preview +
          // teletype on hover. Surgical — no full re-render.
          if (state.perspective === "attacker"
            && attacker.aim
            && attacker.assignmentMode === null) {
            setHoverDestination(cq, cr);
          }
        });
        clickHex.addEventListener("mouseleave", () => {
          clickHex.setAttribute("fill", "transparent");
          clickHex.setAttribute("stroke", "none");
          // Only clear if WE were the hovered destination (covers fast hops).
          if (attacker.hoverDestination
            && attacker.hoverDestination.q === cq
            && attacker.hoverDestination.r === cr) {
            setHoverDestination(null, null);
          }
        });
        clickHex.addEventListener("click", () => {
          if (state.perspective === "attacker") {
            // Assignment mode (§6c) intercepts the click. If the cell has any
            // HIT entries, toggle their tag to the active silhouette. If it
            // doesn't (empty cell or only misses), the click exits assignment
            // mode entirely.
            if (attacker.assignmentMode !== null) {
              const hasHit = sim.hitLog.some(e => e.result === 'HIT' && e.q === cq && e.r === cr);
              if (hasHit) toggleCellAssignment(cq, cr);
              else exitAssignmentMode();
              return;
            }
            // No aim yet → click 1 of 2: set aim.
            if (attacker.aim === null) {
              setAim(cq, cr);
              return;
            }
            // Aim already on this cell → click cancels.
            if (attacker.aim.q === cq && attacker.aim.r === cr) {
              clearAim();
              return;
            }
            // Aim set + different cell → click 2 of 2: fire salvo.
            fireDirectSalvo(cq, cr);
          } else {
            probeCell(cq, cr);
          }
        });
        clickLayer.appendChild(clickHex);
      }
    }
  }

  // ---- LAYER: compass ---------------------------------------------
  if (state.showCompass && !mini) {
    const compass = el("g", { transform: `translate(40, ${H-45})`, opacity: 0.55, "pointer-events": "none" });
    compass.innerHTML = `
      <circle r="22" fill="none" stroke="#3a2e1c" stroke-width="0.6"/>
      <circle r="16" fill="none" stroke="#3a2e1c" stroke-width="0.4"/>
      <path d="M0,-22 L3,0 L0,22 L-3,0 Z" fill="#3a2e1c" opacity="0.6"/>
      <path d="M-22,0 L0,3 L22,0 L0,-3 Z" fill="#3a2e1c" opacity="0.6"/>
      <text y="-26" text-anchor="middle" font-size="8" fill="#3a2e1c" font-family="Georgia">N</text>
    `;
    svg.appendChild(compass);
  }

  // Whenever the main board re-renders, the mini-board re-renders too with
  // the opposite perspective. Hidden in EoG (CSS-driven).
  if (!mini) renderMiniBoard();
}

/* Mini-board (PIP). Renders the OPPOSITE perspective of state.perspective.
 * No interaction layers, no animations, no smoke — purely observational.
 * Hidden in EoG via CSS; we still render so swapping back from EoG is fresh. */
function renderMiniBoard() {
  const miniSvg = document.getElementById("miniboard");
  if (!miniSvg) return;
  // Mini shows the opposite of whatever the main is showing — including
  // during peek, so the mini "swaps" along with the main flip.
  const main = state.peekingPerspective || state.perspective;
  const opposite = main === "defender" ? "attacker" : "defender";
  const labelEl = document.getElementById("miniboard-label");
  if (labelEl) labelEl.textContent = opposite;
  renderBoard({ svg: miniSvg, perspective: opposite, mini: true });
}

/* =====================================================================
   6. SIDEBAR  (defender · state -> DOM, event wiring)
   The attacker sidebar is just a Probe Log today (see updateProbeLog).
   ===================================================================== */

function buildFleetList() {
  const root = document.getElementById("fleetList");
  root.innerHTML = "";
  fleet.forEach(ship => {
    const card = document.createElement("div");
    const isActive = ship.id === activeShipId;
    card.className = "ship-card" + (isActive ? " active" : "") + (ship.sunk ? " sunk" : "");
    card.dataset.id = ship.id;
    const dir = hexDirs()[ship.head];

    // Build HP pips
    let hpPips = '';
    for (let i = 0; i < ship.size; i++) {
      hpPips += `<div class="hp-pip ${i < ship.hp ? 'full' : 'lost'}"></div>`;
    }

    // Cooldown display
    let cdDisplay = '';
    if (ship.sunk) {
      cdDisplay = `<span class="sunk-label">${ICO_SKULL_HTML} SUNK</span>`;
    } else if (ship.hitsTaken > 0) {
      cdDisplay = `cd <span class="cd-change">${ship.baseCooldown}→${ship.cooldown}</span> · ${ship.hp}/${ship.size} HP`;
    } else {
      cdDisplay = `cd ${ship.cooldown} · ${ship.hp}/${ship.size} HP`;
    }

    // Ship hits from log
    const shipHits = sim.hitLog.filter(e => e.shipId === ship.id);
    const hitInfo = shipHits.length > 0 ? ` · ${shipHits.length} hit${shipHits.length > 1 ? 's' : ''}` : '';

    card.innerHTML = `
      <div class="ship-head">
        <b>${ship.id}</b>
        <span class="badge">size ${ship.size} · ${dir.name}${hitInfo}</span>
      </div>
      <div class="hp-pips">${hpPips}</div>
      <div class="ship-status">${cdDisplay}</div>
      <div class="ship-controls">
        <div class="row">
          <label>Size</label>
          <input type="range" min="1" max="5" value="${ship.size}" data-prop="size"/>
          <span class="val">${ship.size}</span>
        </div>
        <div class="row">
          <label>q</label>
          <input type="range" min="-${state.radius}" max="${state.radius}" value="${ship.q}" data-prop="q"/>
          <span class="val">${ship.q}</span>
        </div>
        <div class="row">
          <label>r</label>
          <input type="range" min="-${state.radius}" max="${state.radius}" value="${ship.r}" data-prop="r"/>
          <span class="val">${ship.r}</span>
        </div>
        <div class="row" style="margin-top:6px;">
          <label>Heading</label>
        </div>
        <div class="heading-grid">
          ${hexDirs().map((d, i) =>
            `<button data-head="${i}" class="${i===ship.head?'active':''}">${d.name}</button>`
          ).join("")}
        </div>
      </div>
    `;
    card.addEventListener("click", (e) => {
      if (e.target.closest(".ship-controls")) return;
      activeShipId = ship.id;
      buildFleetList();
      renderBoard();
    });
    // Disable editing in running mode
    if (state.mode === "running") {
      card.querySelectorAll('input[type="range"]').forEach(inp => inp.disabled = true);
      card.querySelectorAll('.heading-grid button').forEach(btn => btn.disabled = true);
    } else {
      card.querySelectorAll('input[type="range"]').forEach(inp => {
        inp.addEventListener("input", () => {
          const prop = inp.dataset.prop;
          const val = parseInt(inp.value, 10);
          ship[prop] = val;
          if (prop === 'size') {
            ship.hp = val;
            ship.baseCooldown = Math.max(1, val - 1);
            ship.cooldown = ship.baseCooldown + ship.hitsTaken;
          }
          inp.parentElement.querySelector(".val").textContent = ship[prop];
          card.querySelector(".badge").textContent = `size ${ship.size} · ${hexDirs()[ship.head].name}`;
          renderBoard();
        });
      });
      card.querySelectorAll('.heading-grid button').forEach(btn => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          ship.head = parseInt(btn.dataset.head, 10);
          buildFleetList();
          renderBoard();
        });
      });
    }
    root.appendChild(card);
  });
}

/* =====================================================================
   7. WIRE-UP
   ===================================================================== */

/* ---- PERSPECTIVE SWITCH ---- */
const PERSPECTIVE_META = {
  defender: "Defender — full truth (ships, placement, sim)",
  attacker: "Attacker — only sees probe history (hits + misses)",
  endgame: "End of Game — review mode; no firing, no aiming, no assigning",
};
const PERSPECTIVE_LABEL = {
  defender: "Defender",
  attacker: "Attacker",
  endgame: "End of Game",
};

function setPerspective(p) {
  if (p !== "defender" && p !== "attacker" && p !== "endgame") return;
  state.perspective = p;
  document.body.setAttribute("data-perspective", p);
  document.querySelectorAll("#perspectiveSeg button").forEach(b => {
    b.classList.toggle("active", b.dataset.p === p);
  });
  document.getElementById("perspectiveMeta").textContent = PERSPECTIVE_META[p];
  document.getElementById("perspectiveLabelText").textContent = PERSPECTIVE_LABEL[p];
  // Defender's Probe-toggle test tool doesn't belong on the attacker or EoG
  // side; clear it on the way out so we don't carry stale state.
  if (p !== "defender" && sim.probeMode) {
    sim.probeMode = false;
    document.getElementById("probeToggle").classList.remove("active");
  }
  // Switching away from attacker clears any in-flight aim / assignment.
  if (p !== "attacker") {
    attacker.aim = null;
    attacker.hoverDestination = null;
    attacker.assignmentMode = null;
  }
  refreshAttackerOverlay();
  // Attacker has no concept of placement — switching in while still in
  // placement kicks the sim into Running. EoG does the same: review needs
  // a started sim. Switch back to Defender → Placement to re-place.
  if ((p === "attacker" || p === "endgame") && state.mode === "placement") {
    enterRunningMode();
    return; // enterRunningMode already re-renders
  }
  buildEnemyFleetSilhouettes();
  buildContactsList();
  buildEndgamePanels();
  renderBoard();
}

document.querySelectorAll("#perspectiveSeg button").forEach(btn => {
  btn.addEventListener("click", () => setPerspective(btn.dataset.p));
});

// Mini-board (PIP) click → swap to whichever perspective the mini is showing.
// EoG mini is hidden via CSS so this handler never fires there.
const miniboardWrap = document.getElementById("miniboard-wrap");
if (miniboardWrap) {
  miniboardWrap.addEventListener("click", () => {
    const opposite = state.perspective === "defender" ? "attacker" : "defender";
    setPerspective(opposite);
  });
}

/* ---- ENDGAME SUB-VIEW (FROM ATTACKER / FROM DEFENDER) ---- */
const ENDGAME_VIEW_META = {
  attacker: "From attacker — probes prominent, ship truth dimmed",
  defender: "From defender — ship truth prominent, probes dimmed",
};

function setEndgameView(v) {
  if (v !== "attacker" && v !== "defender") return;
  state.endgameView = v;
  document.body.setAttribute("data-endgame-view", v);
  document.querySelectorAll("#endgameViewSeg button").forEach(b => {
    b.classList.toggle("active", b.dataset.v === v);
  });
  const m = document.getElementById("endgameViewMeta");
  if (m) m.textContent = ENDGAME_VIEW_META[v];
  buildEndgamePanels();
  renderBoard();
}

document.querySelectorAll("#endgameViewSeg button").forEach(btn => {
  btn.addEventListener("click", () => setEndgameView(btn.dataset.v));
});

/* ---- ATTACKER FIRING UX ---- */
// CSS shows/hides the teletype line via body[data-aim="locked"]. The teletype
// text is the entire UI — no separate picker. Click 1 sets the aim, hovering
// a second cell shows the salvo preview and the FIRE prompt, click 2 fires.
function refreshAttackerOverlay() {
  const aimLocked = state.perspective === "attacker" && !!attacker.aim;
  document.body.setAttribute("data-aim", aimLocked ? "locked" : "free");
  const line = document.getElementById("teletypeLine");
  if (!line) return;
  if (!aimLocked) { line.innerHTML = ""; return; }
  const tgt = `(${attacker.aim.q},${attacker.aim.r})`;
  if (attacker.hoverDestination) {
    const dst = `(${attacker.hoverDestination.q},${attacker.hoverDestination.r})`;
    const d = hexDistance(attacker.aim.q, attacker.aim.r, attacker.hoverDestination.q, attacker.hoverDestination.r);
    line.innerHTML = `&gt; TGT ${tgt} + ${dst} · ${salvoLabelByDistance(d)} · FIRE FOR EFFECT<span class="cur">_</span>`;
  } else {
    line.innerHTML = `&gt; TGT ${tgt} · SELECT SECOND CELL<span class="cur">_</span>`;
  }
}

document.addEventListener("keydown", e => {
  if (e.key === "Escape") {
    exitAssignmentMode();
    clearAim();
    return;
  }
  // Peek-by-hold (C). Backtick. Suppressed in EoG (which already shows truth).
  // Only fires on the first keydown — auto-repeat ignored.
  if (e.key === "`" && !e.repeat
      && !state.peekingPerspective
      && state.perspective !== "endgame") {
    state.peekingPerspective = state.perspective === "defender" ? "attacker" : "defender";
    document.body.setAttribute("data-perspective", state.peekingPerspective);
    refreshAttackerOverlay();
    renderBoard();
    e.preventDefault();
  }
});
document.addEventListener("keyup", e => {
  if (e.key === "`" && state.peekingPerspective) {
    state.peekingPerspective = null;
    document.body.setAttribute("data-perspective", state.perspective);
    refreshAttackerOverlay();
    renderBoard();
    e.preventDefault();
  }
});

const RENDER_LABELS = {
  A: "A — dark ink silhouette (same anatomy as B)",
  B: "B — gradient hull + deck features (default)",
  E: "E — outlines only (same anatomy as B)",
  F: "F — NATO command counter (own geometry)",
};

document.querySelectorAll("#renderSeg button").forEach(btn => {
  btn.addEventListener("click", () => {
    document.querySelectorAll("#renderSeg button").forEach(b => b.classList.remove("active"));
    btn.classList.add("active");
    state.render = btn.dataset.r;
    document.getElementById("renderMeta").textContent = RENDER_LABELS[state.render];
    renderBoard();
  });
});

document.getElementById("orient").addEventListener("change", e => { state.orient = e.target.value; buildFleetList(); renderBoard(); });
document.getElementById("radius").addEventListener("input", e => {
  state.radius = parseInt(e.target.value, 10);
  document.getElementById("radiusVal").textContent = state.radius;
  // re-clamp ship positions so they don't go nuts
  fleet.forEach(s => { s.q = Math.max(-state.radius, Math.min(state.radius, s.q)); s.r = Math.max(-state.radius, Math.min(state.radius, s.r)); });
  buildFleetList(); renderBoard();
});
["showHighlight","showLabels","showCoords","showCompass"].forEach(id => {
  document.getElementById(id).addEventListener("change", e => { state[id] = e.target.checked; renderBoard(); });
});
// Hit aura — visibility is CSS-driven via body[data-hit-aura] so no re-render needed.
document.getElementById("showHitAura").addEventListener("change", e => {
  state.showHitAura = e.target.checked;
  document.body.setAttribute("data-hit-aura", e.target.checked ? "on" : "off");
});
// Contact tracks — visibility CSS-driven, but turning ON needs a compute since
// we don't maintain attacker.contacts while the toggle is off.
document.getElementById("showContactTracks").addEventListener("change", e => {
  state.showContactTracks = e.target.checked;
  document.body.setAttribute("data-contact-tracks", e.target.checked ? "on" : "off");
  if (e.target.checked) attacker.contacts = computeContactTracks();
  else attacker.contacts = [];
  buildContactsList();
  buildEndgamePanels();
  renderBoard();
});

// ---- Mode & simulation controls ----
document.getElementById("modePlacement").addEventListener("click", enterPlacementMode);
document.getElementById("modeRunning").addEventListener("click", enterRunningMode);
document.getElementById("stepFwd").addEventListener("click", () => { stepForward(); updateSpeedChart(); });
document.getElementById("stepBack").addEventListener("click", () => { stepBack(); updateSpeedChart(); });
document.getElementById("resetTick").addEventListener("click", () => { resetSim(); updateSpeedChart(); });
document.getElementById("probeToggle").addEventListener("click", () => {
  sim.probeMode = !sim.probeMode;
  document.getElementById("probeToggle").classList.toggle("active", sim.probeMode);
  renderBoard();
});

window.addEventListener("resize", renderBoard);

// Collapsible sidebar sections
document.querySelectorAll('#sidebar h2').forEach(h2 => {
  const chev = document.createElement('span');
  chev.className = 'chev';
  chev.textContent = '▾';
  h2.appendChild(chev);
  h2.addEventListener('click', () => {
    h2.classList.toggle('collapsed');
    const section = h2.nextElementSibling;
    if (section && section.classList.contains('sidebar-section')) {
      section.classList.toggle('collapsed');
    }
  });
});

/* =====================================================================
   8. SMOKE PARTICLE SYSTEM  (defender · independent rAF loop, overlay SVG)
   Reads ship truth (which body cells are damaged) — hidden in attacker view.
   ===================================================================== */
const smoke = {
  svg: null,
  group: null,
  pool: [],
  POOL_SIZE: 250,
  lastTime: 0,

  init() {
    this.svg = document.createElementNS(SVG_NS, "svg");
    this.svg.setAttribute("xmlns", SVG_NS);
    this.svg.style.cssText = "position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:5;";
    document.getElementById("board-wrap").appendChild(this.svg);

    const defs = el("defs");
    defs.innerHTML = `<filter id="smokeBlur" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="4"/></filter>`;
    this.svg.appendChild(defs);

    this.group = el("g", { filter: "url(#smokeBlur)", opacity: "0.85" });
    this.svg.appendChild(this.group);

    for (let i = 0; i < this.POOL_SIZE; i++) {
      const c = el("circle", { cx: -9999, cy: -9999, r: 0, fill: "#888", opacity: "0" });
      this.group.appendChild(c);
      this.pool.push({ el: c, active: false, x:0, y:0, vx:0, vy:0, r:0, dr:0, opacity:0, fade:0, grey:140, life:0 });
    }

    requestAnimationFrame(t => this.tick(t));
  },

  syncViewBox() {
    const board = document.getElementById("board");
    const vb = board.getAttribute("viewBox");
    if (vb && this.svg.getAttribute("viewBox") !== vb) this.svg.setAttribute("viewBox", vb);
  },

  /** Returns [{x, y, hitCount}] for each damaged body-cell on a living ship */
  getSources() {
    // Smoke rises from a ship's damaged body cells — that's ship truth and
    // would betray ship position to the attacker. Hide entirely in attacker view.
    if (state.perspective !== "defender") return [];

    const wrap = document.getElementById("board-wrap");
    const W = wrap.clientWidth, H = wrap.clientHeight;
    const hr = computeHexR(W, H, state.radius);
    const cx = W / 2, cy = H / 2;
    this._hr = hr; this._cx = cx; this._cy = cy;

    const out = [];
    fleet.forEach(ship => {
      if (ship.sunk) return;
      const hits = sim.hitLog.filter(e => e.shipId === ship.id && e.result === 'HIT');
      if (!hits.length) return;

      const byBody = {};
      hits.forEach(e => { const bi = e.bodyIndex ?? 0; byBody[bi] = (byBody[bi] || 0) + 1; });

      const cells = shipCells(ship);
      Object.entries(byBody).forEach(([bi, n]) => {
        const c = cells[parseInt(bi)];
        if (!c || !inBoard(c.q, c.r, state.radius)) return;
        const p = axialToPx(c.q, c.r, hr);
        out.push({ x: cx + p.x, y: cy + p.y, hitCount: n });
      });
    });
    return out;
  },

  spawn(src) {
    const p = this.pool.find(p => !p.active);
    if (!p) return;
    const hr = this._hr || 25;
    const spread = hr * 0.6;

    p.active = true;
    p.x  = src.x + (Math.random() - 0.5) * spread;
    p.y  = src.y + (Math.random() - 0.5) * spread * 0.5;
    p.vx = (Math.random() - 0.5) * 12;
    p.vy = -(8 + Math.random() * 22);                       // strong upward
    p.r  = hr * (0.12 + Math.random() * 0.20);              // start medium
    p.dr = hr * (0.06 + Math.random() * 0.10);              // grow per sec
    const maxLife = 2.0 + Math.random() * 2.5;
    p.life = maxLife;
    p.opacity = 0.20 + Math.random() * 0.20 + src.hitCount * 0.07;
    p.fade = p.opacity / maxLife;
    p.grey = Math.max(25, 200 - src.hitCount * 55 + Math.floor((Math.random() - 0.5) * 50));
  },

  tick(ts) {
    const dt = this.lastTime ? Math.min((ts - this.lastTime) / 1000, 0.08) : 0.016;
    this.lastTime = ts;

    this.syncViewBox();
    const sources = this.getSources();

    // Spawn — rate scales with hitCount
    sources.forEach(src => {
      const rate = 5 + src.hitCount * 6;          // particles/sec per source
      const count = Math.floor(rate * dt + (Math.random() < (rate * dt % 1) ? 1 : 0));
      for (let i = 0; i < count; i++) this.spawn(src);
    });

    // Update
    for (const p of this.pool) {
      if (!p.active) continue;
      p.life -= dt;
      if (p.life <= 0) { p.active = false; p.el.setAttribute("opacity", "0"); continue; }

      p.x  += p.vx * dt;
      p.y  += p.vy * dt;
      p.r  += p.dr * dt;
      p.vx *= (1 - 1.8 * dt);   // drag
      p.vy *= (1 - 0.6 * dt);   // lighter vertical drag so it keeps drifting up
      p.opacity -= p.fade * dt;
      if (p.opacity < 0) p.opacity = 0;

      p.el.setAttribute("cx", p.x.toFixed(1));
      p.el.setAttribute("cy", p.y.toFixed(1));
      p.el.setAttribute("r",  p.r.toFixed(1));
      p.el.setAttribute("fill", `rgb(${p.grey},${p.grey},${p.grey})`);
      p.el.setAttribute("opacity", p.opacity.toFixed(3));
    }

    requestAnimationFrame(t => this.tick(t));
  },
};

document.body.setAttribute("data-perspective", state.perspective);
document.body.setAttribute("data-aim", "free");
document.body.setAttribute("data-hit-aura", state.showHitAura ? "on" : "off");
document.body.setAttribute("data-contact-tracks", state.showContactTracks ? "on" : "off");
document.body.setAttribute("data-endgame-view", state.endgameView);
smoke.init();

buildFleetList();
buildEnemyFleetSilhouettes();
buildContactsList();
setTimeout(renderBoard, 50);
</script>
