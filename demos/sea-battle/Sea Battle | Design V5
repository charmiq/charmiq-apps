  state.mode = "placement";
  sim.tick = 0;
  sim.history = [];
  sim.hitLog = [];
  sim.lastAnimatedEntryIdx = -1;
  sim.probeMode = false;
  sim.initialPositions = null;
  attacker.aim = null;
  attacker.hoverDestination = null;
