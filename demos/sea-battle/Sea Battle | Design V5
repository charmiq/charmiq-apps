<script>
/* =====================================================================
   FILE STRUCTURE
   ---------------------------------------------------------------------
   1–5  SHARED        data model · geometry · ship features · renderers · board
   6    DEFENDER UI   sidebar (fleet list, render mode, board controls)
   7    WIRE-UP       perspective switch + event handlers
   8    DEFENDER FX   smoke particle system (hidden in attacker view)
   ===================================================================== */

/* =====================================================================
   1. DATA MODEL  (shared · no rendering knowledge)
   ===================================================================== */

const ICO_SKULL_HTML = `<svg class="ico ico-sm" viewBox="0 0 448 512"><path fill="currentColor" d="M368 128c0 44.4-25.4 83.5-64 106.4l0 21.6c0 17.7-14.3 32-32 32l-96 0c-17.7 0-32-14.3-32-32l0-21.6c-38.6-23-64-62.1-64-106.4C80 57.3 144.5 0 224 0s144 57.3 144 128zM168 176a32 32 0 1 0 0-64 32 32 0 1 0 0 64zm144-32a32 32 0 1 0-64 0 32 32 0 1 0 64 0zM3.4 273.7c7.9-15.8 27.1-22.2 42.9-14.3L224 348.2l177.7-88.8c15.8-7.9 35-1.5 42.9 14.3s1.5 35-14.3 42.9L295.6 384l134.8 67.4c15.8 7.9 22.2 27.1 14.3 42.9s-27.1 22.2-42.9 14.3L224 419.8 46.3 508.6c-15.8 7.9-35 1.5-42.9-14.3s-1.5-35 14.3-42.9L152.4 384 17.7 316.6C1.9 308.7-4.5 289.5 3.4 273.7z"/></svg>`;
const ICO_SKULL_SVG_PATH = "M368 128c0 44.4-25.4 83.5-64 106.4l0 21.6c0 17.7-14.3 32-32 32l-96 0c-17.7 0-32-14.3-32-32l0-21.6c-38.6-23-64-62.1-64-106.4C80 57.3 144.5 0 224 0s144 57.3 144 128zM168 176a32 32 0 1 0 0-64 32 32 0 1 0 0 64zm144-32a32 32 0 1 0-64 0 32 32 0 1 0 64 0zM3.4 273.7c7.9-15.8 27.1-22.2 42.9-14.3L224 348.2l177.7-88.8c15.8-7.9 35-1.5 42.9 14.3s1.5 35-14.3 42.9L295.6 384l134.8 67.4c15.8 7.9 22.2 27.1 14.3 42.9s-27.1 22.2-42.9 14.3L224 419.8 46.3 508.6c-15.8 7.9-35 1.5-42.9-14.3s-1.5-35 14.3-42.9L152.4 384 17.7 316.6C1.9 308.7-4.5 289.5 3.4 273.7z";

const HEX_DIRS_POINTY = [
  { name: "E",  dq:+1, dr: 0, angle:   0 },
  { name: "SE", dq: 0, dr:+1, angle:  60 },
  { name: "SW", dq:-1, dr:+1, angle: 120 },
  { name: "W",  dq:-1, dr: 0, angle: 180 },
  { name: "NW", dq: 0, dr:-1, angle: 240 },
  { name: "NE", dq:+1, dr:-1, angle: 300 },
];
const HEX_DIRS_FLAT = [
  { name: "NE", dq:+1, dr:-1, angle: -30 },
  { name: "SE", dq:+1, dr: 0, angle:  30 },
  { name: "S",  dq: 0, dr:+1, angle:  90 },
  { name: "SW", dq:-1, dr:+1, angle: 150 },
  { name: "NW", dq:-1, dr: 0, angle: 210 },
  { name: "N",  dq: 0, dr:-1, angle: 270 },
];

function makeShip(id, size, q, r, head) {
  const baseCooldown = Math.max(1, size - 1);
  return { id, size, hp: size, baseCooldown, cooldown: baseCooldown, hitsTaken: 0, sunk: false, q, r, head };
}

const fleet = [
  makeShip("BB-01", 5, -3, -2, 0),
  makeShip("CA-02", 4,  1, -3, 1),
  makeShip("DD-03", 3,  3,  1, 2),
  makeShip("DD-04", 3, -4,  2, 5),
  makeShip("PT-05", 2,  0,  3, 0),
];

let activeShipId = fleet[0].id;

const state = {
  perspective: "defender",    // "defender" | "attacker" | "endgame" — top-level UI mode
  peekingPerspective: null,   // null | "defender" | "attacker" — temporary peek override (C, design-mini-views.md)
  endgameView: "attacker",    // "attacker" | "defender" — emphasis sub-view inside EoG
  render: "B",
  orient: "flat",             // "pointy" | "flat"
  radius: 7,
  showHighlight: true,
  showLabels: true,
  showCoords: false,
  showCompass: true,
  mode: "placement",          // "placement" | "running" — defender sub-mode
  showHitAura: true,          // attacker inference aid (§7.3) — uncertainty rings
  showContactTracks: true,    // attacker inference aid (§7.4) — auto-correlated contact tracks
};

/* ---- ATTACKER FIRING STATE ---- */
// Transient interaction state for the attacker's aim → pick-pattern → fire flow.
// Separate from `sim` (which is the sim's persistent state) and `state` (UI config).
const attacker = {
  aim: null,                // { q, r } | null — locked aim cell after first click
  hoverDestination: null,   // { q, r } | null — second-cell hover preview (board)
  declaredSunk: new Set(),  // silhouette indices the player has manually declared sunk
  contacts: [],             // contact tracks from auto-correlation (§7.4)
  assignmentMode: null,     // silhouette idx in active assignment mode (§6c), or null
};

// Enemy fleet silhouettes for the attacker (§7.5). Sizes only — no class names
// per R18. Indices 0..4 map to the slot in the panel, not to actual ship ids.
const ENEMY_SILHOUETTES = [
  { idx: 0, size: 5 },
  { idx: 1, size: 4 },
  { idx: 2, size: 3 },
  { idx: 3, size: 3 },
  { idx: 4, size: 2 },
];
// Distinct, saturated colors per silhouette slot. Used as the tint on X marks
// when a hit is assigned (§6c) and as the highlight color on the silhouette
// card while in assignment mode. Deliberately *no red* — the default hit X is
// red, and a red silhouette color would make "assigned to silhouette 0" and
// "unassigned" visually indistinguishable. Also distinct from TRACK_COLORS.
const SILHOUETTE_COLORS = [
  "#1e6fa8", // BB-5: deep blue
  "#2a9080", // CA-4: teal
  "#3a8030", // DD-3a: forest green
  "#b8701c", // DD-3b: amber
  "#7032a8", // PT-2: purple
];

// Contact-track inference (§7.4). Search space for the trajectory solver.
// Sizes come from the fleet definition (BB 5, CA 4, DD 3/3, PT 2).
// Cooldowns span 1 (PT base) up to 5 (BB after a hit).
const SHIP_SIZES_FOR_INFERENCE = [2, 3, 4, 5];
const POSSIBLE_COOLDOWNS       = [1, 2, 3, 4, 5];
const TRACK_NAMES = ["Alpha","Bravo","Charlie","Delta","Echo","Foxtrot","Golf","Hotel","India","Juliet","Kilo","Lima"];

// Axial hex distance — used to skip drawing track lines across the torus wrap.
function hexDistance(q1, r1, q2, r2) {
  const dq = q1 - q2, dr = r1 - r2;
  return (Math.abs(dq) + Math.abs(dr) + Math.abs(dq + dr)) / 2;
}

/* Inference engine. Given a list of HIT probe entries (each {tick, q, r}),
 * search the hypothesis space (size, heading, cooldown, initial-anchor) for
 * every trajectory that could have placed a ship body cell at every hit cell
 * at every hit tick. Returns the feasible set.
 *
 * Movement model: anchor moves 1 cell in `heading` direction every `cd` ticks,
 * starting from tick 0. Body = anchor + i·dir for i ∈ [0, size-1]. Torus wrap.
 * Straight-line only — no turning, no post-hit cooldown bump. (Both deferred.)
 *
 * Cost per call: |sizes| × |headings| × |cd| × max(size) × |hits| × |bodyJ|.
 *   ≈ 4 × 6 × 5 × 5 × |hits| × 5  ≈  3000 · |hits| ops. Fast.
 */
function inferTrack(hits) {
  if (hits.length === 0) return [];
  const sorted = hits.slice().sort((a, b) => a.tick - b.tick);
  const dirs = hexDirs();
  const results = [];

  for (const size of SHIP_SIZES_FOR_INFERENCE) {
    for (let headingIdx = 0; headingIdx < dirs.length; headingIdx++) {
      const dir = dirs[headingIdx];
      for (const cd of POSSIBLE_COOLDOWNS) {
        // The first hit might be at any body-cell index; iterate.
        for (let firstBodyIdx = 0; firstBodyIdx < size; firstBodyIdx++) {
          const firstHit = sorted[0];
          const movesAtFirst = Math.floor(firstHit.tick / cd);
          // anchor_at_tick_0 = firstHit - (firstBodyIdx + movesAtFirst) · dir
          const anchor0Q = firstHit.q - (firstBodyIdx + movesAtFirst) * dir.dq;
          const anchor0R = firstHit.r - (firstBodyIdx + movesAtFirst) * dir.dr;

          let allFit = true;
          for (const hit of sorted) {
            const movesAtT = Math.floor(hit.tick / cd);
            const anchorTQ = anchor0Q + movesAtT * dir.dq;
            const anchorTR = anchor0R + movesAtT * dir.dr;
            let fitsBody = false;
            for (let j = 0; j < size; j++) {
              const wrapped = wrapHex(anchorTQ + j * dir.dq, anchorTR + j * dir.dr, state.radius);
              if (wrapped.q === hit.q && wrapped.r === hit.r) { fitsBody = true; break; }
            }
            if (!fitsBody) { allFit = false; break; }
          }
          if (allFit) results.push({ size, headingIdx, cd, anchor0Q, anchor0R });
        }
      }
    }
  }
  return results;
}

/* AUTO correlation (§7.4). Greedy single-pass: each new HIT is added to the
 * existing track whose feasibility set survives best after the addition (most
 * constrained = most informative); if no track stays feasible, start a new
 * one. Inference IS the correlation criterion. */
function computeContactTracks() {
  const tracks = [];
  const hits = sim.hitLog
    .filter(e => e.result === 'HIT')
    .slice()
    .sort((a, b) => a.tick - b.tick);

  for (const hit of hits) {
    let bestTrack = null;
    let bestFeasibleCount = Infinity;
    for (const track of tracks) {
      const candidate = [...track.hits, hit];
      const feasible = inferTrack(candidate);
      if (feasible.length > 0 && feasible.length < bestFeasibleCount) {
        bestTrack = track;
        bestFeasibleCount = feasible.length;
      }
    }
    if (bestTrack) {
      bestTrack.hits.push(hit);
      bestTrack.feasible = inferTrack(bestTrack.hits);
    } else {
      tracks.push({
        id: TRACK_NAMES[tracks.length] || `Track${tracks.length}`,
        hits: [hit],
        feasible: inferTrack([hit]),
      });
    }
  }

  // Confidence + summary stats per track.
  for (const t of tracks) {
    if (t.hits.length === 1)                   t.confidence = 'unattributed';
    else if (t.feasible.length === 0)          t.confidence = 'inconsistent';
    else if (t.feasible.length === 1)          t.confidence = 'consistent';
    else                                       t.confidence = 'forced';
    t.possibleHeadings = [...new Set(t.feasible.map(f => f.headingIdx))];
    t.possibleCooldowns = [...new Set(t.feasible.map(f => f.cd))];
    t.possibleSizes     = [...new Set(t.feasible.map(f => f.size))];
  }
  return tracks;
}

// Salvo firing (§7.7 / R17 — 2 cells per turn). NEW UX: no preset patterns.
// Click 1 = aim cell. Click 2 = destination. Both probe-fire as one salvo.
// The teletype line at the bottom of the board carries the textual guidance
// (SELECT SECOND CELL, then "(a) + (b) · LABEL · FIRE FOR EFFECT" on hover).

let nextSalvoId = 1;

// Label a 2-cell salvo by hex distance between the two cells. Keeps the
// "TIGHT" / "WIDE" language from the old preset patterns where it fits.
function salvoLabelByDistance(d) {
  if (d <= 1) return "TIGHT PAIR";
  if (d === 2) return "WIDE SPREAD";
  return `RANGE ${d}`;
}

function setAim(q, r) {
  if (state.peekingPerspective) return;  // peek (C) — observational only
  if (state.perspective !== "attacker" || state.mode !== "running") return;
  // Click the same cell twice → unlock (toggle off).
  if (attacker.aim && attacker.aim.q === q && attacker.aim.r === r) {
    clearAim();
    return;
  }
  attacker.aim = { q, r };
  attacker.hoverDestination = null;
  refreshAttackerOverlay();
  // Surgical — do NOT call renderBoard. Wiping the SVG would kill any
  // in-flight fresh-hit animation from the previous salvo.
  updateAimLayer();
  updatePreviewLayer();
}

function clearAim() {
  if (attacker.aim === null && attacker.hoverDestination === null) return;
  attacker.aim = null;
  attacker.hoverDestination = null;
  refreshAttackerOverlay();
  updateAimLayer();
  updatePreviewLayer();
}

function setHoverDestination(q, r) {
  // Only meaningful when aim is locked.
  if (!attacker.aim) return;
  if (q === null) {
    if (attacker.hoverDestination === null) return;
    attacker.hoverDestination = null;
  } else {
    // Don't preview the aim cell as a destination.
    if (attacker.aim.q === q && attacker.aim.r === r) {
      if (attacker.hoverDestination === null) return;
      attacker.hoverDestination = null;
    } else {
      if (attacker.hoverDestination
        && attacker.hoverDestination.q === q
        && attacker.hoverDestination.r === r) return;
      attacker.hoverDestination = { q, r };
    }
  }
  refreshAttackerOverlay();
  updatePreviewLayer();
}

function fireDirectSalvo(secondQ, secondR) {
  if (state.peekingPerspective) return;          // peek (C) — observational only
  if (state.perspective !== "attacker") return;  // EoG must never fire
  if (!attacker.aim) return;
  const salvoId = nextSalvoId++;
  // Batch: first probe skips its render, so the second probe's renderBoard
  // sees both new entries in freshIndices and animates both bursts at once.
  probeCell(attacker.aim.q, attacker.aim.r, { salvoId, skipRender: true });
  probeCell(secondQ, secondR, { salvoId, skipRender: false });
  clearAim();
}

/* ---- ENEMY FLEET SILHOUETTES (§7.5) + HIT ASSIGNMENT (§6c) ---- */
function toggleDeclaredSunk(idx) {
  if (attacker.declaredSunk.has(idx)) attacker.declaredSunk.delete(idx);
  else attacker.declaredSunk.add(idx);
  buildEnemyFleetSilhouettes();
  buildContactsList();
  buildEndgamePanels();
}

// Counts of HIT entries currently tagged to a given silhouette idx.
function assignedHitCount(silhouetteIdx) {
  return sim.hitLog.filter(e => e.result === 'HIT' && e.attackerAssignedSilhouette === silhouetteIdx).length;
}
// Visually "declared sunk" = manual flag OR fully accounted-for via assignment.
function silhouetteFulfilled(silhouetteIdx) {
  return assignedHitCount(silhouetteIdx) >= ENEMY_SILHOUETTES[silhouetteIdx].size;
}
function silhouetteAppearsSunk(silhouetteIdx) {
  return attacker.declaredSunk.has(silhouetteIdx) || silhouetteFulfilled(silhouetteIdx);
}

// Enter/exit assignment mode for a silhouette. Clicking the same silhouette
// exits; clicking a different one switches. Entering also clears any locked
// aim — aim/fire and assignment are mutually exclusive interaction modes.
function toggleAssignmentMode(silhouetteIdx) {
  if (state.peekingPerspective) return;          // peek (C) — observational only
  if (state.perspective !== "attacker") return;  // EoG: no assignment changes
  const entering = attacker.assignmentMode !== silhouetteIdx;
  attacker.assignmentMode = entering ? silhouetteIdx : null;
  if (entering && attacker.aim) {
    attacker.aim = null;
    attacker.hoverDestination = null;
    refreshAttackerOverlay();
    updateAimLayer();
    updatePreviewLayer();
  }
  buildEnemyFleetSilhouettes();
  renderBoard();
}
function exitAssignmentMode() {
  if (attacker.assignmentMode === null) return;
  attacker.assignmentMode = null;
  buildEnemyFleetSilhouettes();
  renderBoard();
}

// Toggle assignment of all HIT entries at (q,r) to the active silhouette.
// If all entries at the cell are already tagged to that silhouette, this
// un-tags them all. Otherwise, every entry at the cell gets tagged.
function toggleCellAssignment(q, r) {
  if (state.peekingPerspective) return;          // peek (C) — observational only
  if (state.perspective !== "attacker") return;  // EoG: assignment frozen
  if (attacker.assignmentMode === null) return;
  const sidx = attacker.assignmentMode;
  const entries = sim.hitLog.filter(e => e.result === 'HIT' && e.q === q && e.r === r);
  if (entries.length === 0) return;
  const allTagged = entries.every(e => e.attackerAssignedSilhouette === sidx);
  entries.forEach(e => { e.attackerAssignedSilhouette = allTagged ? null : sidx; });
  buildEnemyFleetSilhouettes();
  renderBoard();
}

function buildEnemyFleetSilhouettes() {
  const root = document.getElementById("enemyFleet");
  if (!root) return;
  root.innerHTML = "";

  // Header tally — strictly what the attacker knows. NO "confirmed sunk"
  // (truth leak — they don't get told mid-game). Just their hit count and
  // their own declared count via assignment.
  const declaredCount = ENEMY_SILHOUETTES.filter(s => silhouetteAppearsSunk(s.idx)).length;
  const totalHits = sim.hitLog.filter(e => e.result === 'HIT').length;
  const total = ENEMY_SILHOUETTES.length;
  const tally = document.createElement("div");
  tally.className = "enemy-tally";
  tally.innerHTML = `${totalHits} hit${totalHits === 1 ? '' : 's'}`
    + ` · <span class="tally-declared">${declaredCount} of ${total} declared sunk</span>`;
  root.appendChild(tally);

  // Instruction banner is ALWAYS rendered — greyed when idle, lit when in
  // assignment mode. Keeps the panel layout stable so clicking a silhouette
  // doesn't push the cards downward.
  const banner = document.createElement("div");
  banner.className = "enemy-assignment-banner";
  if (attacker.assignmentMode !== null) {
    const sidx = attacker.assignmentMode;
    const sz = ENEMY_SILHOUETTES[sidx].size;
    const assigned = assignedHitCount(sidx);
    banner.classList.add("active");
    banner.style.setProperty("--silhouette-color", SILHOUETTE_COLORS[sidx]);
    banner.innerHTML = `<b>ASSIGNING TO SIZE ${sz} · ${assigned}/${sz}</b>`
      + `Click an X mark to tag it. Click another silhouette to switch. Click empty cell or Esc to finish.`;
  } else {
    banner.innerHTML = `<b>HIT ASSIGNMENT</b>`
      + `Click a silhouette to start tagging X marks to it. Helps you track which hits go with which ship.`;
  }
  root.appendChild(banner);

  const SVG_NS = "http://www.w3.org/2000/svg";
  ENEMY_SILHOUETTES.forEach(silhouette => {
    const sidx = silhouette.idx;
    const manualSunk = attacker.declaredSunk.has(sidx);
    const fulfilled = silhouetteFulfilled(sidx);
    const appearsSunk = manualSunk || fulfilled;
    const inAssignmentMode = attacker.assignmentMode === sidx;
    const assigned = assignedHitCount(sidx);
    const color = SILHOUETTE_COLORS[sidx];

    const card = document.createElement("div");
    card.className = "enemy-silhouette"
      + (appearsSunk ? " declared-sunk" : "")
      + (inAssignmentMode ? " assigning" : "");
    card.dataset.idx = sidx;
    card.style.setProperty("--silhouette-color", color);

    const sizeLbl = document.createElement("span");
    sizeLbl.className = "silhouette-size";
    sizeLbl.textContent = silhouette.size;
    card.appendChild(sizeLbl);

    // Row of N hex-cell pips. Each pip fills individually left-to-right with
    // the silhouette color as hits get assigned. crispEdges + integer pixel
    // positions + uniform 1px stroke avoid the subpixel rendering that gave
    // mixed 1/2px verticals in v1.
    const cellW = 14, cellH = 16, gap = 2;
    const totalW = silhouette.size * (cellW + gap) - gap;
    const svg = document.createElementNS(SVG_NS, "svg");
    svg.setAttribute("width", totalW);
    svg.setAttribute("height", cellH);
    svg.setAttribute("class", "silhouette-cells");
    svg.setAttribute("shape-rendering", "crispEdges");
    for (let i = 0; i < silhouette.size; i++) {
      const r = document.createElementNS(SVG_NS, "rect");
      r.setAttribute("x", i * (cellW + gap));
      r.setAttribute("y", 0);
      r.setAttribute("width", cellW);
      r.setAttribute("height", cellH);
      // Cells stay in their assignment state regardless of sunk. When fulfilled,
      // assigned == size so all pips fill in the silhouette color naturally.
      // The "down" signal moves to the silhouette (red X over the hull) below.
      let fill, stroke;
      if (i < assigned) { fill = color; stroke = "#1a1410"; }
      else              { fill = "#faf4e6"; stroke = "#3a3020"; }
      r.setAttribute("fill", fill);
      r.setAttribute("stroke", stroke);
      r.setAttribute("stroke-width", "1");
      svg.appendChild(r);
    }
    card.appendChild(svg);

    // Ship silhouette — small ink-style hull rendered with the same geometry
    // as Render Mode A. Length scales with ship size so the visual itself
    // communicates "this is a 5" vs "this is a 2".
    const sHexR = 9;
    const sFeat = buildShipFeatures({ size: silhouette.size }, sHexR);
    const sHullPadX = 4, sHullPadY = 3;
    const sW = Math.ceil((sFeat.bow + 2) - sFeat.stern + sHullPadX * 2);
    const sH = Math.ceil(sFeat.B * 1.9 + sHullPadY * 2);
    const sSvg = document.createElementNS(SVG_NS, "svg");
    sSvg.setAttribute("class", "silhouette-ship");
    sSvg.setAttribute("width", sW);
    sSvg.setAttribute("height", sH);
    sSvg.setAttribute("viewBox", `${sFeat.stern - sHullPadX} ${-sH / 2} ${sW} ${sH}`);
    sSvg.appendChild(el("path", { d: sFeat.hullPath, fill: "#1a1410", stroke: "#000", "stroke-width": 0.6 }));
    sSvg.appendChild(el("path", { d: sFeat.bowWedge, fill: "#5a4a30" }));
    sSvg.appendChild(el("path", { d: `M ${sFeat.stern*0.85},0 L ${sFeat.bow*0.85},0`, stroke: "#c9b58a", "stroke-width": 0.8, opacity: 0.4, fill: "none" }));
    // "Down" indicator: red X struck through the hull when the silhouette is
    // accounted-for. Lives on the ship — cell pips just show assignment progress.
    if (appearsSunk) {
      const xExt = sFeat.B * 1.6;
      const xColor = "#c81e1e";
      const xW = 2.4;
      sSvg.appendChild(el("line", { x1: -xExt, y1: -xExt, x2: xExt, y2: xExt, stroke: xColor, "stroke-width": xW, "stroke-linecap": "round" }));
      sSvg.appendChild(el("line", { x1: -xExt, y1: xExt, x2: xExt, y2: -xExt, stroke: xColor, "stroke-width": xW, "stroke-linecap": "round" }));
    }
    card.appendChild(sSvg);

    const meta = document.createElement("div");
    meta.className = "silhouette-meta";
    if (appearsSunk) {
      const why = fulfilled && manualSunk ? "DECLARED · ACCOUNTED FOR"
        : fulfilled ? "ACCOUNTED FOR"
        : "DECLARED SUNK";
      meta.innerHTML = `<span class="silhouette-status-sunk">${why}</span>`;
    } else if (inAssignmentMode) {
      meta.innerHTML = `<span class="silhouette-assigning">ASSIGNING</span> · ${assigned}/${silhouette.size}`;
    } else if (assigned > 0) {
      meta.innerHTML = `${assigned}/${silhouette.size} assigned`;
    } else {
      meta.innerHTML = `click to assign hits`;
    }
    card.appendChild(meta);

    // Click on card body → enter/exit assignment mode for this silhouette.
    // (Manual "declared sunk" hunch path removed — only path to "appears sunk"
    // is now via assignment reaching size. `attacker.declaredSunk` retained in
    // the data model but no UI surface.)
    card.addEventListener("click", () => toggleAssignmentMode(sidx));
    root.appendChild(card);
  });
}

/* ---- CONTACT TRACKS (§7.4) ---- */
const TRACK_COLORS = ["#a03020", "#3060a0", "#60a030", "#a06030", "#6030a0", "#208080", "#a02080", "#506070"];

function buildContactsList() {
  const root = document.getElementById("contactsList");
  if (!root) return;
  root.innerHTML = "";
  if (!state.showContactTracks) return;
  if (attacker.contacts.length === 0) return;

  const dirs = hexDirs();
  attacker.contacts.forEach((t, idx) => {
    const color = TRACK_COLORS[idx % TRACK_COLORS.length];
    const card = document.createElement("div");
    card.className = "contact-card confidence-" + t.confidence;
    card.style.setProperty("--track-color", color);

    const confLabel = ({
      consistent: "CONSISTENT",
      forced: "FORCED",
      inconsistent: "INCONSISTENT",
      unattributed: "1 HIT",
    })[t.confidence];

    // Inferred heading: single value if narrowed, else 'multi'.
    const headingStr = t.possibleHeadings.length === 1
      ? `<b>${dirs[t.possibleHeadings[0]].name}</b>`
      : t.possibleHeadings.length === 0
        ? '—'
        : `<span class="ambiguous">${t.possibleHeadings.length} candidates</span>`;
    const cdStr = t.possibleCooldowns.length === 1
      ? `<b>${t.possibleCooldowns[0]}</b>`
      : t.possibleCooldowns.length === 0
        ? '—'
        : `<span class="ambiguous">${t.possibleCooldowns.map(c => c).join('/')}</span>`;
    const sizeStr = t.possibleSizes.length === 1
      ? `<b>${t.possibleSizes[0]}</b>`
      : t.possibleSizes.length === 0
        ? '—'
        : `<span class="ambiguous">${t.possibleSizes.map(s => s).join('/')}</span>`;

    card.innerHTML = `
      <div class="contact-head">
        <span>${t.id} · ${t.hits.length} hit${t.hits.length > 1 ? 's' : ''}</span>
        <span class="contact-confidence" style="color: ${color};">${confLabel}</span>
      </div>
      <div class="contact-meta">
        heading ${headingStr} · cd ${cdStr} · size ${sizeStr}
      </div>
      <div class="contact-meta">
        ${t.hits.map(h => `T${h.tick} (${h.q},${h.r})`).join(' → ')}
      </div>
    `;
    root.appendChild(card);
  });
}

/* ---- END-OF-GAME PANELS (Stage 7) ---- */
// Stable silhouette-idx → ship mapping by descending size order in the fleet.
// Truth revelation at EoG: silhouette 0 is the largest ship (BB), 4 is the
// smallest (PT). The two size-3 DDs map to silhouettes 2 and 3 in fleet order.
function endgameSilhouetteToShip() {
  // ENEMY_SILHOUETTES is in size order [5,4,3,3,2]. Sort fleet the same way
  // and zip; ties (the two DDs) take fleet definition order.
  const sortedFleet = fleet.slice().sort((a, b) => b.size - a.size);
  const map = {};
  ENEMY_SILHOUETTES.forEach((s, i) => { map[s.idx] = sortedFleet[i]; });
  return map;
}

function buildEndgamePanels() {
  const validationRoot = document.getElementById("endgameValidation");
  const outcomeRoot = document.getElementById("endgameFleetOutcome");
  if (!validationRoot || !outcomeRoot) return;
  validationRoot.innerHTML = "";
  outcomeRoot.innerHTML = "";

  // --- Validation panel (silhouettes vs truth) ---
  const sToShip = endgameSilhouetteToShip();
  let correct = 0, falsePositive = 0, missed = 0;
  ENEMY_SILHOUETTES.forEach(silhouette => {
    const sidx = silhouette.idx;
    const ship = sToShip[sidx];
    const actuallySunk = !!(ship && ship.sunk);
    const playerDeclared = silhouetteAppearsSunk(sidx);
    let verdict, verdictClass;
    if (actuallySunk && playerDeclared)       { verdict = "✓ CORRECT";        verdictClass = "verdict-correct"; correct++; }
    else if (actuallySunk && !playerDeclared) { verdict = "? MISSED";         verdictClass = "verdict-missed"; missed++; }
    else if (!actuallySunk && playerDeclared) { verdict = "✗ FALSE POSITIVE"; verdictClass = "verdict-false"; falsePositive++; }
    else                                       { verdict = "— AT LARGE";      verdictClass = "verdict-neutral"; }
    const assigned = assignedHitCount(sidx);
    const hits = ship ? ship.size - ship.hp : 0;
    const card = document.createElement("div");
    card.className = "endgame-validation-card " + verdictClass;
    card.style.setProperty("--silhouette-color", SILHOUETTE_COLORS[sidx]);
    card.innerHTML = `
      <div class="endgame-card-head">
        <span class="endgame-card-id">${ship ? ship.id : `Silhouette ${sidx}`}</span>
        <span class="endgame-card-verdict">${verdict}</span>
      </div>
      <div class="endgame-card-body">
        size <b>${silhouette.size}</b> · actual: <b>${actuallySunk ? "SUNK" : "ALIVE"}</b> · hits: <b>${hits}</b>
      </div>
      <div class="endgame-card-body">
        you declared: <b>${playerDeclared ? "SUNK" : "at large"}</b> · ${assigned}/${silhouette.size} assigned
      </div>
    `;
    validationRoot.appendChild(card);
  });
  // Score summary at top of validation
  const scoreCard = document.createElement("div");
  scoreCard.className = "endgame-score";
  scoreCard.innerHTML = `<b>${correct}/5</b> correct · ${falsePositive} false positive · ${missed} missed`;
  validationRoot.prepend(scoreCard);

  // --- Fleet outcome panel (defender side) ---
  // Distance traveled = unique-cell footprint count across sim.history per ship.
  fleet.forEach(ship => {
    const sunk = ship.sunk;
    const hits = ship.size - ship.hp;
    const dir = hexDirs()[ship.head] || hexDirs()[0];
    let distance = 0;
    if (sim.history && sim.history.length > 0) {
      // Anchor positions per tick from history; count tick-to-tick moves (q,r changed).
      let prev = null;
      sim.history.forEach(snap => {
        const s = snap.find(x => x.id === ship.id);
        if (!s) return;
        if (prev && (prev.q !== s.q || prev.r !== s.r)) distance++;
        prev = s;
      });
      // Final motion to current state
      if (prev && (prev.q !== ship.q || prev.r !== ship.r)) distance++;
    }
    const card = document.createElement("div");
    card.className = "endgame-outcome-card " + (sunk ? "outcome-sunk" : "outcome-alive");
    card.innerHTML = `
      <div class="endgame-card-head">
        <span class="endgame-card-id">${ship.id}</span>
        <span class="endgame-card-verdict">${sunk ? "✕ SUNK" : "● ALIVE"}</span>
      </div>
      <div class="endgame-card-body">
        size <b>${ship.size}</b> · hp <b>${ship.hp}/${ship.size}</b> · ${hits} hit${hits === 1 ? '' : 's'}
      </div>
      <div class="endgame-card-body">
        heading <b>${dir.name}</b> · moved <b>${distance}</b> tick${distance === 1 ? '' : 's'} · final (${ship.q},${ship.r})
      </div>
    `;
    outcomeRoot.appendChild(card);
  });
}
// interval = how many ticks between moves. Smaller ships are faster.
// size 1 → every 1 tick, size 2 → every 1, size 3 → every 2, size 4 → every 3, size 5 → every 4
const SHIP_SPEED = {
  interval(ship) { return ship.cooldown; },
  movesOnTick(ship, tick) {
    if (tick <= 0 || ship.sunk) return false;
    return tick % this.interval(ship) === 0;
  },
  label(ship) {
    const iv = this.interval(ship);
    return iv === 1 ? "every tick" : `every ${iv} ticks`;
  },
};

/* ---- SIMULATION STATE ---- */
const sim = {
  tick: 0,
  history: [],               // history[i] = fleet snapshot BEFORE tick i+1 was applied
  initialPositions: null,     // saved on entering running mode
  actions: {},                // last tick's action per ship (for display)
  hitLog: [],                 // { tick, q, r, result: 'HIT'|'MISS', shipId?, shipName? }
  probeMode: false,           // when true, clicking board probes a cell
  lastAnimatedEntryIdx: -1,  // highest hitLog idx whose fresh-event animation has played;
                              // guards against replay on incidental re-renders (hover/aim/etc)
};

function saveFleetSnapshot() {
  return fleet.map(s => ({ id: s.id, q: s.q, r: s.r, head: s.head, size: s.size, hp: s.hp, cooldown: s.cooldown, hitsTaken: s.hitsTaken, sunk: s.sunk, baseCooldown: s.baseCooldown }));
}
function restoreFleetSnapshot(snap) {
  snap.forEach(ss => {
    const ship = fleet.find(s => s.id === ss.id);
    if (ship) { ship.q = ss.q; ship.r = ss.r; ship.head = ss.head; ship.size = ss.size; ship.hp = ss.hp; ship.cooldown = ss.cooldown; ship.hitsTaken = ss.hitsTaken; ship.sunk = ss.sunk; ship.baseCooldown = ss.baseCooldown; }
  });
}

/* ---- TURN PREFERENCE (delta from current heading) ---- */
// Prefer: straight, gentle port/starboard, harder turns, reverse as last resort
const TURN_PREFERENCE = [0, 1, -1, 2, -2, 3];

/* Given a hypothetical ship position + heading, return its wrapped cells */
function cellsForShipAt(q, r, head, size) {
  const dir = hexDirs()[head];
  const cells = [];
  for (let i = 0; i < size; i++) {
    cells.push(wrapHex(q + i * dir.dq, r + i * dir.dr, state.radius));
  }
  return cells;
}

function cellsOverlap(cells, lockedSet) {
  return cells.some(c => lockedSet.has(`${c.q},${c.r}`));
}

/* Score a candidate heading by simulating N ticks of straight-line travel
   and counting how many steps before a collision with locked cells.
   Also penalizes going off-board (cells that wrap = less desirable). */
function scoreHeading(shipQ, shipR, newHead, size, lockedCells, depth) {
  const dirs = hexDirs();
  const dir = dirs[newHead];
  let q = shipQ, r = shipR;
  let score = 0;
  for (let d = 0; d < depth; d++) {
    const nq = q + dir.dq, nr = r + dir.dr;
    const wrapped = wrapHex(nq, nr, state.radius);
    q = wrapped.q; r = wrapped.r;
    const cells = cellsForShipAt(q, r, newHead, size);
    if (cellsOverlap(cells, lockedCells)) break;
    score++;
  }
  return score;
}

const LOOKAHEAD_DEPTH = 4;

function stepForward() {
  sim.history.push(saveFleetSnapshot());
  sim.tick++;
  sim.actions = {};  // track what each ship did this tick

  // Sort fleet: largest first (priority)
  const sorted = [...fleet].sort((a, b) => b.size - a.size);
  const lockedCells = new Set();
  const dirs = hexDirs();
  const numDirs = dirs.length;

  // First, lock cells of ships that DON'T act this tick
  sorted.forEach(ship => {
    if (ship.sunk) { sim.actions[ship.id] = ICO_SKULL_HTML + " sunk"; return; }
    if (!SHIP_SPEED.movesOnTick(ship, sim.tick)) {
      shipCells(ship).forEach(c => lockedCells.add(`${c.q},${c.r}`));
      sim.actions[ship.id] = "—";
    }
  });

  // Process ships that DO act (largest first)
  sorted.forEach(ship => {
    if (ship.sunk) return;
    if (!SHIP_SPEED.movesOnTick(ship, sim.tick)) return;

    let bestHead = ship.head;
    let bestQ = ship.q, bestR = ship.r;
    let bestScore = -1;
    let bestDelta = 999;
    let found = false;

    for (const delta of TURN_PREFERENCE) {
      const candidateHead = ((ship.head + delta) % numDirs + numDirs) % numDirs;
      const dir = dirs[candidateHead];
      // Move one cell forward in candidate heading
      const nq = ship.q + dir.dq, nr = ship.r + dir.dr;
      const wrapped = wrapHex(nq, nr, state.radius);
      const newCells = cellsForShipAt(wrapped.q, wrapped.r, candidateHead, ship.size);

      if (!cellsOverlap(newCells, lockedCells)) {
        // Score by lookahead
        const score = scoreHeading(wrapped.q, wrapped.r, candidateHead, ship.size, lockedCells, LOOKAHEAD_DEPTH);
        const absDelta = Math.abs(delta);
        // Prefer: higher lookahead score, then smaller turn delta
        if (score > bestScore || (score === bestScore && absDelta < bestDelta)) {
          bestScore = score;
          bestDelta = absDelta;
          bestHead = candidateHead;
          bestQ = wrapped.q;
          bestR = wrapped.r;
          found = true;
        }
      }
    }

    if (found) {
      const turned = bestHead !== ship.head;
      const turnDir = turned ? (() => {
        let d = bestHead - ship.head;
        if (d > numDirs / 2) d -= numDirs;
        if (d < -numDirs / 2) d += numDirs;
        return d > 0 ? "⟳" : "⟲";
      })() : "";
      const oldDirName = dirs[ship.head].name;
      const newDirName = dirs[bestHead].name;
      ship.head = bestHead;
      ship.q = bestQ;
      ship.r = bestR;
      sim.actions[ship.id] = turned
        ? `${turnDir} ${oldDirName}→${newDirName} + fwd`
        : "fwd";
    } else {
      // Emergency all-stop: can't move anywhere
      sim.actions[ship.id] = "[!] blocked";
    }

    // Lock this ship's final cells
    shipCells(ship).forEach(c => lockedCells.add(`${c.q},${c.r}`));
  });

  updateSimUI();
  buildFleetList();
  renderBoard();
}

function stepBack() {
  if (sim.tick <= 0 || sim.history.length === 0) return;
  const snap = sim.history.pop();
  restoreFleetSnapshot(snap);
  sim.tick--;
  updateSimUI();
  buildFleetList();
  renderBoard();
}

function resetSim() {
  if (sim.initialPositions) restoreFleetSnapshot(sim.initialPositions);
  sim.tick = 0;
  sim.history = [];
  sim.hitLog = [];
  sim.lastAnimatedEntryIdx = -1;
  nextSalvoId = 1;
  attacker.declaredSunk.clear();
  attacker.contacts = [];
  attacker.assignmentMode = null;
  clearAim();
  updateSimUI();
  updateLogs();
  buildFleetList();
  buildEnemyFleetSilhouettes();
  buildContactsList();
  buildEndgamePanels();
  renderBoard();
}

/* ---- PROBE / HIT LOGIC ---- */
function probeCell(q, r, opts = {}) {
  if (state.mode !== "running") return;
  // Check all non-sunk ships for occupancy at (q,r)
  let hitShip = null;
  let hitBodyIndex = -1;
  // Priority: largest ship first, then lowest body-index
  const sorted = [...fleet].filter(s => !s.sunk).sort((a, b) => b.size - a.size);
  for (const ship of sorted) {
    const cells = shipCells(ship);
    for (let i = 0; i < cells.length; i++) {
      if (cells[i].q === q && cells[i].r === r) {
        hitShip = ship;
        hitBodyIndex = i;
        break;
      }
    }
    if (hitShip) break;
  }

  const entry = { tick: sim.tick, q, r };
  if (hitShip) {
    hitShip.hp--;
    hitShip.hitsTaken++;
    hitShip.cooldown = hitShip.baseCooldown + hitShip.hitsTaken;
    entry.result = 'HIT';
    entry.shipId = hitShip.id;
    entry.shipName = hitShip.id;
    entry.bodyIndex = hitBodyIndex;
    if (hitShip.hp <= 0) {
      hitShip.sunk = true;
      hitShip.hp = 0;
      entry.sunk = true;
    }
  } else {
    entry.result = 'MISS';
  }
  if (opts.salvoId) entry.salvoId = opts.salvoId;
  sim.hitLog.push(entry);
  // skipRender lets a caller (fireDirectSalvo) batch multiple probes into ONE render,
  // so both salvo cells live in the same freshIndices set and both animate.
  if (opts.skipRender) return;
  updateLogs();
  buildFleetList();
  buildEnemyFleetSilhouettes();
  if (state.showContactTracks) attacker.contacts = computeContactTracks();
  buildContactsList();
  buildEndgamePanels();
  renderBoard();
  updateSpeedChart();
}

function updateHitLog() {
  // Defender's view of incoming fire: reveals which ship was struck.
  const log = document.getElementById("hitLog");
  if (!log) return;
  log.innerHTML = "";
  const entries = [...sim.hitLog].reverse();
  entries.forEach(e => {
    const div = document.createElement("div");
    div.className = "log-entry";
    const cellStr = `(${e.q},${e.r})`;
    if (e.sunk) {
      div.className += " log-sunk";
      div.innerHTML = `T${e.tick} · ${cellStr} · <b>HIT — ${e.shipName} SUNK!</b>`;
    } else if (e.result === 'HIT') {
      div.innerHTML = `T${e.tick} · ${cellStr} · <span class="log-hit">HIT</span> · ${e.shipName}`;
    } else {
      div.innerHTML = `T${e.tick} · ${cellStr} · <span class="log-miss">MISS</span>`;
    }
    log.appendChild(div);
  });
}

function updateProbeLog() {
  // Attacker's teletype console (§7.7). Renders fire history grouped by salvo
  // — one header per salvo + a line per probed cell. REVISIT cells call out the
  // tick they were last touched. No ship-class reveal (R18).
  const log = document.getElementById("probeLog");
  if (!log) return;
  log.innerHTML = "";

  // Index every cell's earlier-tick visits so REVISIT lookup is cheap.
  // (For each entry index i, the most recent prior visit to (q,r), if any.)
  const lastVisitAt = new Array(sim.hitLog.length).fill(null);
  const seenByCell = new Map(); // "q,r" -> last entry index
  sim.hitLog.forEach((e, i) => {
    const key = `${e.q},${e.r}`;
    if (seenByCell.has(key)) lastVisitAt[i] = sim.hitLog[seenByCell.get(key)].tick;
    seenByCell.set(key, i);
  });

  // Group consecutive entries with the same salvoId. Entries without salvoId
  // (defender-side Probe tool) render as standalone single-cell "probes".
  const groups = [];
  sim.hitLog.forEach((e, i) => {
    const sid = e.salvoId || null;
    const last = groups[groups.length - 1];
    if (sid && last && last.salvoId === sid) {
      last.entries.push({ ...e, _idx: i, lastVisit: lastVisitAt[i] });
    } else {
      groups.push({
        salvoId: sid, tick: e.tick,
        entries: [{ ...e, _idx: i, lastVisit: lastVisitAt[i] }]
      });
    }
  });

  // Newest first.
  groups.reverse().forEach(g => {
    const div = document.createElement("div");
    div.className = "log-entry teletype-salvo";
    const anyRevisit = g.entries.some(e => e.lastVisit !== null);
    const anySunk = g.entries.some(e => e.sunk);
    // Salvo label derived from the hex distance between the two cells. Same
    // mapping the teletype line uses during firing — keeps the log readable
    // with the same language ("TIGHT PAIR" / "WIDE SPREAD" / "RANGE N").
    let salvoLabel = null;
    if (g.entries.length >= 2) {
      const a = g.entries[0], b = g.entries[1];
      salvoLabel = salvoLabelByDistance(hexDistance(a.q, a.r, b.q, b.r));
    }
    const header = g.salvoId
      ? `&gt; SALVO ${g.salvoId} · T${g.tick}${salvoLabel ? ` · ${salvoLabel}` : ""}${anyRevisit ? ` · <span class="log-revisit">REVISIT</span>` : ""}${anySunk ? ` · <span class="log-sunk-inline">VESSEL DESTROYED</span>` : ""}`
      : `&gt; PROBE · T${g.tick}`;
    const lines = g.entries.map(e => {
      const cellStr = `(${e.q},${e.r})`;
      const revisitTag = e.lastVisit !== null ? ` <span class="log-revisit-tag">(last T${e.lastVisit})</span>` : "";
      const sunkTag = e.sunk ? ` <span class="log-sunk-inline">VESSEL DOWN</span>` : "";
      if (e.result === 'HIT') return `&nbsp;&nbsp;· ${cellStr} <span class="log-hit">HIT</span>${revisitTag}${sunkTag}`;
      return `&nbsp;&nbsp;· ${cellStr} <span class="log-miss">MISS</span>${revisitTag}`;
    });
    div.innerHTML = `<div class="teletype-header">${header}</div>` + lines.map(l => `<div>${l}</div>`).join("");
    // Cross-panel hover: highlight this salvo's cells on the board.
    const cells = g.entries.map(e => ({ q: e.q, r: e.r }));
    div.addEventListener("mouseenter", () => highlightCellsOnBoard(cells));
    div.addEventListener("mouseleave", () => highlightCellsOnBoard(null));
    log.appendChild(div);
  });
}

function updateLogs() {
  // Cheap to update both — visibility is CSS-driven by perspective.
  updateHitLog();
  updateProbeLog();
}

function enterRunningMode() {
  state.mode = "running";
  sim.tick = 0;
  sim.history = [];
  sim.hitLog = [];
  sim.lastAnimatedEntryIdx = -1;
  sim.probeMode = false;
  sim.initialPositions = saveFleetSnapshot();
  nextSalvoId = 1;
  attacker.aim = null;
  attacker.hoverDestination = null;
