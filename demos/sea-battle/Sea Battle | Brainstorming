{"command":"create","path":"/tmp/hex_battle.py","file_text":"import matplotlib.pyplot as plt\nimport matplotlib.patches as mpatches\nimport numpy as np\nfrom matplotlib.patches import RegularPolygon\n\n# Hex grid parameters\nHEX_RADIUS = 1.0\nGRID_RADIUS = 6  # how many rings out from center\n\ndef axial_to_pixel(q, r, size=HEX_RADIUS):\n    \"\"\"Convert axial hex coords to pixel coords (pointy-top hex).\"\"\"\n    x = size * np.sqrt(3) * (q + r / 2)\n    y = size * 3 / 2 * r\n    return x, y\n\ndef hex_neighbors(q, r):\n    \"\"\"6 neighbors in axial coordinates.\"\"\"\n    return [(q+1,r), (q-1,r), (q,r+1), (q,r-1), (q+1,r-1), (q-1,r+1)]\n\ndef gen_grid(radius):\n    cells = set()\n    for q in range(-radius, radius+1):\n        for r in range(-radius, radius+1):\n            if abs(q+r) &lt;= radius:\n                cells.add((q,r))\n    return cells\n\ndef step_wildfire(infected, grid):\n    \"\"\"Each infected cell spreads to all 6 neighbors (if in grid).\"\"\"\n    new = set(infected)\n    for (q,r) in infected:\n        for n in hex_neighbors(q,r):\n            if n in grid:\n                new.add(n)\n    return new\n\ndef draw_hex(ax, q, r, color, edge='black', alpha=1.0, label=None):\n    x, y = axial_to_pixel(q, r)\n    hexagon = RegularPolygon((x, y), numVertices=6, radius=HEX_RADIUS*0.95,\n                              orientation=np.radians(30),\n                              facecolor=color, edgecolor=edge,\n                              alpha=alpha, linewidth=1.2)\n    ax.add_patch(hexagon)\n    if label:\n        ax.text(x, y, label, ha='center', va='center', fontsize=8, color='white', fontweight='bold')\n\n# Simulate 4 turns of a single seed spreading, with player probes\ngrid = gen_grid(GRID_RADIUS)\n\n# Initial fire seed (ship)\nseeds_t0 = {(0, 0), (1, 0), (0, 1)}  # an L-shaped \"ship\"\n\n# Player's probe history with persistence window of 3 turns\n# Each probe = (q, r, turn_fired)\nprobes = {\n    0: [(-2, -1)],          # miss\n    1: [(1,