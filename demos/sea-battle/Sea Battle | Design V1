{"command":"create","path":"/tmp/ship_render_options.html","file_text":"&lt;!DOCTYPE html&gt;\n&lt;html lang=\"en\"&gt;\n&lt;head&gt;\n&lt;meta charset=\"UTF-8\" /&gt;\n&lt;title&gt;Sea Battle — Ship Render Options&lt;/title&gt;\n&lt;style&gt;\n  :root {\n    --paper: #e8dcc0;\n    --paper-2: #d9c89f;\n    --ink: #3a2e1c;\n    --ink-2: #5a4a30;\n    --accent: #1f3a5f;\n    --hex-line: rgba(58,46,28,0.45);\n    --shadow: rgba(0,0,0,0.28);\n  }\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    font-family: -apple-system, \"Segoe UI\", Roboto, sans-serif;\n    background: #2a2620;\n    color: #ddd;\n    padding: 20px;\n  }\n  h1 { margin: 0 0 4px 0; font-weight: 300; letter-spacing: 1px; }\n  .sub { color: #999; margin-bottom: 20px; font-size: 13px; }\n  .controls {\n    display: flex; gap: 14px; align-items: center;\n    background: #1d1a15; padding: 10px 14px; border-radius: 6px;\n    margin-bottom: 20px; flex-wrap: wrap;\n  }\n  .controls label { font-size: 12px; color: #aaa; }\n  .controls select, .controls input[type=range] { vertical-align: middle; }\n  .grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 18px;\n  }\n  .card {\n    background: linear-gradient(135deg, var(--paper) 0%, var(--paper-2) 100%);\n    border-radius: 4px;\n    overflow: hidden;\n    box-shadow: 0 8px 24px rgba(0,0,0,0.4);\n    position: relative;\n  }\n  .card-header {\n    position: absolute; top: 0; left: 0; right: 0;\n    padding: 10px 14px;\n    background: rgba(0,0,0,0.65);\n    color: #eee;\n    font-size: 12px;\n    letter-spacing: 0.5px;\n    z-index: 10;\n    display: flex; justify-content: space-between; align-items: center;\n  }\n  .card-header b { font-weight: 600; letter-spacing: 1px; }\n  .card-header span { color: #aaa; font-size: 11px; }\n  .stage {\n    position: relative;\n    width: 100%;\n    aspect-ratio: 16 / 10;\n    overflow: hidden;\n  }\n  .stage svg, .stage canvas {\n    position: absolute; inset: 0; width: 100%; height: 100%;\n    display: block;\n  }\n  .legend {\n    position: absolute; bottom: 8px; right: 12px;\n    font-size: 10px; color: var(--ink-2);\n    font-family: \"Courier New\", monospace;\n    text-align: right;\n    line-height: 1.3;\n  }\n  .compass {\n    position: absolute; bottom: 8px; left: 12px;\n    width: 48px; height: 48px;\n    opacity: 0.55;\n  }\n&lt;/style&gt;\n&lt;/head&gt;\n&lt;body&gt;\n\n&lt;h1&gt;Sea Battle · Ship Render Options&lt;/h1&gt;\n&lt;div class=\"sub\"&gt;Same blueprint base in each. Same 4 ships (sizes 5/4/3/2) on the same headings. Different rendering approaches.&lt;/div&gt;\n\n&lt;div class=\"controls\"&gt;\n  &lt;label&gt;Heading: &lt;select id=\"heading\"&gt;\n    &lt;option value=\"0\"&gt;E&lt;/option&gt;\n    &lt;option value=\"60\"&gt;SE&lt;/option&gt;\n    &lt;option value=\"120\"&gt;SW&lt;/option&gt;\n    &lt;option value=\"180\"&gt;W&lt;/option&gt;\n    &lt;option value=\"240\"&gt;NW&lt;/option&gt;\n    &lt;option value=\"300\"&gt;NE&lt;/option&gt;\n  &lt;/select&gt;&lt;/label&gt;\n  &lt;label&gt;Damage: &lt;input id=\"damage\" type=\"range\" min=\"0\" max=\"3\" value=\"0\" step=\"1\"&gt;&lt;/label&gt;\n  &lt;span id=\"dmgLabel\" style=\"font-size:12px;color:#aaa;\"&gt;0 hits&lt;/span&gt;\n  &lt;label style=\"margin-left:auto;\"&gt;&lt;input type=\"checkbox\" id=\"showFootprint\" checked&gt; Show footprint trail&lt;/label&gt;\n&lt;/div&gt;\n\n&lt;div class=\"grid\"&gt;\n\n  &lt;!-- ============ OPTION A: SVG Silhouette (top-down ink) ============ --&gt;\n  &lt;div class=\"card\"&gt;\n    &lt;div class=\"card-header\"&gt;&lt;b&gt;A · INK SILHOUETTE&lt;/b&gt;&lt;span&gt;SVG · top-down · matches the map&lt;/span&gt;&lt;/div&gt;\n    &lt;div class=\"stage\" id=\"stageA\"&gt;&lt;/div&gt;\n  &lt;/div&gt;\n\n  &lt;!-- ============ OPTION B: SVG Detailed Silhouette (top-down miniature) ============ --&gt;\n  &lt;div class=\"card\"&gt;\n    &lt;div class=\"card-header\"&gt;&lt;b&gt;B · DECK DETAIL&lt;/b&gt;&lt;span&gt;SVG · top-down · features visible (turrets, bridge)&lt;/span&gt;&lt;/div&gt;\n    &lt;div class=\"stage\" id=\"stageB\"&gt;&lt;/div&gt;\n  &lt;/div&gt;\n\n  &lt;!-- ============ OPTION C: SVG Faux-3D ¾ view ============ --&gt;\n  &lt;div class=\"card\"&gt;\n    &lt;div class=\"card-header\"&gt;&lt;b&gt;C · ¾ MINIATURE&lt;/b&gt;&lt;span&gt;SVG · isometric · \"wargaming piece\" feel&lt;/span&gt;&lt;/div&gt;\n    &lt;div class=\"stage\" id=\"stageC\"&gt;&lt;/div&gt;\n  &lt;/div&gt;\n\n  &lt;!-- ============ OPTION D: WebGL real 3D ============ --&gt;\n  &lt;div class=\"card\"&gt;\n    &lt;div class=\"card-header\"&gt;&lt;b&gt;D · GL LOW-POLY&lt;/b&gt;&lt;span&gt;Three.js · real lighting &amp; shadow · programmatic&lt;/span&gt;&lt;/div&gt;\n    &lt;div class=\"stage\" id=\"stageD\"&gt;&lt;/div&gt;\n  &lt;/div&gt;\n\n  &lt;!-- ============ OPTION E: Blueprint line drawing ============ --&gt;\n  &lt;div class=\"card\"&gt;\n    &lt;div class=\"card-header\"&gt;&lt;b&gt;E · BLUEPRINT LINE&lt;/b&gt;&lt;span&gt;SVG · ship drawn AS the map · maximally diegetic&lt;/span&gt;&lt;/div&gt;\n    &lt;div class=\"stage\" id=\"stageE\"&gt;&lt;/div&gt;\n  &lt;/div&gt;\n\n  &lt;!-- ============ OPTION F: NATO Counter ============ --&gt;\n  &lt;div class=\"card\"&gt;\n    &lt;div class=\"card-header\"&gt;&lt;b&gt;F · COMMAND COUNTER&lt;/b&gt;&lt;span&gt;SVG · pictogram · max readability&lt;/span&gt;&lt;/div&gt;\n    &lt;div class=\"stage\" id=\"stageF\"&gt;&lt;/div&gt;\n  &lt;/div&gt;\n\n&lt;/div&gt;\n\n&lt;script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\"&gt;&lt;/script&gt;\n&lt;script&gt;\n/* =====================================================================\n   HEX GEOMETRY (pointy-top, axial coords)\n   ===================================================================== */\nconst HEX_R = 26;                       // hex radius (px)\nconst HEX_W = Math.sqrt(3) * HEX_R;     // pointy-top width\nconst HEX_H = 2 * HEX_R;                // pointy-top height\nconst HEX_VSTEP = 0.75 * HEX_H;         // vertical step between rows\n\n// Axial -&gt; pixel (pointy-top)\nfunction axialToPx(q, r) {\n  const x = HEX_W * (q + r/2);\n  const y = HEX_VSTEP * r;\n  return { x, y };\n}\n\n// 6 neighbor directions for pointy-top (E, SE, SW, W, NW, NE)\nconst HEX_DIRS = [\n  { q: +1, r:  0 },   // E\n  { q:  0, r: +1 },   // SE\n  { q: -1, r: +1 },   // SW\n  { q: -1, r:  0 },   // W\n  { q:  0, r: -1 },   // NW\n  { q: +1, r: -1 },   // NE\n];\n// Heading angles in degrees (for ship rotation, 0 = East/right)\nconst HEAD_ANGLES = [0, 60, 120, 180, 240, 300];\n\n/* =====================================================================\n   BLUEPRINT BASE LAYER (shared)\n   ===================================================================== */\nfunction makeBlueprintBase(width, height, opts={}) {\n  const svgNS = \"http://www.w3.org/2000/svg\";\n  const svg = document.createElementNS(svgNS, \"svg\");\n  svg.setAttribute(\"viewBox\", `0 0 ${width} ${height}`);\n  svg.setAttribute(\"preserveAspectRatio\", \"xMidYMid slice\");\n\n  // Defs: paper texture, shadow filter, ship shadow filter\n  const defs = document.createElementNS(svgNS, \"defs\");\n  defs.innerHTML = `\n    &lt;radialGradient id=\"paperVignette\" cx=\"50%\" cy=\"50%\" r=\"70%\"&gt;\n      &lt;stop offset=\"0%\" stop-color=\"#f0e4c8\" stop-opacity=\"0.0\"/&gt;\n      &lt;stop offset=\"70%\" stop-color=\"#a08858\" stop-opacity=\"0.08\"/&gt;\n      &lt;stop offset=\"100%\" stop-color=\"#5a4628\" stop-opacity=\"0.35\"/&gt;\n    &lt;/radialGradient&gt;\n    &lt;filter id=\"grain\" x=\"0\" y=\"0\" width=\"100%\" height=\"100%\"&gt;\n      &lt;feTurbulence type=\"fractalNoise\" baseFrequency=\"0.9\" numOctaves=\"2\" seed=\"3\"/&gt;\n      &lt;feColorMatrix values=\"0 0 0 0 0.2  0 0 0 0 0.15  0 0 0 0 0.08  0 0 0 0.06 0\"/&gt;\n      &lt;feComposite in2=\"SourceGraphic\" operator=\"in\"/&gt;\n    &lt;/filter&gt;\n    &lt;filter id=\"shipShadow\" x=\"-30%\" y=\"-30%\" width=\"160%\" height=\"160%\"&gt;\n      &lt;feGaussianBlur in=\"SourceAlpha\" stdDeviation=\"1.8\"/&gt;\n      &lt;feOffset dx=\"1.5\" dy=\"2.5\" result=\"off\"/&gt;\n      &lt;feComponentTransfer&gt;&lt;feFuncA type=\"linear\" slope=\"0.55\"/&gt;&lt;/feComponentTransfer&gt;\n      &lt;feMerge&gt;&lt;feMergeNode/&gt;&lt;feMergeNode in=\"SourceGraphic\"/&gt;&lt;/feMerge&gt;\n    &lt;/filter&gt;\n    &lt;filter id=\"hardShadow\" x=\"-30%\" y=\"-30%\" width=\"160%\" height=\"160%\"&gt;\n      &lt;feGaussianBlur in=\"SourceAlpha\" stdDeviation=\"0.6\"/&gt;\n      &lt;feOffset dx=\"1\" dy=\"1.6\" result=\"off\"/&gt;\n      &lt;feComponentTransfer&gt;&lt;feFuncA type=\"linear\" slope=\"0.7\"/&gt;&lt;/feComponentTransfer&gt;\n      &lt;feMerge&gt;&lt;feMergeNode/&gt;&lt;feMergeNode in=\"SourceGraphic\"/&gt;&lt;/feMerge&gt;\n    &lt;/filter&gt;\n  `;\n  svg.appendChild(defs);\n\n  // Hex grid background\n  const cx = width/2, cy = height/2;\n  const cols = Math.ceil(width / HEX_W) + 2;\n  const rows = Math.ceil(height / HEX_VSTEP) + 2;\n\n  const grid = document.createElementNS(svgNS, \"g\");\n  grid.setAttribute(\"stroke\", \"rgba(58,46,28,0.45)\");\n  grid.setAttribute(\"stroke-width\", \"0.7\");\n  grid.setAttribute(\"fill\", \"none\");\n\n  for (let r = -rows; r &lt;= rows; r++) {\n    for (let q = -cols; q &lt;= cols; q++) {\n      const { x, y } = axialToPx(q, r);\n      const px = x + cx, py = y + cy;\n      if (px &lt; -HEX_R || px &gt; width + HEX_R || py &lt; -HEX_R || py &gt; height + HEX_R) continue;\n      const pts = [];\n      for (let i = 0; i &lt; 6; i++) {\n        const ang = (Math.PI/180) * (60*i - 30); // pointy-top\n        pts.push(`${(px + HEX_R*Math.cos(ang)).toFixed(2)},${(py + HEX_R*Math.sin(ang)).toFixed(2)}`);\n      }\n      const poly = document.createElementNS(svgNS, \"polygon\");\n      poly.setAttribute(\"points\", pts.join(\" \"));\n      grid.appendChild(poly);\n    }\n  }\n  svg.appendChild(grid);\n\n  // Vignette overlay\n  const vig = document.createElementNS(svgNS, \"rect\");\n  vig.setAttribute(\"width\", width); vig.setAttribute(\"height\", height);\n  vig.setAttribute(\"fill\", \"url(#paperVignette)\");\n  svg.appendChild(vig);\n\n  // Compass rose (bottom-left)\n  const compass = document.createElementNS(svgNS, \"g\");\n  compass.setAttribute(\"transform\", `translate(40, ${height-45})`);\n  compass.setAttribute(\"opacity\", \"0.45\");\n  compass.innerHTML = `\n    &lt;circle r=\"22\" fill=\"none\" stroke=\"#3a2e1c\" stroke-width=\"0.6\"/&gt;\n    &lt;circle r=\"16\" fill=\"none\" stroke=\"#3a2e1c\" stroke-width=\"0.4\"/&gt;\n    &lt;path d=\"M0,-22 L3,0 L0,22 L-3,0 Z\" fill=\"#3a2e1c\" opacity=\"0.6\"/&gt;\n    &lt;path d=\"M-22,0 L0,3 L22,0 L0,-3 Z\" fill=\"#3a2e1c\" opacity=\"0.6\"/&gt;\n    &lt;text y=\"-26\" text-anchor=\"middle\" font-size=\"8\" fill=\"#3a2e1c\" font-family=\"Georgia\"&gt;N&lt;/text&gt;\n  `;\n  svg.appendChild(compass);\n\n  return svg;\n}\n\n/* =====================================================================\n   SHIP DEFINITIONS\n   sizes: 5, 4, 3, 2 — placed at different rows\n   Each ship has: size (cells), origin (cx,cy), direction index (0-5)\n   ===================================================================== */\nfunction defaultShips(headingDeg) {\n  // We'll place 4 ships in a comfortable layout\n  return [\n    { size: 5, ax:  -3, ay: -2, head: headingDeg, name: \"BB-01\" },\n    { size: 4, ax:   2, ay: -1, head: headingDeg, name: \"CA-02\" },\n    { size: 3, ax:  -2, ay:  1, head: headingDeg, name: \"DD-03\" },\n    { size: 2, ax:   3, ay:  2, head: headingDeg, name: \"PT-04\" },\n  ];\n}\n\n/* =====================================================================\n   Helper: convert a ship (axial center, heading) into world pixel coords\n   For non-zero rotations on a hex grid the body cells lie along a hex direction,\n   but for the rendered glyph we just rotate a horizontal silhouette.\n   ===================================================================== */\nfunction shipWorldPos(ship, W, H) {\n  const { x, y } = axialToPx(ship.ax, ship.ay);\n  return { x: W/2 + x, y: H/2 + y };\n}\n\n/* =====================================================================\n   FOOTPRINT TRAIL renderer (shared)\n   Draws X marks at past positions to visualize \"what the attacker sees\"\n   ===================================================================== */\nfunction drawFootprints(svg, ship, W, H, opts={}) {\n  if (!opts.show) return;\n  const ns = \"http://www.w3.org/2000/svg\";\n  const { x, y } = shipWorldPos(ship, W, H);\n  const angle = ship.head * Math.PI/180;\n  // 2 fake hits behind the ship\n  for (let i = 1; i &lt;= 2; i++) {\n    const back = (ship.size/2 + i) * HEX_W * 0.9;\n    const hx = x - Math.cos(angle) * back;\n    const hy = y - Math.sin(angle) * back;\n    const g = document.createElementNS(ns, \"g\");\n    g.setAttribute(\"transform\", `translate(${hx},${hy})`);\n    g.setAttribute(\"opacity\", String(0.8 - i*0.2));\n    g.innerHTML = `\n      &lt;path d=\"M-6,-6 L6,6 M-6,6 L6,-6\" stroke=\"#8a1f1f\" stroke-width=\"1.6\" stroke-linecap=\"round\"/&gt;\n      &lt;text y=\"-9\" text-anchor=\"middle\" font-family=\"Courier New\" font-size=\"7\" fill=\"#8a1f1f\"&gt;T-${i*3}&lt;/text&gt;\n    `;\n    svg.appendChild(g);\n  }\n}\n\n/* =====================================================================\n   ============= OPTION A: INK SILHOUETTE =============\n   Top-down naval silhouette in deep ink. Single dark fill with tiny\n   highlight along the deck centerline. Reads as a chart symbol.\n   ===================================================================== */\nfunction renderA(container, state) {\n  container.innerHTML = \"\";\n  const W = container.clientWidth, H = container.clientHeight;\n  const svg = makeBlueprintBase(W, H);\n  const ns = \"http://www.w3.org/2000/svg\";\n\n  const ships = defaultShips(state.heading);\n  ships.forEach(ship =&gt; {\n    drawFootprints(svg, ship, W, H, { show: state.footprint });\n\n    const { x, y } = shipWorldPos(ship, W, H);\n    const g = document.createElementNS(ns, \"g\");\n    g.setAttribute(\"transform\", `translate(${x},${y}) rotate(${ship.head})`);\n    g.setAttribute(\"filter\", \"url(#shipShadow)\");\n\n    // Hull: stretched lens shape, length = size*HEX_W*0.92\n    const L = ship.size * HEX_W * 0.92;\n    const B = HEX_R * 0.85; // beam (width)\n    const bow = L * 0.42, stern = -L * 0.5;\n\n    // Damage = hull made shorter / chipped\n    const dmg = state.damage;\n    const lossL = dmg * L * 0.1;\n\n    const hullPath = `\n      M ${bow-lossL},0\n      C ${bow-lossL},${-B*0.4} ${bow*0.3},${-B*0.95} ${0},${-B*0.95}\n      C ${stern*0.5},${-B*0.95} ${stern},${-B*0.5} ${stern},0\n      C ${stern},${B*0.5} ${stern*0.5},${B*0.95} ${0},${B*0.95}\n      C ${bow*0.3},${B*0.95} ${bow-lossL},${B*0.4} ${bow-lossL},0 Z\n    `;\n\n    const hull = document.createElementNS(ns, \"path\");\n    hull.setAttribute(\"d\", hullPath);\n    hull.setAttribute(\"fill\", \"#1a1410\");\n    hull.setAttribute(\"stroke\", \"#000\");\n    hull.setAttribute(\"stroke-width\", \"0.6\");\n    g.appendChild(hull);\n\n    // Deck highlight (thin lighter centerline)\n    const deck = document.createElementNS(ns, \"path\");\n    deck.setAttribute(\"d\", `M ${stern*0.85},0 L ${(bow-lossL)*0.85},0`);\n    deck.setAttribute(\"stroke\", \"#c9b58a\");\n    deck.setAttribute(\"stroke-width\", \"0.8\");\n    deck.setAttribute(\"opacity\", \"0.35\");\n    g.appendChild(deck);\n\n    // Heading wedge — tiny arrowhead at bow\n    const wedge = document.createElementNS(ns, \"path\");\n    wedge.setAttribute(\"d\", `M ${bow-lossL+2},0 L ${bow-lossL-4},-2 L ${bow-lossL-4},2 Z`);\n    wedge.setAttribute(\"fill\", \"#3a2e1c\");\n    g.appendChild(wedge);\n\n    svg.appendChild(g);\n  });\n\n  container.appendChild(svg);\n}\n\n/* =====================================================================\n   ============= OPTION B: DECK DETAIL =============\n   Top-down with visible deck features (turrets as circles, bridge as\n   trapezoid, stack as small dark dot). Painted-grey naval color.\n   ===================================================================== */\nfunction renderB(container, state) {\n  container.innerHTML = \"\";\n  const W = container.clientWidth, H = container.clientHeight;\n  const svg = makeBlueprintBase(W, H);\n  const ns = \"http://www.w3.org/2000/svg\";\n\n  // Defs for ship gradients\n  const localDefs = document.createElementNS(ns, \"defs\");\n  localDefs.innerHTML = `\n    &lt;linearGradient id=\"hullB\" x1=\"0\" y1=\"-1\" x2=\"0\" y2=\"1\"&gt;\n      &lt;stop offset=\"0%\" stop-color=\"#6a7560\"/&gt;\n      &lt;stop offset=\"50%\" stop-color=\"#4a5444\"/&gt;\n      &lt;stop offset=\"100%\" stop-color=\"#2c332a\"/&gt;\n    &lt;/linearGradient&gt;\n    &lt;linearGradient id=\"deckB\" x1=\"0\" y1=\"-1\" x2=\"0\" y2=\"1\"&gt;\n      &lt;stop offset=\"0%\" stop-color=\"#7a6a4a\"/&gt;\n      &lt;stop offset=\"100%\" stop-color=\"#5a4e36\"/&gt;\n    &lt;/linearGradient&gt;\n  `;\n  svg.appendChild(localDefs);\n\n  const ships = defaultShips(state.heading);\n  ships.forEach(ship =&gt; {\n    drawFootprints(svg, ship, W, H, { show: state.footprint });\n\n    const { x, y } = shipWorldPos(ship, W, H);\n    const g = document.createElementNS(ns, \"g\");\n    g.setAttribute(\"transform\", `translate(${x},${y}) rotate(${ship.head})`);\n    g.setAttribute(\"filter\", \"url(#shipShadow)\");\n\n    const L = ship.size * HEX_W * 0.92;\n    const B = HEX_R * 0.78;\n    const bow = L * 0.42, stern = -L * 0.5;\n\n    // Hull\n    const hullPath = `\n      M ${bow},0\n      C ${bow},${-B*0.4} ${bow*0.35},${-B*0.95} ${0},${-B*0.95}\n      L ${stern*0.6},${-B*0.95}\n      C ${stern},${-B*0.85} ${stern},${-B*0.4} ${stern},0\n      C ${stern},${B*0.4} ${stern},${B*0.85} ${stern*0.6},${B*0.95}\n      L ${0},${B*0.95}\n      C ${bow*0.35},${B*0.95} ${bow},${B*0.4} ${bow},0 Z\n    `;\n    const hull = document.createElementNS(ns, \"path\");\n    hull.setAttribute(\"d\", hullPath);\n    hull.setAttribute(\"fill\", \"url(#hullB)\");\n    hull.setAttribute(\"stroke\", \"#1c1f1a\");\n    hull.setAttribute(\"stroke-width\", \"0.5\");\n    g.appendChild(hull);\n\n    // Deck (slightly inset)\n    const deckPath = `\n      M ${bow*0.85},0\n      C ${bow*0.85},${-B*0.3} ${bow*0.3},${-B*0.72} ${0},${-B*0.72}\n      L ${stern*0.55},${-B*0.72}\n      C ${stern*0.85},${-B*0.6} ${stern*0.85},${-B*0.3} ${stern*0.85},0\n      C ${stern*0.85},${B*0.3} ${stern*0.85},${B*0.6} ${stern*0.55},${B*0.72}\n      L ${0},${B*0.72}\n      C ${bow*0.3},${B*0.72} ${bow*0.85},${B*0.3} ${bow*0.85},0 Z\n    `;\n    const deck = document.createElementNS(ns, \"path\");\n    deck.setAttribute(\"d\", deckPath);\n    deck.setAttribute(\"fill\", \"url(#deckB)\");\n    g.appendChild(deck);\n\n    // Deck features depending on size\n    const features = document.createElementNS(ns, \"g\");\n    features.setAttribute(\"filter\", \"url(#hardShadow)\");\n    // Forward turret (always)\n    const ft = document.createElementNS(ns, \"circle\");\n    ft.setAttribute(\"cx\", bow*0.55); ft.setAttribute(\"cy\", 0); ft.setAttribute(\"r\", B*0.32);\n    ft.setAttribute(\"fill\", \"#3c4438\");\n    features.appendChild(ft);\n    // Aft turret if size &gt;= 3\n    if (ship.size &gt;= 3) {\n      const at = document.createElementNS(ns, \"circle\");\n      at.setAttribute(\"cx\", stern*0.65); at.setAttribute(\"cy\", 0); at.setAttribute(\"r\", B*0.32);\n      at.setAttribute(\"fill\", \"#3c4438\");\n      features.appendChild(at);\n    }\n    // Bridge (rectangle near center)\n    const br = document.createElementNS(ns, \"rect\");\n    br.setAttribute(\"x\", -B*0.55); br.setAttribute(\"y\", -B*0.4); br.setAttribute(\"width\", B*1.1); br.setAttribute(\"height\", B*0.8);\n    br.setAttribute(\"fill\", \"#5a6450\");\n    br.setAttribute(\"stroke\", \"#2c332a\"); br.setAttribute(\"stroke-width\", \"0.3\");\n    features.appendChild(br);\n    // Smoke stack if size &gt;= 4\n    if (ship.size &gt;= 4) {\n      const stk = document.createElementNS(ns, \"circle\");\n      stk.setAttribute(\"cx\", -B*0.05); stk.setAttribute(\"cy\", 0); stk.setAttribute(\"r\", B*0.18);\n      stk.setAttribute(\"fill\", \"#1a1c18\");\n      features.appendChild(stk);\n    }\n    // Gun barrels from forward turret\n    const barrelA = document.createElementNS(ns, \"rect\");\n    barrelA.setAttribute(\"x\", bow*0.55); barrelA.setAttribute(\"y\", -B*0.08);\n    barrelA.setAttribute(\"width\", L*0.08); barrelA.setAttribute(\"height\", B*0.16);\n    barrelA.setAttribute(\"fill\", \"#2a2e26\");\n    features.appendChild(barrelA);\n    g.appendChild(features);\n\n    // Damage indicator — burn marks\n    if (state.damage &gt; 0) {\n      for (let i = 0; i &lt; state.damage; i++) {\n        const burn = document.createElementNS(ns, \"circle\");\n        burn.setAttribute(\"cx\", stern*0.3 + i*8);\n        burn.setAttribute(\"cy\", (i%2 ? -1 : 1) * B*0.35);\n        burn.setAttribute(\"r\", B*0.22);\n        burn.setAttribute(\"fill\", \"#1a0e08\");\n        burn.setAttribute(\"opacity\", \"0.85\");\n        g.appendChild(burn);\n      }\n    }\n    svg.appendChild(g);\n  });\n\n  container.appendChild(svg);\n}\n\n/* =====================================================================\n   ============= OPTION C: ¾ MINIATURE =============\n   Faux-isometric ship: hull as a tilted ellipse with side shading,\n   superstructure as small box stack above. Wargame-piece feel.\n   ===================================================================== */\nfunction renderC(container, state) {\n  container.innerHTML = \"\";\n  const W = container.clientWidth, H = container.clientHeight;\n  const svg = makeBlueprintBase(W, H);\n  const ns = \"http://www.w3.org/2000/svg\";\n\n  const localDefs = document.createElementNS(ns, \"defs\");\n  localDefs.innerHTML = `\n    &lt;linearGradient id=\"hullC-top\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"&gt;\n      &lt;stop offset=\"0%\" stop-color=\"#7a8470\"/&gt;\n      &lt;stop offset=\"100%\" stop-color=\"#4a5444\"/&gt;\n    &lt;/linearGradient&gt;\n    &lt;linearGradient id=\"hullC-side\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"&gt;\n      &lt;stop offset=\"0%\" stop-color=\"#3a4036\"/&gt;\n      &lt;stop offset=\"100%\" stop-color=\"#1a1e18\"/&gt;\n    &lt;/linearGradient&gt;\n    &lt;linearGradient id=\"supC\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"&gt;\n      &lt;stop offset=\"0%\" stop-color=\"#9aa090\"/&gt;\n      &lt;stop offset=\"100%\" stop-color=\"#5a6050\"/&gt;\n    &lt;/linearGradient&gt;\n  `;\n  svg.appendChild(localDefs);\n\n  const ships = defaultShips(state.heading);\n  ships.forEach(ship =&gt; {\n    drawFootprints(svg, ship, W, H, { show: state.footprint });\n\n    const { x, y } = shipWorldPos(ship, W, H);\n    // Iso tilt applied as a parent transform: scaleY(0.6) makes a top-down look ¾\n    const g = document.createElementNS(ns, \"g\");\n    g.setAttribute(\"transform\", `translate(${x},${y}) rotate(${ship.head}) scale(1, 0.62)`);\n    g.setAttribute(\"filter\", \"url(#shipShadow)\");\n\n    const L = ship.size * HEX_W * 0.95;\n    const B = HEX_R * 0.95;\n    const bow = L * 0.42, stern = -L * 0.5;\n    const hullHeight = 8; // pretend \"depth\"\n\n    // Side strip (drawn below deck plane to fake 3D)\n    const side = document.createElementNS(ns, \"path\");\n    side.setAttribute(\"d\", `\n      M ${stern},0 L ${stern},${hullHeight}\n      C ${stern},${hullHeight + B*0.6} ${stern*0.4},${hullHeight + B*1.0} ${0},${hullHeight + B*1.0}\n      C ${bow*0.4},${hullHeight + B*1.0} ${bow},${hullHeight + B*0.6} ${bow},${hullHeight}\n      L ${bow},0\n      C ${bow},${B*0.6} ${bow*0.4},${B*1.0} ${0},${B*1.0}\n      C ${stern*0.4},${B*1.0} ${stern},${B*0.6} ${stern},0 Z\n    `);\n    side.setAttribute(\"fill\", \"url(#hullC-side)\");\n    g.appendChild(side);\n\n    // Deck (top)\n    const deckPath = `\n      M ${bow},0\n      C ${bow},${-B*0.6} ${bow*0.4},${-B*1.0} ${0},${-B*1.0}\n      C ${stern*0.4},${-B*1.0} ${stern},${-B*0.6} ${stern},0\n      C ${stern},${B*0.6} ${stern*0.4},${B*1.0} ${0},${B*1.0}\n      C ${bow*0.4},${B*1.0} ${bow},${B*0.6} ${bow},0 Z\n    `;\n    const deck = document.createElementNS(ns, \"path\");\n    deck.setAttribute(\"d\", deckPath);\n    deck.setAttribute(\"fill\", \"url(#hullC-top)\");\n    deck.setAttribute(\"stroke\", \"#1c1f1a\");\n    deck.setAttribute(\"stroke-width\", \"0.4\");\n    g.appendChild(deck);\n\n    // Superstructure (box) — taller for bigger ships\n    const supH = -10 - ship.size * 1.4;\n    const supW = B * 0.6;\n    const supL = L * 0.22;\n    const sup = document.createElementNS(ns, \"g\");\n    sup.innerHTML = `\n      &lt;rect x=\"${-supL/2}\" y=\"${-supW}\" width=\"${supL}\" height=\"${supW*2}\" fill=\"url(#hullC-side)\"/&gt;\n      &lt;rect x=\"${-supL/2}\" y=\"${-supW + supH}\" width=\"${supL}\" height=\"${supW*2}\" fill=\"url(#supC)\"/&gt;\n      &lt;rect x=\"${-supL/2}\" y=\"${-supW}\" width=\"${supL}\" height=\"${-supH}\" fill=\"#2a2e26\" opacity=\"0.55\"/&gt;\n    `;\n    sup.setAttribute(\"transform\", `translate(0,0)`);\n    g.appendChild(sup);\n\n    // Forward turret as a small cylinder\n    const fturret = document.createElementNS(ns, \"g\");\n    const tx = bow * 0.55;\n    fturret.innerHTML = `\n      &lt;ellipse cx=\"${tx}\" cy=\"0\" rx=\"${B*0.32}\" ry=\"${B*0.28}\" fill=\"#3a4036\"/&gt;\n      &lt;rect x=\"${tx}\" y=\"${-B*0.08}\" width=\"${L*0.09}\" height=\"${B*0.16}\" fill=\"#1c1f1a\"/&gt;\n    `;\n    g.appendChild(fturret);\n\n    if (ship.size &gt;= 3) {\n      const aturret = document.createElementNS(ns, \"g\");\n      const ax = stern * 0.65;\n      aturret.innerHTML = `\n        &lt;ellipse cx=\"${ax}\" cy=\"0\" rx=\"${B*0.32}\" ry=\"${B*0.28}\" fill=\"#3a4036\"/&gt;\n      `;\n      g.appendChild(aturret);\n    }\n\n    svg.appendChild(g);\n  });\n\n  container.appendChild(svg);\n}\n\n/* =====================================================================\n   ============= OPTION D: GL LOW-POLY (Three.js) =============\n   Real 3D ships with directional light. Each card has its own renderer.\n   ===================================================================== */\nfunction renderD(container, state) {\n  container.innerHTML = \"\";\n  const W = container.clientWidth, H = container.clientHeight;\n\n  // Draw blueprint base as SVG behind\n  const base = makeBlueprintBase(W, H);\n  container.appendChild(base);\n\n  // Three.js scene above\n  const scene = new THREE.Scene();\n  const aspect = W / H;\n  const viewSize = 200;\n  const camera = new THREE.OrthographicCamera(\n    -viewSize*aspect, viewSize*aspect, viewSize, -viewSize, 1, 2000\n  );\n  // Slight ¾ tilt\n  camera.position.set(0, 250, 220);\n  camera.lookAt(0, 0, 0);\n\n  const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });\n  renderer.setSize(W, H);\n  renderer.setClearColor(0x000000, 0);\n  renderer.shadowMap.enabled = true;\n  renderer.shadowMap.type = THREE.PCFSoftShadowMap;\n  renderer.domElement.style.position = \"absolute\";\n  renderer.domElement.style.inset = \"0\";\n  container.appendChild(renderer.domElement);\n\n  // Lights: warm key + cool fill (like a desk lamp on a paper map)\n  const key = new THREE.DirectionalLight(0xfff0d0, 1.2);\n  key.position.set(120, 220, 80);\n  key.castShadow = true;\n  key.shadow.mapSize.set(1024, 1024);\n  key.shadow.camera.left = -300; key.shadow.camera.right = 300;\n  key.shadow.camera.top = 300; key.shadow.camera.bottom = -300;\n  key.shadow.bias = -0.0005;\n  scene.add(key);\n  scene.add(new THREE.AmbientLight(0xb0c0d0, 0.55));\n  const fill = new THREE.DirectionalLight(0x88aacc, 0.4);\n  fill.position.set(-100, 100, -100);\n  scene.add(fill);\n\n  // Shadow-catcher plane (invisible, just receives shadow)\n  const shadowMat = new THREE.ShadowMaterial({ opacity: 0.35 });\n  const shadowPlane = new THREE.Mesh(new THREE.PlaneGeometry(2000, 2000), shadowMat);\n  shadowPlane.rotation.x = -Math.PI/2;\n  shadowPlane.receiveShadow = true;\n  scene.add(shadowPlane);\n\n  // Helper: build a low-poly ship of given size\n  function buildShip(sizeCells, damage=0) {\n    const group = new THREE.Group();\n    const L = sizeCells * HEX_W * 0.92;\n    const B = HEX_R * 0.85;\n    const hullH = 10;\n\n    // Hull body (lathed/extruded shape)\n    const hullShape = new THREE.Shape();\n    const bow = L * 0.42, stern = -L * 0.5;\n    hullShape.moveTo(bow, 0);\n    hullShape.bezierCurveTo(bow, -B*0.5, bow*0.35, -B, 0, -B);\n    hullShape.lineTo(stern*0.55, -B);\n    hullShape.bezierCurveTo(stern, -B*0.85, stern, -B*0.4, stern, 0);\n    hullShape.bezierCurveTo(stern, B*0.4, stern, B*0.85, stern*0.55, B);\n    hullShape.lineTo(0, B);\n    hullShape.bezierCurveTo(bow*0.35, B, bow, B*0.5, bow, 0);\n\n    const extrudeSettings = { depth: hullH, bevelEnabled: true, bevelThickness: 1.2, bevelSize: 1.2, bevelSegments: 2 };\n    const hullGeo = new THREE.ExtrudeGeometry(hullShape, extrudeSettings);\n    hullGeo.rotateX(-Math.PI/2);\n    hullGeo.translate(0, -hullH/2 + 2, 0);\n    const hullMat = new THREE.MeshStandardMaterial({\n      color: 0x4a5444, roughness: 0.75, metalness: 0.25, flatShading: true\n    });\n    const hull = new THREE.Mesh(hullGeo, hullMat);\n    hull.castShadow = true; hull.receiveShadow = true;\n    group.add(hull);\n\n    // Superstructure (stacked boxes)\n    const supMat = new THREE.MeshStandardMaterial({ color: 0x6a7560, roughness: 0.7, flatShading: true });\n    const supDarkMat = new THREE.MeshStandardMaterial({ color: 0x3a4036, roughness: 0.7, flatShading: true });\n\n    const sup1 = new THREE.Mesh(new THREE.BoxGeometry(L*0.28, 6, B*1.1), supMat);\n    sup1.position.set(-L*0.05, 5, 0);\n    sup1.castShadow = true;\n    group.add(sup1);\n\n    if (sizeCells &gt;= 3) {\n      const sup2 = new THREE.Mesh(new THREE.BoxGeometry(L*0.18, 8, B*0.85), supMat);\n      sup2.position.set(-L*0.02, 12, 0);\n      sup2.castShadow = true;\n      group.add(sup2);\n\n      //