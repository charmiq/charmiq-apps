  { name: "SW", dq:-1, dr:+1, angle: 120 },
  { name: "W",  dq:-1, dr: 0, angle: 180 },
  { name: "NW", dq: 0, dr:-1, angle: 240 },
  { name: "NE", dq:+1, dr:-1, angle: 300 },
];
const HEX_DIRS_FLAT = [
  { name: "NE", dq:+1, dr:-1, angle: -30 },
  { name: "SE", dq:+1, dr: 0, angle:  30 },
  { name: "S",  dq: 0, dr:+1, angle:  90 },
  { name: "SW", dq:-1, dr:+1, angle: 150 },
  { name: "NW", dq:-1, dr: 0, angle: 210 },
  { name: "N",  dq: 0, dr:-1, angle: 270 },
];

const fleet = [
  { id: "BB-01", size: 5, q: -3, r: -2, head: 0 },
  { id: "CA-02", size: 4, q:  1, r: -3, head: 1 },
  { id: "DD-03", size: 3, q:  3, r:  1, head: 2 },
  { id: "DD-04", size: 3, q: -4, r:  2, head: 5 },
  { id: "PT-05", size: 2, q:  0, r:  3, head: 0 },
];

