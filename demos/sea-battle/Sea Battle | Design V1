function renderD(container, state) {
  container.innerHTML = "";
  const W = container.clientWidth, H = container.clientHeight;
  if (W === 0 || H === 0) return;
  const base = makeBlueprintBase(W, H);
  container.appendChild(base);
  if (typeof THREE === "undefined") return;
  const scene = new THREE.Scene();
  const aspect = W / H;
  const viewSize = 200;
  const camera = new THREE.OrthographicCamera(-viewSize*aspect, viewSize*aspect, viewSize, -viewSize, 1, 2000);
  camera.position.set(0, 250, 220);
  camera.lookAt(0, 0, 0);
  const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
  renderer.setSize(W, H);
  renderer.setClearColor(0x000000, 0);
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  renderer.domElement.style.position = "absolute";
  renderer.domElement.style.inset = "0";
  container.appendChild(renderer.domElement);
  const key = new THREE.DirectionalLight(0xfff0d0, 1.2);
  key.position.set(120, 220, 80);
  key.castShadow = true;
  key.shadow.mapSize.set(1024, 1024);
  key.shadow.camera.left = -300; key.shadow.camera.right = 300;
  key.shadow.camera.top = 300; key.shadow.camera.bottom = -300;
  key.shadow.bias = -0.0005;
  scene.add(key);
  scene.add(new THREE.AmbientLight(0xb0c0d0, 0.55));
  const fill2 = new THREE.DirectionalLight(0x88aacc, 0.4);
  fill2.position.set(-100, 100, -100);
  scene.add(fill2);
  const shadowMat = new THREE.ShadowMaterial({ opacity: 0.35 });
  const shadowPlane = new THREE.Mesh(new THREE.PlaneGeometry(2000, 2000), shadowMat);
  shadowPlane.rotation.x = -Math.PI/2;
  shadowPlane.receiveShadow = true;
  scene.add(shadowPlane);
  function buildShip(sizeCells, damage=0) {
    const group = new THREE.Group();
    const L = sizeCells * HEX_W * 0.92;
    const B = HEX_R * 0.85;
    const hullH = 10;
    const hullShape = new THREE.Shape();
    const bow = L * 0.42, stern = -L * 0.5;
    hullShape.moveTo(bow, 0);
    hullShape.bezierCurveTo(bow, -B*0.5, bow*0.35, -B, 0, -B);
    hullShape.lineTo(stern*0.55, -B);
    hullShape.bezierCurveTo(stern, -B*0.85, stern, -B*0.4, stern, 0);
    hullShape.bezierCurveTo(stern, B*0.4, stern, B*0.85, stern*0.55, B);
    hullShape.lineTo(0, B);
    hullShape.bezierCurveTo(bow*0.35, B, bow, B*0.5, bow, 0);
    const extrudeSettings = { depth: hullH, bevelEnabled: true, bevelThickness: 1.2, bevelSize: 1.2, bevelSegments: 2 };
    const hullGeo = new THREE.ExtrudeGeometry(hullShape, extrudeSettings);
    hullGeo.rotateX(-Math.PI/2);
    hullGeo.translate(0, -hullH/2 + 2, 0);
    const hullMat = new THREE.MeshStandardMaterial({ color: 0x4a5444, roughness: 0.75, metalness: 0.25, flatShading: true });
    const hull = new THREE.Mesh(hullGeo, hullMat);
    hull.castShadow = true; hull.receiveShadow = true;
    group.add(hull);
    const supMat = new THREE.MeshStandardMaterial({ color: 0x6a7560, roughness: 0.7, flatShading: true });
    const supDarkMat = new THREE.MeshStandardMaterial({ color: 0x3a4036, roughness: 0.7, flatShading: true });
    const sup1 = new THREE.Mesh(new THREE.BoxGeometry(L*0.28, 6, B*1.1), supMat);
    sup1.position.set(-L*0.05, 5, 0); sup1.castShadow = true;
    group.add(sup1);
    if (sizeCells >= 3) {
      const sup2 = new THREE.Mesh(new THREE.BoxGeometry(L*0.18, 8, B*0.85), supMat);
      sup2.position.set(-L*0.02, 12, 0); sup2.castShadow = true;
      group.add(sup2);
      const mast = new THREE.Mesh(new THREE.CylinderGeometry(0.6, 0.6, 18, 6), supDarkMat);
      mast.position.set(-L*0.05, 22, 0); mast.castShadow = true;
      group.add(mast);
    }
    const turretGeo = new THREE.CylinderGeometry(B*0.32, B*0.32, 5, 12);
    const turretMat = new THREE.MeshStandardMaterial({ color: 0x3c4438, roughness: 0.6, metalness: 0.4, flatShading: true });
    const fturret = new THREE.Mesh(turretGeo, turretMat);
    fturret.position.set(bow*0.55, 4.5, 0); fturret.castShadow = true;
    group.add(fturret);
    const barrelGeo = new THREE.CylinderGeometry(0.8, 0.8, L*0.14, 6);
    barrelGeo.rotateZ(Math.PI/2);
    const barrel = new THREE.Mesh(barrelGeo, supDarkMat);
    barrel.position.set(bow*0.55 + L*0.08, 5.2, 0); barrel.castShadow = true;
    group.add(barrel);
    if (sizeCells >= 3) {
      const aturret = new THREE.Mesh(turretGeo, turretMat);
      aturret.position.set(stern*0.65, 4.5, 0); aturret.castShadow = true;
      group.add(aturret);
    }
    if (sizeCells >= 4) {
      const stackGeo = new THREE.CylinderGeometry(B*0.18, B*0.22, 9, 12);
      const stackMat = new THREE.MeshStandardMaterial({ color: 0x1a1c18, roughness: 0.9, flatShading: true });
      const stack = new THREE.Mesh(stackGeo, stackMat);
      stack.position.set(-L*0.05, 11, 0); stack.castShadow = true;
      group.add(stack);
    }
    if (damage > 0) {
      group.rotation.z = damage * 0.04;
      for (let i = 0; i < damage; i++) {
        const scorch = new THREE.Mesh(new THREE.BoxGeometry(B*0.6, 1.2, B*0.6),
          new THREE.MeshStandardMaterial({ color: 0x150a06, roughness: 0.95, flatShading: true }));
        scorch.position.set(stern*0.2 + i*8, 4, (i%2?-1:1)*B*0.4);
        group.add(scorch);
      }
    }
    return group;
  }
  defaultShips(state.heading).forEach(ship => {
    const { x, y } = axialToPx(ship.ax, ship.ay);
    const s = buildShip(ship.size, state.damage);
    s.position.set(x, 0, y);
    s.rotation.y = -ship.head * Math.PI/180;
    scene.add(s);
  });
  if (state.footprint) {
    defaultShips(state.heading).forEach(ship => {
      const { x, y } = axialToPx(ship.ax, ship.ay);
      const angle = ship.head * Math.PI/180;
      for (let i = 1; i <= 2; i++) {
        const back = (ship.size/2 + i) * HEX_W * 0.9;
        const hx = x - Math.cos(angle) * back;
        const hy = y - Math.sin(angle) * back;
        const dot = new THREE.Mesh(new THREE.CircleGeometry(3.5, 16), new THREE.MeshBasicMaterial({ color: 0x8a1f1f }));
        dot.rotation.x = -Math.PI/2;
        dot.position.set(hx, 0.5, hy);
        scene.add(dot);
      }
    });
  }
  renderer.render(scene, camera);
}

