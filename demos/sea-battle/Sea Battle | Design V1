  return {
    L, B, bow, stern, hullPath, deckPath,
    fwdTurret:  { x: bow * 0.55, r: B * 0.32 },
    aftTurret:  ship.size >= 3 ? { x: stern * 0.65, r: B * 0.32 } : null,
    bridge:     { x: -B*0.55, y: -B*0.4, w: B*1.1, h: B*0.8 },
    stack:      ship.size >= 4 ? { x: -B*0.05, r: B*0.18 } : null,
