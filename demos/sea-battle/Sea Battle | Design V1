    }
    g.appendChild(el("circle", { cx: feat.fwdTurret.x, cy: 0, r: feat.fwdTurret.r, ...stroke }));
    if (feat.aftTurret) g.appendChild(el("circle", { cx: feat.aftTurret.x, cy: 0, r: feat.aftTurret.r, ...stroke }));
    g.appendChild(el("rect", { x: feat.bridge.x, y: feat.bridge.y, width: feat.bridge.w, height: feat.bridge.h, ...stroke }));
  },

  // ---- F · COMMAND COUNTER (own geometry) ------------------------
  F(g, ship, feat) {
    const L = feat.L, B = feat.B * 1.15;
    g.appendChild(el("rect", { x: -L/2, y: -B*0.7, width: L, height: B*1.4, rx: B*0.25, fill: "#1a3050", stroke: "#0a1828", "stroke-width": 0.8 }));
    const arrow = el("path", {
      d: `M ${-L/2 + B*0.3},${-B*0.4} L ${L/2 - B*0.7},${-B*0.4} L ${L/2 - B*0.3},0 L ${L/2 - B*0.7},${B*0.4} L ${-L/2 + B*0.3},${B*0.4} Z`,
      fill: "#3a6090"
    });
    g.appendChild(arrow);
    // Size number (counter-rotated so it's always upright)
    const text = el("text", {
      y: B*0.22, "text-anchor": "middle", "font-family": "Georgia",
      "font-weight": "bold", "font-size": B*0.75, fill: "#f0e8d0",
      transform: `rotate(${-(hexDirs()[ship.head].angle)})`
    });
    text.textContent = ship.size;
    g.appendChild(text);
    // Pips — one per cell, running stern→bow (left→right in local coords)
    for (let i = 0; i < ship.size; i++) {
      const px = -L/2 + (i + 0.5) * (L / ship.size);
      g.appendChild(el("circle", { cx: px, cy: B*0.55, r: 1.6, fill: "#f0e8d0" }));
    }
  },
};

/* =====================================================================
   5. BOARD RENDER  (layered pipeline)
   ===================================================================== */

function computeHexR(boardW, boardH, R) {
  // Fit the board (2R+1 hexes across, ~similar tall) with margin.
  const margin = 40;
  if (state.orient === "pointy") {
    const wCells = 2*R + 1, hCells = (3*R)/2 + 1;
    const wByW = (boardW - 2*margin) / (wCells * Math.sqrt(3));
    const wByH = (boardH - 2*margin) / (hCells * 1.5);
    return Math.min(wByW, wByH);
  } else {
    const wCells = (3*R)/2 + 1, hCells = 2*R + 1;
    const wByW = (boardW - 2*margin) / (wCells * 1.5);
    const wByH = (boardH - 2*margin) / (hCells * Math.sqrt(3));
    return Math.min(wByW, wByH);
  }
}

function renderBoard() {
  const svg = document.getElementById("board");
  const wrap = document.getElementById("board-wrap");
  const W = wrap.clientWidth, H = wrap.clientHeight;
  svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
  svg.innerHTML = "";

  const hexR = computeHexR(W, H, state.radius);
  const cx = W/2, cy = H/2;

  // ---- DEFS ----------------------------------------------------------
  const defs = el("defs");
  defs.innerHTML = `
    <radialGradient id="paperVignette" cx="50%" cy="50%" r="70%">
      <stop offset="0%" stop-color="#f0e4c8" stop-opacity="0.0"/>
      <stop offset="70%" stop-color="#a08858" stop-opacity="0.10"/>
      <stop offset="100%" stop-color="#5a4628" stop-opacity="0.40"/>
    </radialGradient>
    <linearGradient id="hullGrad" x1="0" y1="-1" x2="0" y2="1">
      <stop offset="0%" stop-color="#6a7560"/>
      <stop offset="50%" stop-color="#4a5444"/>
      <stop offset="100%" stop-color="#2c332a"/>
    </linearGradient>
    <linearGradient id="deckGrad" x1="0" y1="-1" x2="0" y2="1">
      <stop offset="0%" stop-color="#7a6a4a"/>
      <stop offset="100%" stop-color="#5a4e36"/>
    </linearGradient>
    <filter id="shipShadow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="1.8"/>
      <feOffset dx="1.5" dy="2.5"/>
      <feComponentTransfer><feFuncA type="linear" slope="0.55"/></feComponentTransfer>
      <feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <filter id="hardShadow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="0.6"/>
      <feOffset dx="1" dy="1.6"/>
      <feComponentTransfer><feFuncA type="linear" slope="0.7"/></feComponentTransfer>
      <feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  `;
  svg.appendChild(defs);

  // ---- LAYER: hex grid (all in-board cells) -------------------------
  const gridLayer = el("g", { id: "layer-grid" });
  svg.appendChild(gridLayer);

  const cellByKey = {};
  for (let q = -state.radius; q <= state.radius; q++) {
    for (let r = -state.radius; r <= state.radius; r++) {
      if (!inBoard(q, r, state.radius)) continue;
      const p = axialToPx(q, r, hexR);
      const px = cx + p.x, py = cy + p.y;
      const corners = hexCorners(px, py, hexR).map(c => c.join(",")).join(" ");
      const cell = el("polygon", { points: corners, fill: "transparent", stroke: "rgba(58,46,28,0.50)", "stroke-width": 0.8 });
      gridLayer.appendChild(cell);
      cellByKey[`${q},${r}`] = { px, py, cell };

      if (state.showCoords) {
        const t = el("text", { x: px, y: py + 3, "text-anchor": "middle", "font-family": "SF Mono, monospace", "font-size": Math.max(6, hexR*0.28), fill: "#8a7350", opacity: 0.55 });
        t.textContent = `${q},${r}`;
        gridLayer.appendChild(t);
      }
    }
  }

  // ---- LAYER: ship-cell highlights ----------------------------------
  const highlightLayer = el("g", { id: "layer-highlight" });
  svg.appendChild(highlightLayer);

  if (state.showHighlight) {
    fleet.forEach(ship => {
      const isActive = ship.id === activeShipId;
      shipCells(ship).forEach(c => {
        const key = `${c.q},${c.r}`;
        const slot = cellByKey[key];
        if (!slot) return;  // off-board cell (wrap to be handled later)
        const corners = hexCorners(slot.px, slot.py, hexR).map(p => p.join(",")).join(" ");
        highlightLayer.appendChild(el("polygon", {
          points: corners,
          fill: isActive ? "#3a6090" : "#5a7a9a",
          "fill-opacity": isActive ? 0.55 : 0.35,
          stroke: isActive ? "#1f3a5f" : "#3a5a7a",
          "stroke-width": isActive ? 1.4 : 0.9,
        }));
      });
    });
  }

  // ---- LAYER: vignette --------------------------------------------
  svg.appendChild(el("rect", { x: 0, y: 0, width: W, height: H, fill: "url(#paperVignette)", "pointer-events": "none" }));

  // ---- LAYER: ships -----------------------------------------------
  const shipLayer = el("g", { id: "layer-ships" });
  svg.appendChild(shipLayer);

  const renderer = renderers[state.render];

  fleet.forEach(ship => {
    const cells = shipCells(ship);
    const onBoardCells = cells.filter(c => inBoard(c.q, c.r, state.radius));
    if (onBoardCells.length === 0) return;

    const ctr = centroidPx(onBoardCells, hexR);
    const px = cx + ctr.x, py = cy + ctr.y;
    const angle = hexDirs()[ship.head].angle;

    const g = el("g", { transform: `translate(${px},${py}) rotate(${angle})`, filter: "url(#shipShadow)" });
    const feat = buildShipFeatures(ship, hexR);
    renderer(g, ship, feat);
    shipLayer.appendChild(g);

    if (state.showLabels) {
      const label = el("text", {
        x: px, y: py + hexR * 1.4,
        "text-anchor": "middle", "font-family": "SF Mono, monospace",
        "font-size": Math.max(8, hexR*0.32), fill: "#3a2e1c",
        opacity: ship.id === activeShipId ? 1 : 0.6,
        "font-weight": ship.id === activeShipId ? 700 : 400
      });
      label.textContent = `${ship.id}`;
      svg.appendChild(label);
    }
  });

  // ---- LAYER: compass ---------------------------------------------
  if (state.showCompass) {
    const compass = el("g", { transform: `translate(40, ${H-45})`, opacity: 0.55, "pointer-events": "none" });
    compass.innerHTML = `
      <circle r="22" fill="none" stroke="#3a2e1c" stroke-width="0.6"/>
      <circle r="16" fill="none" stroke="#3a2e1c" stroke-width="0.4"/>
      <path d="M0,-22 L3,0 L0,22 L-3,0 Z" fill="#3a2e1c" opacity="0.6"/>
      <path d="M-22,0 L0,3 L22,0 L0,-3 Z" fill="#3a2e1c" opacity="0.6"/>
      <text y="-26" text-anchor="middle" font-size="8" fill="#3a2e1c" font-family="Georgia">N</text>
    `;
    svg.appendChild(compass);
  }

  // ---- HUD --------------------------------------------------------
  document.getElementById("hudRender").textContent = state.render;
  const active = fleet.find(s => s.id === activeShipId);
  document.getElementById("hudActive").textContent =
    active ? `${active.id} · size ${active.size} · (${active.q},${active.r}) · ${hexDirs()[active.head].name}` : "—";
}

/* =====================================================================
   6. SIDEBAR  (state -> DOM, event wiring)
   ===================================================================== */

function buildFleetList() {
  const root = document.getElementById("fleetList");
  root.innerHTML = "";
  fleet.forEach(ship => {
    const card = document.createElement("div");
    card.className = "ship-card" + (ship.id === activeShipId ? " active" : "");
    card.dataset.id = ship.id;
    const dir = hexDirs()[ship.head];
    card.innerHTML = `
      <div class="ship-head">
        <b>${ship.id}</b>
        <span class="badge">size ${ship.size} · ${dir.name}</span>
      </div>
      <div class="ship-controls">
        <div class="row">
          <label>Size</label>
          <input type="range" min="1" max="5" value="${ship.size}" data-prop="size"/>
          <span class="val">${ship.size}</span>
        </div>
        <div class="row">
          <label>q</label>
          <input type="range" min="-${state.radius}" max="${state.radius}" value="${ship.q}" data-prop="q"/>
          <span class="val">${ship.q}</span>
        </div>
        <div class="row">
          <label>r</label>
          <input type="range" min="-${state.radius}" max="${state.radius}" value="${ship.r}" data-prop="r"/>
          <span class="val">${ship.r}</span>
        </div>
        <div class="row" style="margin-top:6px;">
          <label>Heading</label>
        </div>
        <div class="heading-grid">
          ${hexDirs().map((d, i) =>
            `<button data-head="${i}" class="${i===ship.head?'active':''}">${d.name}</button>`
          ).join("")}
        </div>
      </div>
    `;
    card.addEventListener("click", (e) => {
      if (e.target.closest(".ship-controls")) return;  // don't re-select on control interaction
      activeShipId = ship.id;
      buildFleetList();
      renderBoard();
    });
    card.querySelectorAll('input[type="range"]').forEach(inp => {
      inp.addEventListener("input", () => {
        const prop = inp.dataset.prop;
        ship[prop] = parseInt(inp.value, 10);
        inp.parentElement.querySelector(".val").textContent = ship[prop];
        // also update the badge
        card.querySelector(".badge").textContent = `size ${ship.size} · ${hexDirs()[ship.head].name}`;
        renderBoard();
      });
    });
    card.querySelectorAll('.heading-grid button').forEach(btn => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        ship.head = parseInt(btn.dataset.head, 10);
        buildFleetList();
        renderBoard();
      });
    });
    root.appendChild(card);
  });
}

/* =====================================================================
   7. WIRE-UP
   ===================================================================== */

const RENDER_LABELS = {
  A: "A — dark ink silhouette (same anatomy as B)",
  B: "B — gradient hull + deck features (default)",
  E: "E — outlines only (same anatomy as B)",
  F: "F — NATO command counter (own geometry)",
};

document.querySelectorAll("#renderSeg button").forEach(btn => {
  btn.addEventListener("click", () => {
    document.querySelectorAll("#renderSeg button").forEach(b => b.classList.remove("active"));
    btn.classList.add("active");
    state.render = btn.dataset.r;
    document.getElementById("renderMeta").textContent = RENDER_LABELS[state.render];
    renderBoard();
  });
});

document.getElementById("orient").addEventListener("change", e => { state.orient = e.target.value; buildFleetList(); renderBoard(); });
document.getElementById("radius").addEventListener("input", e => {
  state.radius = parseInt(e.target.value, 10);
  document.getElementById("radiusVal").textContent = state.radius;
  // re-clamp ship positions so they don't go nuts
  fleet.forEach(s => { s.q = Math.max(-state.radius, Math.min(state.radius, s.q)); s.r = Math.max(-state.radius, Math.min(state.radius, s.r)); });
  buildFleetList(); renderBoard();
});
["showHighlight","showLabels","showCoords","showCompass"].forEach(id => {
  document.getElementById(id).addEventListener("change", e => { state[id] = e.target.checked; renderBoard(); });
});

window.addEventListener("resize", renderBoard);

buildFleetList();
setTimeout(renderBoard, 50);
</script>
</body>
